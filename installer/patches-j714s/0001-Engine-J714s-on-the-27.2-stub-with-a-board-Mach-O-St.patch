+def macho_ctxr_policy(template, device_class):
+    """The board Mach-O contract this template declares for DEVICE_CLASS, or None.
+
+    A template that names the contract must name exactly one board, list only
+    it in allowed_device_classes, and qualify exactly the board's OS firmware.
+    """
+    policy = template.get("aurora_stage1")
+    if not isinstance(policy, dict) or policy.get("kind") != MACHO_CTXR_KIND:
+        return None
+    machines = policy.get("qualified_machines")
+    if (set(policy) != {"kind", "qualified_machines"} or not isinstance(machines, dict)
+            or len(machines) != 1):
+        raise AsahiAdapterError("invalid board Mach-O Stage 1 contract")
+    (board_name, firmware), = machines.items()
+    board = BOARD_MACHO.get(board_name)
+    if (board is None or firmware != [board.os_firmware]
+            or template.get("allowed_device_classes") != [board_name]):
+        raise AsahiAdapterError("invalid board Mach-O Stage 1 contract")
+    if device_class != board_name:
+        raise AsahiAdapterError("this image is not qualified for this Mac")
+    return board
+
+
+def read_board_macho(board, read_member, read_size):
+    """The board's raw Stage 1 and boot object, refused unless fillable and carried."""
+    try:
+        raw = read_member(board.raw)
+        macho = read_member(board.macho)
+    except KeyError as error:
+        raise AsahiAdapterError(f"this image has no Mach-O Stage 1 for {board.macs}") from error
+    try:
+        if read_size(board.stage2) <= 0:
+            raise AsahiAdapterError(f"this image has an empty {board.stage2}")
+    except KeyError as error:
+        raise AsahiAdapterError(f"this image has no {board.stage2} for {board.macs}") from error
+    filled = fill_aurora_stage1(raw, PLACEHOLDER_UUID, MACHO_CTXR_STAGE2, board.window_ms)
+    try:
+        omarchy_macho.fill(macho, raw, filled)
+    except omarchy_macho.MachOError as error:
+        raise AsahiAdapterError(f"invalid Mach-O Stage 1 for {board.macs}: {error}") from error
+    return raw, macho
+
+
+def install_board_macho(board, read_member, read_size, esp_uuid, boot_object):
+    """Fill the board's Stage 1 for this ESP, carry it into the boot object, write it."""
+    raw, macho = read_board_macho(board, read_member, read_size)
+    filled = fill_aurora_stage1(raw, esp_uuid.lower(), MACHO_CTXR_STAGE2, board.window_ms)
+    try:
+        carried = omarchy_macho.fill(macho, raw, filled)
+    except omarchy_macho.MachOError as error:
+        raise AsahiAdapterError(f"invalid Mach-O Stage 1 for {board.macs}: {error}") from error
+    with open(boot_object, "wb") as fd:
+        fd.write(carried)
+    return carried
+
 
