@@ -0,0 +1,120 @@
+# SPDX-License-Identifier: MIT
+"""Aura's Mach-O Stage 1 boot object: check it and carry a filled Stage 1.
+
+Ported from aurora-silicon/aurora-installer macOS/Recovery/Sources/Account/
+AuraStage1.swift (MachOBootObject.layout and fill, MIT), which follows aura
+tools/macho_boot_object.py. kmutil records the size of __TEXT_BOOT_EXEC as
+the boot policy's kcbz, and macOS 27.2 iBoot starts SPTM only when kcbz is
+nonzero, so the object must not have that segment. Aura's objects keep every
+segment fully file-backed at its virtual offset, which is how iBoot places
+them, and enter the raw image at its own entry point.
+
+Padding for the execute window (CTXR) is not done here: the native Recovery
+app pads the object it enrolls, as aurora-installer's Recovery does, so the
+stub only ever stores the small unpadded object.
+"""
+
+import struct
+
+LC_SEGMENT_64 = 0x19
+LC_UNIXTHREAD = 0x5
+MH_MAGIC_64 = 0xFEEDFACF
+CPU_TYPE_ARM64 = 0x0100000C
+MH_FILESET = 12
+REQUIRED = ("__TEXT", "__TEXT_EXEC", "__PRELINK_INFO", "__LINKEDIT")
+RAW_ENTRY_OFFSET = 0x800
+MAXIMUM_SIZE = 64 << 20
+
+
+class MachOError(ValueError):
+    pass
+
+
+def layout(data, file_size=None):
+    """Segments by name and the entry point; refuse anything iBoot would not boot."""
+    if not isinstance(data, (bytes, bytearray)) or len(data) > MAXIMUM_SIZE:
+        raise MachOError("not a Mach-O boot object")
+    total = len(data) if file_size is None else file_size
+
+    def u32(offset):
+        if offset < 0 or offset + 4 > len(data):
+            raise MachOError("truncated")
+        return struct.unpack_from("<I", data, offset)[0]
+
+    def u64(offset):
+        if offset < 0 or offset + 8 > len(data):
+            raise MachOError("truncated")
+        return struct.unpack_from("<Q", data, offset)[0]
+
+    if u32(0) != MH_MAGIC_64 or u32(4) != CPU_TYPE_ARM64:
+        raise MachOError("not a 64-bit Arm Mach-O image")
+    if u32(12) != MH_FILESET:
+        raise MachOError("not a fileset boot object")
+    count, size = u32(16), u32(20)
+    if 32 + size > len(data):
+        raise MachOError("load commands are truncated")
+    segments, entry, offset = {}, None, 32
+    for _ in range(count):
+        command, length = u32(offset), u32(offset + 4)
+        if length < 8 or length % 8 or offset + length > 32 + size:
+            raise MachOError("malformed load command")
+        if command == LC_SEGMENT_64:
+            if length < 72:
+                raise MachOError("malformed segment")
+            name = data[offset + 8:offset + 24].split(b"\0", 1)[0].decode("ascii", "replace")
+            if name in segments:
+                raise MachOError(f"duplicate segment {name}")
+            segments[name] = (u64(offset + 24), u64(offset + 32), u64(offset + 40), u64(offset + 48))
+        elif command == LC_UNIXTHREAD:
+            if length < 16 + 34 * 8 or u32(offset + 8) != 6:
+                raise MachOError("malformed entry thread")
+            entry = u64(offset + 16 + 32 * 8)
+        offset += length
+    if offset != 32 + size:
+        raise MachOError("load command sizes disagree")
+    boot = segments.get("__TEXT_BOOT_EXEC")
+    if boot is not None and (boot[1] or boot[3]):
+        raise MachOError("it has __TEXT_BOOT_EXEC, so iBoot would start SPTM")
+    for name in REQUIRED:
+        if name not in segments:
+            raise MachOError(f"it has no {name} segment")
+    base = segments["__TEXT"][0]
+    if segments["__TEXT"][2] != 0:
+        raise MachOError("__TEXT is not at offset 0")
+    for name, (vmaddr, vmsize, fileoff, filesize) in segments.items():
+        if vmsize and (vmaddr < base or fileoff != vmaddr - base or filesize != vmsize
+                       or fileoff > total or filesize > total - fileoff):
+            raise MachOError(f"{name} is not file-backed at its virtual offset")
+    code = segments["__TEXT_EXEC"]
+    if entry is None or not code[0] <= entry < code[0] + code[1]:
+        raise MachOError("its entry point is outside __TEXT_EXEC")
+    return segments, entry
+
+
+def check(data):
+    layout(data)
+
+
+def fill(macho, raw, filled):
+    """MACHO, aura's boot object for RAW, made from FILLED instead.
+
+    RAW must sit unchanged at the start of __TEXT_EXEC, followed only by
+    zeros to the end of the segment, entered at the raw image's own entry
+    point. FILLED is RAW with its Stage 1 configuration block filled.
+    """
+    segments, entry = layout(macho)
+    vmaddr, _, fileoff, filesize = segments["__TEXT_EXEC"]
+    if not raw or len(filled) != len(raw) or len(raw) > filesize:
+        raise MachOError("it does not carry this Stage 1")
+    if entry != vmaddr + RAW_ENTRY_OFFSET:
+        raise MachOError("it does not enter this Stage 1 at its entry point")
+    start, end = fileoff, fileoff + len(raw)
+    if macho[start:end] != raw or any(macho[end:fileoff + filesize]):
+        raise MachOError("it does not carry this Stage 1")
+    return bytes(macho[:start]) + bytes(filled) + bytes(macho[end:])
+
+
+def read_only_size(macho):
+    """The kcrz kmutil derives for an unpadded object: load address to the end of __TEXT_EXEC."""
+    _, vmsize, fileoff, _ = layout(macho)[0]["__TEXT_EXEC"]
+    return fileoff + vmsize
