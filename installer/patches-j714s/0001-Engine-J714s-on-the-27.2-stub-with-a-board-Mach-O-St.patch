     return b"m1n1 j700 stage 1" + block + b"\0" * 64 + b"STACKBOT"
 
 
+def aura_macho(raw, *, boot_exec=False, entry=0x800):
+    """An MH_FILESET boot object carrying RAW at the start of __TEXT_EXEC, as aura builds it."""
+    import struct as _struct
+    page, base = 0x4000, 0xFFFFFE0007004000
+    code = -(-len(raw) // page) * page
+    names = [("__TEXT", page), ("__TEXT_EXEC", code), ("__PRELINK_INFO", page), ("__LINKEDIT", page)]
+    if boot_exec:
+        names.insert(2, ("__TEXT_BOOT_EXEC", page))
+    commands, offset = [], 0
+    for name, size in names:
+        commands.append(_struct.pack("<II16sQQQQIIII", 0x19, 72, name.encode(), base + offset,
+                                     size, offset, size, 5, 5, 0, 0))
+        if name == "__TEXT_EXEC":
+            code_offset = offset
+        offset += size
+    state = [0] * 34
+    state[32] = base + code_offset + entry
+    commands.append(_struct.pack("<IIII", 0x5, 16 + 34 * 8, 6, 68) + _struct.pack("<34Q", *state))
+    body = b"".join(commands)
+    header = _struct.pack("<IIIIIIII", 0xFEEDFACF, 0x0100000C, 2, 12, len(commands), len(body), 0, 0)
+    image = bytearray(offset)
+    image[:len(header) + len(body)] = header + body
+    image[code_offset:code_offset + len(raw)] = raw
+    return bytes(image)
+
