+class J714sPeripheralCollectionTests(unittest.TestCase):
+    """The J714s collects its camera setfiles and light-sensor calibration
+    like the Neo, but a missing piece is logged and never fails the install."""
+
+    def setUp(self):
+        self.installer = SimpleNamespace(sysinfo=SimpleNamespace(device_class="j714sap"))
+        self.commands = []
+        self.process = SimpleNamespace(run=lambda command, **kwargs: self.commands.append(command))
+        self.raw_copies = []
+        test = self
+
+        class UpstreamAls:
+            def __init__(self, path=None):
+                self.fwfiles = []
+                self.load()
+            def files(self):
+                return self.fwfiles
+            def load(self):
+                raise AssertionError("the upstream ALS reader replaced on the J714s")
+            def copy_raw(self, path):
+                test.raw_copies.append(path)
+
+        self.original_als, self.original_isp = UpstreamAls, object()
+        self.stub = SimpleNamespace(AlsFWCollection=UpstreamAls, ISPFWCollection=self.original_isp,
+                                    subprocess=self.process, FACTORY_DIR="/factory")
+        self.firmware = SimpleNamespace(core=SimpleNamespace(FWFile=lambda name, data: (name, data)), isp=object())
+        self.names = {"apple/isp_2226_02XX.dat", "apple/isp_2224_01XX.dat"}
+        self.isp_error = None
+
+        class Collection:
+            def __init__(self, path):
+                self.fwfiles = []
+                if test.isp_error is not None:
+                    raise test.isp_error
+                self.fwfiles = [(name, b"setfile") for name in sorted(test.names)]
+            def files(self):
+                return self.fwfiles
+
+        self.stack = __import__("contextlib").ExitStack()
+        self.addCleanup(self.stack.close)
+        self.stack.enter_context(patch("omarchy_asahi.stub", self.stub))
+        self.stack.enter_context(patch("omarchy_asahi.asahi_firmware", self.firmware))
+        self.read = self.stack.enter_context(patch(
+            "omarchy_asahi.omarchy_als.read_j714s_calibration", return_value=b"this Mac's CalibrationData"))
+        self.stack.enter_context(patch("omarchy_asahi.omarchy_isp.collection_class", return_value=Collection))
+        self.stack.enter_context(patch("omarchy_asahi.omarchy_als.read_lsci",
+                                       side_effect=AssertionError("Neo LSCI read on the J714s")))
+
+    def _collect(self):
+        from omarchy_asahi import _j714s_peripheral_collectors, _neo_peripheral_collectors
+        with tempfile.TemporaryDirectory() as work:
+            old = os.getcwd()
+            os.chdir(work)
+            try:
+                Path("recovery/usr/sbin").mkdir(parents=True)
+                Path("recovery/usr/sbin/appleh16camerad").write_bytes(b"h16")
+                with _neo_peripheral_collectors(self.installer), \
+                        _j714s_peripheral_collectors(self.installer):
+                    als = self.stub.AlsFWCollection().files()
+                    isp = self.stub.ISPFWCollection("recovery/usr/sbin").files()
+                    self.stub.subprocess.run(["tar", "czf", "all_firmware.tar.gz", "old-input"])
+                    self.stub.subprocess.run(["hdiutil", "attach", "recovery"])
+            finally:
+                os.chdir(old)
+        self.assertIs(self.stub.AlsFWCollection, self.original_als)
+        self.assertIs(self.stub.ISPFWCollection, self.original_isp)
+        self.assertIs(self.stub.subprocess, self.process)
+        return als, isp
+
+    def test_j714s_collects_camera_setfiles_and_this_macs_als_calibration(self):
+        with self.assertLogs(level="INFO") as logs:
+            als, isp = self._collect()
+        self.assertEqual(als, [("apple/aop-als-cal.bin",
+                                ("apple/aop-als-cal.bin", b"this Mac's CalibrationData"))])
+        self.assertEqual(self.raw_copies, ["/factory"])
+        self.assertEqual({name for name, _ in isp}, self.names)
+        tar, attach = self.commands[-2:]
+        self.assertEqual(tar[:4], ["tar", "czf", "all_firmware.tar.gz", "old-input"])
+        self.assertEqual(tar[-1], "appleh16camerad")
+        self.assertNotIn("j700-exbright-LSCI.bin", tar)
+        self.assertEqual(attach, ["hdiutil", "attach", "recovery"])
+        self.assertIn("J714s light sensor calibration: 26 bytes", "\n".join(logs.output))
+
+    def test_a_missing_camera_setfile_is_logged_not_fatal(self):
+        self.names.discard("apple/isp_2226_02XX.dat")
+        with self.assertLogs(level="WARNING") as logs:
+            _als, isp = self._collect()
+        self.assertEqual({name for name, _ in isp}, {"apple/isp_2224_01XX.dat"})
+        self.assertIn("isp_2226_02XX.dat not found", "\n".join(logs.output))
+
+    def test_a_failing_camera_collection_is_logged_not_fatal(self):
+        from omarchy_isp import IspError
+        for error in (IspError("truncated ISP setfile"), OSError("no recovery")):
+            with self.subTest(error=error), self.assertLogs(level="WARNING") as logs:
+                self.isp_error = error
+                als, isp = self._collect()
+                self.assertEqual(isp, [])
+                self.assertEqual(len(als), 1)
+                self.assertIn(str(error), "\n".join(logs.output))
+
+    def test_a_failing_light_sensor_read_is_logged_not_fatal_and_never_substituted(self):
+        from omarchy_als import AlsError
+        for error in (AlsError("no als IORegistry node"),
+                      subprocess.CalledProcessError(1, ["ioreg"]), OSError("no ioreg")):
+            with self.subTest(error=error), self.assertLogs(level="WARNING") as logs:
+                self.read.side_effect = error
+                self.raw_copies.clear()
+                als, isp = self._collect()
+                self.assertEqual(als, [])
+                self.assertEqual(self.raw_copies, [])
+                self.assertEqual({name for name, _ in isp}, self.names)
+                self.assertIn("light sensor calibration unavailable", "\n".join(logs.output))
+
+    def test_the_neo_and_other_boards_are_untouched(self):
+        from omarchy_asahi import _j714s_peripheral_collectors
+        for board in ("j700ap", "j714cap", "j314sap", ""):
+            with self.subTest(board=board):
+                self.installer.sysinfo.device_class = board
+                with patch("omarchy_asahi.omarchy_isp.collection_class",
+                           side_effect=AssertionError("not the J714s")):
+                    with _j714s_peripheral_collectors(self.installer):
+                        self.assertIs(self.stub.AlsFWCollection, self.original_als)
+                        self.assertIs(self.stub.ISPFWCollection, self.original_isp)
+                        self.assertIs(self.stub.subprocess, self.process)
+                self.read.assert_not_called()
+
+
 class NeoRadioFirmwareTests(unittest.TestCase):
     """The MacBook Neo's MT7932 inputs join its vendor firmware package."""
 
