@@ -782,6 +784,62 @@ def _neo_peripheral_collectors(installer):
             stub.AlsFWCollection, stub.ISPFWCollection, stub.subprocess = old_als, old_isp, old_process
 
 
+# The J714s camera's IMX958 setfile, from appleh16camerad. The image also has
+# a first-boot fallback (omarchy-aurora-firmware aurora-j714s-camera-setfile).
+J714S_CAMERA_SETFILE = "apple/isp_2226_02XX.dat"
+
+
+@contextlib.contextmanager
+def _j714s_peripheral_collectors(installer):
+    """The J714s's camera setfiles and light-sensor calibration, as the Neo's
+    collectors do, except that neither may fail the install: a missing file
+    is logged and collection goes on. Never substitutes another Mac's data."""
+    if getattr(getattr(installer, "sysinfo", None), "device_class", "") != "j714sap":
+        yield
+        return
+    upgraded_isp = omarchy_isp.collection_class(asahi_firmware.isp)
+    old_als, old_isp, old_process = stub.AlsFWCollection, stub.ISPFWCollection, stub.subprocess
+
+    class J714sIspCollection(upgraded_isp):
+        def __init__(self, source_path):
+            try:
+                super().__init__(source_path)
+            except Exception as error:  # the camera is optional; never fail the install
+                logging.warning("J714s camera firmware collection failed; continuing: %s", error)
+                self.fwfiles = []
+            names = sorted(name for name, _ in self.fwfiles)
+            if J714S_CAMERA_SETFILE in names:
+                logging.info("J714s camera firmware: %s", ", ".join(names))
+            else:
+                logging.warning(
+                    "J714s camera setfile %s not found; first boot will try to extract it",
+                    J714S_CAMERA_SETFILE)
+
+    class J714sAlsCollection(old_als):
+        def load(self):
+            try:
+                data = omarchy_als.read_j714s_calibration()
+            except (OSError, ValueError, subprocess.CalledProcessError) as error:
+                logging.warning(
+                    "J714s light sensor calibration unavailable; the sensor will not report: %s",
+                    error)
+                return
+            name = omarchy_als.J714S_FIRMWARE_NAME
+            self.fwfiles.append((name, asahi_firmware.core.FWFile(name, data)))
+            logging.info("J714s light sensor calibration: %d bytes", len(data))
+            factory = getattr(stub, "FACTORY_DIR", None)
+            if factory is not None:
+                self.copy_raw(factory)
+
+    try:
+        stub.AlsFWCollection = J714sAlsCollection
+        stub.ISPFWCollection = J714sIspCollection
+        stub.subprocess = _WithNeoFirmwareArchive(old_process)
+        yield
+    finally:
+        stub.AlsFWCollection, stub.ISPFWCollection, stub.subprocess = old_als, old_isp, old_process
+
+
 def stub_installer(sysinfo, dutil, osinfo):
     """A StubInstaller that reads macOS 26 firmware's bootcaches.plist and
     writes Omarchy's own step2.sh as its Recovery setup."""
@@ -800,7 +858,8 @@ def stub_installer(sysinfo, dutil, osinfo):
     collect_firmware = installer.collect_firmware
 
     def collect_firmware_from_an_encrypted_recovery(pkg):
-        with _newer_trackpad_keys(), _neo_peripheral_collectors(installer):
+        with _newer_trackpad_keys(), _neo_peripheral_collectors(installer), \
+                _j714s_peripheral_collectors(installer):
             result = _collect_firmware(pkg)
         try:
             omarchy_centauri.collect(installer, pkg)
diff --git a/Engine/overlay/tests/test_omarchy_als.py b/Engine/overlay/tests/test_omarchy_als.py
index 0de65c4..482850f 100644
--- a/Engine/overlay/tests/test_omarchy_als.py
+++ b/Engine/overlay/tests/test_omarchy_als.py
@@ -87,5 +87,43 @@ class AlsTests(unittest.TestCase):
             als.collect(run)
 
 
+def als_tree(calibration=b"\x01\x02j714s-calibration", depth=3):
+    """`ioreg -r -a -n als -l` output: the als node, its first child chain."""
+    node = {"IORegistryEntryName": "AppleSPUVD6286", "CalibrationData": calibration}
+    if calibration is None:
+        del node["CalibrationData"]
+    for _ in range(depth):
+        node = {"IORegistryEntryName": "als", "IORegistryEntryChildren": [node, {"other": 1}]}
+    return plistlib.dumps([node])
+
+
+class J714sAlsTests(unittest.TestCase):
+    def test_takes_the_first_child_chains_calibration_verbatim(self):
+        self.assertEqual(als.j714s_calibration(als_tree()), b"\x01\x02j714s-calibration")
+        self.assertEqual(als.J714S_FIRMWARE_NAME, "apple/aop-als-cal.bin")
+
+    def test_rejects_missing_empty_or_malformed_calibration(self):
+        for data in (als_tree(calibration=None), als_tree(calibration=b""),
+                     als_tree(calibration="text"), als_tree(depth=2),
+                     plistlib.dumps([]), plistlib.dumps({"not": "a list"}), b"not a plist"):
+            with self.subTest(data=data[:40]), self.assertRaises(als.AlsError):
+                als.j714s_calibration(data)
+
+    def test_reads_this_macs_als_node_only(self):
+        calls = []
+
+        def run(args, **kwargs):
+            calls.append((args, kwargs))
+            return SimpleNamespace(stdout=als_tree())
+
+        self.assertEqual(als.read_j714s_calibration(run), b"\x01\x02j714s-calibration")
+        self.assertEqual(calls, [(["/usr/sbin/ioreg", "-r", "-a", "-n", "als", "-l"],
+                                  {"capture_output": True, "check": True})])
+
+    def test_a_mac_without_an_als_node_is_an_error_not_empty_data(self):
+        with self.assertRaisesRegex(als.AlsError, "no als"):
+            als.read_j714s_calibration(lambda *args, **kwargs: SimpleNamespace(stdout=b""))
+
+
 if __name__ == "__main__":
     unittest.main()
