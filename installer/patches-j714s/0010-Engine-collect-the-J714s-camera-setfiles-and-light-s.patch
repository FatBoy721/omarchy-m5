diff --git a/Engine/overlay/src/omarchy_als.py b/Engine/overlay/src/omarchy_als.py
index 6feafe5..051f00b 100644
--- a/Engine/overlay/src/omarchy_als.py
+++ b/Engine/overlay/src/omarchy_als.py
@@ -80,3 +80,41 @@ def read_lsci(run=subprocess.run):
 
 def collect(run=subprocess.run):
     return {FIRMWARE_NAME: calibration(read_lsci(run))}
+
+
+# The J714s (M5 Pro) light sensor: macOS keeps this Mac's calibration as the
+# CalibrationData of the "als" node's first child chain (AppleSPUVD6286), and
+# the aop_als driver takes it verbatim as apple/aop-als-cal.bin and reports
+# only once that file exists. Gathered from aurora-silicon/aurora-installer
+# asahi_firmware/als.py (MIT), as tools/als-calibration/save-als-cal.py does.
+J714S_FIRMWARE_NAME = "apple/aop-als-cal.bin"
+
+
+def j714s_calibration(data):
+    """This Mac's verbatim CalibrationData from `ioreg -r -a -n als -l` output."""
+    try:
+        roots = plistlib.loads(data)
+    except (ValueError, TypeError, ExpatError, plistlib.InvalidFileException) as error:
+        raise AlsError("invalid als IORegistry property list") from error
+    try:
+        node = roots[0]
+        for _ in range(3):
+            node = node["IORegistryEntryChildren"][0]
+        calibration_data = node["CalibrationData"]
+    except (KeyError, IndexError, TypeError) as error:
+        raise AlsError("the als IORegistry node has no CalibrationData") from error
+    if not isinstance(calibration_data, bytes) or not calibration_data:
+        raise AlsError("the als CalibrationData is empty or not data")
+    return calibration_data
+
+
+def read_j714s_calibration(run=subprocess.run):
+    """Read this booted Mac's als CalibrationData, without writes."""
+    result = run(
+        ["/usr/sbin/ioreg", "-r", "-a", "-n", "als", "-l"],
+        capture_output=True,
+        check=True,
+    )
+    if not result.stdout:
+        raise AlsError("this Mac has no als IORegistry node")
+    return j714s_calibration(result.stdout)
