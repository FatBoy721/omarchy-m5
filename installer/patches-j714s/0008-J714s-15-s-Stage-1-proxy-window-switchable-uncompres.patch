diff --git a/Recovery/Sources/BootSelection.swift b/Recovery/Sources/BootSelection.swift
index ae223b8..4932a5e 100644
--- a/Recovery/Sources/BootSelection.swift
+++ b/Recovery/Sources/BootSelection.swift
@@ -20,17 +20,29 @@ enum AuraBootMode: String, Codable {
   }
 
   /// kmutil records a Mach-O object's __TEXT_BOOT_EXEC size as kcbz; without it
-  /// iBoot does not start SPTM. The padded object is enrolled compressed, so its
-  /// zero padding never reaches Preboot.
-  func enrollmentArguments(stage1: String, volume: String) -> [String] {
+  /// iBoot does not start SPTM. The padded object is enrolled compressed by
+  /// default, so its zero padding never reaches Preboot; a board's startup
+  /// bundle may ask for it uncompressed instead. `compress` applies only to Mach-O.
+  func enrollmentArguments(stage1: String, volume: String, compress: Bool = true) -> [String] {
     var arguments = ["configure-boot", "-c", stage1, "-v", volume]
     if self == .raw {
       arguments += ["--raw", "--entry-point", "2048", "--lowest-virtual-address", "0"]
-    } else {
+    } else if compress {
       arguments.append("--compress")
     }
     return arguments
   }
+
+  /// Whether a Mach-O mode's manifest entry asks for `kmutil --compress`.
+  /// Bundles staged before the key existed were always enrolled compressed, so
+  /// a missing key means true; anything but a JSON boolean is refused (nil).
+  static func machoCompression(_ entry: [String: Any]) -> Bool? {
+    guard let value = entry["compress"] else { return true }
+    guard let flag = value as? NSNumber, CFGetTypeID(flag) == CFBooleanGetTypeID() else {
+      return nil
+    }
+    return flag.boolValue
+  }
 }
 
 struct BootSelection: Codable {
