+  local source="$ROOT/builder/profiles/$candidate_profile/boot-ctxr"
+  [[ -f $source/update-boot-ctxr && -f $source/${CTXR_HOOK##*/} ]] ||
+    fail "the $candidate_profile profile has no boot-ctxr helper and hook"
+  install -D -m 0755 "$source/update-boot-ctxr" "$target/$CTXR_HELPER"
+  install -D -m 0644 "$source/${CTXR_HOOK##*/}" "$target/$CTXR_HOOK"
+  isolated_chroot "$target" "/$CTXR_HELPER" >"$logs/boot-ctxr.log" 2>&1 ||
+    fail "could not write m1n1/boot-ctxr.bin (logs/boot-ctxr.log)"
+  [[ -s $target/boot/efi/m1n1/boot-ctxr.bin ]] || fail "m1n1/boot-ctxr.bin is missing or empty"
+}
