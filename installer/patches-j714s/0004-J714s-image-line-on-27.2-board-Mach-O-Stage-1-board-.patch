 # The engine's per-board contract (BOARD_STAGE1, BOARD_STAGE2): the MacBook
 # Neo boots its raw Stage 1 as esp/aurora/stage1-j700.bin and takes
 # esp/m1n1/boot-j700.bin, the same bundle as m1n1/boot.bin, in its place.
-# Every other Mac drops boot-j700.bin.
+# Every other Mac drops boot-j700.bin. A board Mach-O image (board-macho-ctxr-v1)
+# is for its one board: it carries that board's raw Stage 1 and Aura's unpadded
+# Mach-O boot object of it (the engine's BOARD_MACHO), and neither the common
+# nor the Neo's Stage 1.
+# Where m1n1-aurora keeps Aura's MH_FILESET boot object of its raw Stage 1:
+# m1n1-boot.macho (aura's build/aura-boot.macho), else m1n1.macho
+# (stage1_qualification.PACKAGE_MACHO_STAGE1S).
+stage1_macho_source() {
+  local path
+  for path in usr/share/m1n1-aurora/stage1/m1n1-boot.macho usr/share/m1n1-aurora/stage1/m1n1.macho; do
+    if [[ -s $target/$path && ! -L $target/$path ]]; then
+      echo "$path"
+      return 0
+    fi
+  done
+  echo usr/share/m1n1-aurora/stage1/m1n1-boot.macho
+}
