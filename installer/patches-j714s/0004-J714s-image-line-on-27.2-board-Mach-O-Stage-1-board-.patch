diff --git a/image-builder/test/test_aura_macho.py b/image-builder/test/test_aura_macho.py
new file mode 100644
index 0000000..02ea8e6
--- /dev/null
+++ b/image-builder/test/test_aura_macho.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""The builder holds Aura's Mach-O Stage 1 to the engine's rules (Engine omarchy_macho.fill):
+the raw Stage 1 verbatim at the start of __TEXT_EXEC, only zeros after it to the end of the
+segment, entered at the raw image's entry point, and no __TEXT_BOOT_EXEC (kcbz 0)."""
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import fixtures  # noqa: E402
+
+macho = fixtures.aura_macho
+ROOT = fixtures.ROOT
+
+
+class AuraMachOTest(unittest.TestCase):
+    def setUp(self):
+        self.raw = fixtures.raw_stage1()
+
+    def test_the_fileset_wrap_of_the_raw_stage1_is_accepted(self):
+        obj = macho.build(self.raw)
+        macho.check_carries(obj, self.raw)
+        segments, entry = macho.layout(obj)
+        self.assertEqual(entry, segments["__TEXT_EXEC"][0] + macho.RAW_ENTRY_OFFSET)
+
+    def test_what_the_engine_refuses_is_refused(self):
+        other = self.raw[:-9] + b"X" + self.raw[-8:]
+        obj = bytearray(macho.build(self.raw))
+        code = macho.layout(bytes(obj))[0]["__TEXT_EXEC"]
+        trailing = bytearray(obj)
+        trailing[code[2] + len(self.raw)] = 1
+        cases = {
+            "another Stage 1": (macho.build(other), "does not carry"),
+            "SPTM": (macho.build(self.raw, boot_exec=True), "SPTM"),
+            "entry point": (macho.build(self.raw, entry=0x400), "entry point"),
+            "not Mach-O": (b"not a mach-o boot object", "not a 64-bit Arm Mach-O"),
+            "non-zero tail": (bytes(trailing), "followed only by zeros"),
+            "truncated": (bytes(obj[:len(obj) // 2]), "file-backed|truncated"),
+        }
+        for name, (data, message) in cases.items():
+            with self.subTest(name), self.assertRaisesRegex(macho.MachOError, message):
+                macho.check_carries(data, self.raw)
+
+    def test_aura_s_own_linked_macho_is_not_a_fileset_boot_object(self):
+        # aura's build/aura.macho (the recipes' m1n1.macho) is MH_EXECUTE-style, without __TEXT_EXEC.
+        header = struct.pack("<IIIIIIII", macho.MH_MAGIC_64, macho.CPU_TYPE_ARM64, 0, 2, 0, 0, 0, 0)
+        with self.assertRaisesRegex(macho.MachOError, "not a fileset"):
+            macho.check_carries(header + bytes(64), self.raw)
+
+    def test_the_command_line_check(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            raw, obj = Path(temporary, "raw.bin"), Path(temporary, "stage1.macho")
+            raw.write_bytes(self.raw)
+            obj.write_bytes(macho.build(self.raw))
+            tool = [sys.executable, str(ROOT / "builder/aura_macho.py"), "check", str(obj), str(raw)]
+            self.assertEqual(subprocess.run(tool, capture_output=True).returncode, 0)
+            obj.write_bytes(macho.build(self.raw, boot_exec=True))
+            result = subprocess.run(tool, capture_output=True, text=True)
+            self.assertEqual(result.returncode, 1)
+            self.assertIn("SPTM", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
