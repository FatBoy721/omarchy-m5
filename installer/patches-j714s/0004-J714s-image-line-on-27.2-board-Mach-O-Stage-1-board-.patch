+#!/usr/bin/env python3
+"""Aura's Mach-O Stage 1 boot object, checked the way the installer engine checks it.
+
+The engine (Engine/overlay/src/omarchy_macho.py, ported from
+aurora-silicon/aurora-installer AuraStage1.swift, MIT, which follows aura
+tools/macho_boot_object.py) fills the raw Stage 1's config block and carries
+the filled image into this object. It refuses an object that does not carry
+the raw image verbatim at the start of __TEXT_EXEC, followed only by zeros to
+the end of that segment's file data, entered at the raw image's own entry
+point. kmutil records the size of __TEXT_BOOT_EXEC as kcbz, and macOS 27.2
+iBoot starts SPTM only when kcbz is nonzero, so the object must not have one.
+The builder holds the image to the same rules, so it never publishes a payload
+the engine would refuse.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+import struct
+import sys
+
+LC_SEGMENT_64 = 0x19
+LC_UNIXTHREAD = 0x5
+MH_MAGIC_64 = 0xFEEDFACF
+CPU_TYPE_ARM64 = 0x0100000C
+MH_FILESET = 12
+REQUIRED = ("__TEXT", "__TEXT_EXEC", "__PRELINK_INFO", "__LINKEDIT")
+RAW_ENTRY_OFFSET = 0x800
+MAXIMUM_SIZE = 64 << 20
+
+
+class MachOError(ValueError):
+    pass
+
+
+def layout(data: bytes) -> tuple[dict[str, tuple[int, int, int, int]], int]:
+    """Segments by name (vmaddr, vmsize, fileoff, filesize) and the entry point."""
+    if not isinstance(data, (bytes, bytearray)) or len(data) > MAXIMUM_SIZE:
+        raise MachOError("not a Mach-O boot object")
+
+    def u32(offset: int) -> int:
+        if offset < 0 or offset + 4 > len(data):
+            raise MachOError("truncated Mach-O boot object")
+        return struct.unpack_from("<I", data, offset)[0]
+
+    def u64(offset: int) -> int:
+        if offset < 0 or offset + 8 > len(data):
+            raise MachOError("truncated Mach-O boot object")
+        return struct.unpack_from("<Q", data, offset)[0]
+
+    if u32(0) != MH_MAGIC_64 or u32(4) != CPU_TYPE_ARM64:
+        raise MachOError("not a 64-bit Arm Mach-O image")
+    if u32(12) != MH_FILESET:
+        raise MachOError("not a fileset boot object")
+    count, size = u32(16), u32(20)
+    if 32 + size > len(data):
+        raise MachOError("the Mach-O load commands are truncated")
+    segments: dict[str, tuple[int, int, int, int]] = {}
+    entry = None
+    offset = 32
+    for _ in range(count):
+        command, length = u32(offset), u32(offset + 4)
+        if length < 8 or length % 8 or offset + length > 32 + size:
+            raise MachOError("malformed Mach-O load command")
+        if command == LC_SEGMENT_64:
+            if length < 72:
+                raise MachOError("malformed Mach-O segment")
+            name = data[offset + 8:offset + 24].split(b"\0", 1)[0].decode("ascii", "replace")
+            if name in segments:
+                raise MachOError(f"duplicate Mach-O segment {name}")
+            segments[name] = (u64(offset + 24), u64(offset + 32), u64(offset + 40), u64(offset + 48))
+        elif command == LC_UNIXTHREAD:
+            if length < 16 + 34 * 8 or u32(offset + 8) != 6:
+                raise MachOError("malformed Mach-O entry thread")
+            entry = u64(offset + 16 + 32 * 8)
+        offset += length
+    if offset != 32 + size:
+        raise MachOError("the Mach-O load command sizes disagree")
+    boot = segments.get("__TEXT_BOOT_EXEC")
+    if boot is not None and (boot[1] or boot[3]):
+        raise MachOError("it has __TEXT_BOOT_EXEC, so iBoot would start SPTM")
+    for name in REQUIRED:
+        if name not in segments:
+            raise MachOError(f"it has no {name} segment")
+    base = segments["__TEXT"][0]
+    if segments["__TEXT"][2] != 0:
+        raise MachOError("__TEXT is not at offset 0")
+    for name, (vmaddr, vmsize, fileoff, filesize) in segments.items():
+        if vmsize and (vmaddr < base or fileoff != vmaddr - base or filesize != vmsize
+                       or fileoff > len(data) or filesize > len(data) - fileoff):
+            raise MachOError(f"{name} is not file-backed at its virtual offset")
+    code = segments["__TEXT_EXEC"]
+    if entry is None or not code[0] <= entry < code[0] + code[1]:
+        raise MachOError("its entry point is outside __TEXT_EXEC")
+    return segments, entry
+
+
+def check_carries(macho: bytes, raw: bytes) -> None:
+    """MACHO is Aura's unpadded boot object for exactly RAW, or MachOError."""
+    segments, entry = layout(macho)
+    vmaddr, _, fileoff, filesize = segments["__TEXT_EXEC"]
+    if not raw or len(raw) > filesize:
+        raise MachOError("it does not carry this Stage 1")
+    if entry != vmaddr + RAW_ENTRY_OFFSET:
+        raise MachOError("it does not enter this Stage 1 at its entry point")
+    end = fileoff + len(raw)
+    if macho[fileoff:end] != raw or any(macho[end:fileoff + filesize]):
+        raise MachOError("it does not carry this Stage 1 at the start of __TEXT_EXEC, followed only by zeros")
+
+
+def build(raw: bytes, *, boot_exec: bool = False, entry: int = RAW_ENTRY_OFFSET) -> bytes:
+    """An MH_FILESET object carrying RAW at the start of __TEXT_EXEC, laid out as aura's
+    tools/macho_boot_object.py lays it out (for tests and fixtures)."""
+    page, base = 0x4000, 0xFFFFFE0007004000
+    code = -(-len(raw) // page) * page
+    names = [("__TEXT", page), ("__TEXT_EXEC", code), ("__PRELINK_INFO", page), ("__LINKEDIT", page)]
+    if boot_exec:
+        names.insert(2, ("__TEXT_BOOT_EXEC", page))
+    commands, offset, code_offset = [], 0, 0
+    for name, size in names:
+        commands.append(struct.pack("<II16sQQQQIIII", LC_SEGMENT_64, 72, name.encode(), base + offset,
+                                    size, offset, size, 5, 5, 0, 0))
+        if name == "__TEXT_EXEC":
+            code_offset = offset
+        offset += size
+    state = [0] * 34
+    state[32] = base + code_offset + entry
+    commands.append(struct.pack("<IIII", LC_UNIXTHREAD, 16 + 34 * 8, 6, 68) + struct.pack("<34Q", *state))
+    body = b"".join(commands)
+    header = struct.pack("<IIIIIIII", MH_MAGIC_64, CPU_TYPE_ARM64, 2, MH_FILESET, len(commands), len(body), 0, 0)
+    image = bytearray(offset)
+    image[:len(header) + len(body)] = header + body
+    image[code_offset:code_offset + len(raw)] = raw
+    return bytes(image)
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 4 or argv[1] != "check":
+        print("usage: aura_macho.py check MACHO RAW", file=sys.stderr)
+        return 64
+    try:
+        check_carries(Path(argv[2]).read_bytes(), Path(argv[3]).read_bytes())
+    except (OSError, MachOError) as error:
+        print(f"aura_macho: {argv[2]}: {error}", file=sys.stderr)
+        return 1
+    print(f"{argv[2]} carries {argv[3]} at the start of __TEXT_EXEC")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
