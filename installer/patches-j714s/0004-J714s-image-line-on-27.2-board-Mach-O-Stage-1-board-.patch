+# A board Mach-O image's confined Stage 2 (esp/m1n1/boot-ctxr.bin), which a
+# padded Stage 1 chainloads; m1n1/boot.bin stays as it is. The profile's helper
+# makes it from update-m1n1's m1n1/boot.bin (a copy, as m1n1-aurora's m1n1.bin is
+# Aura's ESP_STAGE2=1 build; or m1n1-ctxr.bin then boot.bin's tail after m1n1.bin,
+# if the package ships the confined build apart), and its pacman hook, after
+# asahi-scripts' 95-m1n1-install.hook, keeps it current on the installed system.
+CTXR_HELPER=usr/local/lib/omarchy-j714s/update-boot-ctxr
+CTXR_HOOK=etc/pacman.d/hooks/96-omarchy-j714s-boot-ctxr.hook
+build_ctxr_stage2() {
+  local kind
+  kind=$(stage1_kind) || exit 1
