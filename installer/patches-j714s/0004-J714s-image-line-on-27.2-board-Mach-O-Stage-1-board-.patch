diff --git a/image-builder/builder/profiles/j714s/boot-ctxr/update-boot-ctxr b/image-builder/builder/profiles/j714s/boot-ctxr/update-boot-ctxr
new file mode 100755
index 0000000..556ab7d
--- /dev/null
+++ b/image-builder/builder/profiles/j714s/boot-ctxr/update-boot-ctxr
@@ -0,0 +1,38 @@
+#!/bin/sh
+# Keeps the J714s's confined Stage 2, /boot/efi/m1n1/boot-ctxr.bin, the one the
+# padded Aura Mach-O Stage 1 chainloads, in step with update-m1n1's
+# m1n1/boot.bin: the image builder runs it once after update-m1n1, and the
+# pacman hook 96-omarchy-j714s-boot-ctxr.hook after asahi-scripts'
+# 95-m1n1-install.hook on every m1n1, U-Boot or device tree change.
+#
+# m1n1-aurora installs Aura's ESP_STAGE2=1 build as /usr/lib/asahi-boot/m1n1.bin,
+# so boot.bin already is the confined Stage 2 and this copies it. A package that
+# ships the confined build apart, as /usr/lib/asahi-boot/m1n1-ctxr.bin, gets it
+# followed by exactly the device trees, U-Boot and options boot.bin carries after
+# m1n1.bin. Written beside the target, then renamed over it.
+set -eu
+# OMARCHY_ROOT: another root's files, for the builder's own tests; empty in the image.
+root=${OMARCHY_ROOT:-}
+esp=$root/boot/efi/m1n1
+boot=$esp/boot.bin
+m1n1=$root/usr/lib/asahi-boot/m1n1.bin
+ctxr=$root/usr/lib/asahi-boot/m1n1-ctxr.bin
+if [ ! -s "$boot" ]; then
+  echo "update-boot-ctxr: $boot is missing; is the ESP mounted?" >&2
+  exit 1
+fi
+tmp=$esp/.boot-ctxr.bin.new
+trap 'rm -f "$tmp"' EXIT
+if [ -s "$ctxr" ]; then
+  size=$(stat -c %s "$m1n1")
+  if [ "$(stat -c %s "$boot")" -le "$size" ] || ! cmp -s -n "$size" "$m1n1" "$boot"; then
+    echo "update-boot-ctxr: $boot does not start with $m1n1" >&2
+    exit 1
+  fi
+  { cat "$ctxr"; tail -c +"$((size + 1))" "$boot"; } >"$tmp"
+else
+  cat "$boot" >"$tmp"
+fi
+sync "$tmp"
+mv -f "$tmp" "$esp/boot-ctxr.bin"
+trap - EXIT
