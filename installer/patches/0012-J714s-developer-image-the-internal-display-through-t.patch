diff --git a/image-builder/bin/build-mac-image b/image-builder/bin/build-mac-image
index f2dcbd6..c9e7d45 100755
--- a/image-builder/bin/build-mac-image
+++ b/image-builder/bin/build-mac-image
@@ -846,6 +846,9 @@ available_base() {
   unavailable=()
   local output
   while read -r name; do
+    # A J714s set's hyprland-m5 (Omarchy's Hyprland with the M5 DCP patches) fills the
+    # hyprland role; install_runtime makes it a target, so stock hyprland never installs.
+    [[ $name == hyprland && -n $(candidate_archive hyprland-m5) ]] && continue
     request=$(qualified "$name")
     if output=$(target_pacman -Sp --print-format x "$request" 2>&1); then
       base_names+=("$request")
@@ -1002,6 +1005,8 @@ install_runtime() {
   # desktop's mesa dependency, so stock mesa never installs. The Apple set
   # cannot replace it later without answering a conflict prompt.
   mapfile -t graphics < <(qualified mesa-aurora vulkan-aurora)
+  # hyprland-m5 likewise satisfies the desktop's hyprland dependency (J714s DCP)
+  [[ -z $(candidate_archive hyprland-m5) ]] || graphics+=("$(qualified hyprland-m5)")
   mount_api
   target_pacman -S "$(qualified omarchy)" "${base_names[@]}" "${graphics[@]}" >>"$logs/install.log" 2>&1 ||
     fail "could not install the runtime (logs/install.log)"
