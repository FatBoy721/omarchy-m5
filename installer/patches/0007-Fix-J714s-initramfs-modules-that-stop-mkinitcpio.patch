From b14c912c3db6f2bf6859cad53e7f1fd3fde7d5fc Mon Sep 17 00:00:00 2001
From: Robert Ramsey <fatboytrucking721@gmail.com>
Date: Mon, 9 Nov 2026 13:48:19 -0500
Subject: [PATCH] Fix J714s initramfs modules that stop mkinitcpio

sd-encrypt requires dm-integrity, which the frozen J714s config left unset.
Build it as a module and require it, alongside dm-crypt.

aurora-vendor-order requires mt7932-fullmac, the Neo Wi-Fi driver, which
the J714s kernel does not build. Make it optional on this candidate; the
Neo image keeps its own recipe.

Both packages need rebuilding and the candidate set re-signing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Integration/M5/J714s-Normal-System/kernel/config       |  2 +-
 .../J714s-Normal-System/kernel/j714s-required.config   |  1 +
 Integration/M5/J714s-Normal-System/prepare             |  2 +-
 Integration/M5/J714s-Normal-System/recipes.patch       | 10 ++++++----
 4 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/Integration/M5/J714s-Normal-System/kernel/config b/Integration/M5/J714s-Normal-System/kernel/config
index 2a289c1..973f21b 100644
--- a/Integration/M5/J714s-Normal-System/kernel/config
+++ b/Integration/M5/J714s-Normal-System/kernel/config
@@ -2807,7 +2807,7 @@ CONFIG_DM_ZERO=m
 # CONFIG_DM_VERITY is not set
 # CONFIG_DM_SWITCH is not set
 # CONFIG_DM_LOG_WRITES is not set
-# CONFIG_DM_INTEGRITY is not set
+CONFIG_DM_INTEGRITY=m
 # CONFIG_DM_AUDIT is not set
 # CONFIG_DM_VDO is not set
 # CONFIG_TARGET_CORE is not set
diff --git a/Integration/M5/J714s-Normal-System/kernel/j714s-required.config b/Integration/M5/J714s-Normal-System/kernel/j714s-required.config
index c470df5..41105bc 100644
--- a/Integration/M5/J714s-Normal-System/kernel/j714s-required.config
+++ b/Integration/M5/J714s-Normal-System/kernel/j714s-required.config
@@ -11,6 +11,7 @@ CONFIG_BTRFS_FS=m
 CONFIG_EXT4_FS=y
 CONFIG_BLK_DEV_DM=m
 CONFIG_DM_CRYPT=m
+CONFIG_DM_INTEGRITY=m
 CONFIG_CRYPTO_AES=y
 CONFIG_CRYPTO_XTS=m
 CONFIG_VFAT_FS=y
