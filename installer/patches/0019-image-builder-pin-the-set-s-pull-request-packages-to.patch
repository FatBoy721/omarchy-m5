From f90759637e0a6a9795129132a1f8d6827d77138f Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Wed, 11 Nov 2026 16:34:36 -0500
Subject: [PATCH] image builder: pin the set's pull-request packages too

The test-image pin kept only the runtime built from the set's source
commit. A pacman -Syu on the J714s developer image (update-check run on
2026.11.11-6) would then have replaced m1n1-aurora 1.6.1.aurora22.j714s5
with edge's 1.6.1.aurora23, which has none of the J714s hand-offs (DCP,
notch rows, GPU bins). Every boot and support package the set takes from a
pull request (kernel, m1n1, U-Boot, Mesa, Hyprland, firmware) is now pinned
too; channel packages keep following the channel.
---
 image-builder/builder/test_image_pin.py  |  6 +++++-
 image-builder/test/test_candidate_set.py |  2 +-
 image-builder/test/test_inspection.py    | 10 +++++-----
 3 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/image-builder/builder/test_image_pin.py b/image-builder/builder/test_image_pin.py
index d8004f2..246d97c 100644
--- a/image-builder/builder/test_image_pin.py
+++ b/image-builder/builder/test_image_pin.py
@@ -26,8 +26,12 @@ REASON = "# whose version sorts below the channel's. Keep these three lines: the
 def pinned(summary: dict) -> list[str]:
     if summary.get("candidate_only") is not True:
         return []
+    # Also every boot and support package the set takes from a pull request (the J714s set's kernel,
+    # m1n1, U-Boot, Mesa, Hyprland and firmware): the channel's packages of the same name lack its
+    # patches, and m1n1-aurora 1.6.1.aurora23 on edge already outnumbers the set's aurora22.j714s5,
+    # so a pacman -Syu would replace the J714s boot loader with one that has no J714s handoff.
     return sorted(p["name"] for p in summary["packages"]
-                  if p.get("origin") == "commit" or p.get("origin", "").startswith("platform "))
+                  if p.get("origin") in ("commit", "pull-request") or p.get("origin", "").startswith("platform "))
 
 
 def render(template: bytes, names: list[str]) -> bytes:
diff --git a/image-builder/test/test_candidate_set.py b/image-builder/test/test_candidate_set.py
index fdd62e7..735aa2f 100755
--- a/image-builder/test/test_candidate_set.py
+++ b/image-builder/test/test_candidate_set.py
@@ -335,7 +335,7 @@ class CandidateSetTest(unittest.TestCase):
                           "omarchy-mac": ("platform " + "d" * 40, "d" * 40),
                           "omarchy-mac-boot": ("platform " + "e" * 40, "e" * 40)})
         self.assertNotIn("source_commit", packages["linux-aurora"])
-        self.assertEqual(fixtures.test_image_pin.pinned(summary), ["omarchy", "omarchy-mac", "omarchy-mac-boot", "omarchy-settings"])
+        self.assertEqual(fixtures.test_image_pin.pinned(summary), ["alsa-ucm-conf-aurora", "aurora-audio", "aurora-bless", "limine-mkinitcpio-hook", "linux-aurora", "linux-aurora-headers", "m1n1-aurora", "mesa-aurora", "omarchy", "omarchy-aurora-firmware", "omarchy-mac", "omarchy-mac-boot", "omarchy-settings", "speakerguardd", "uboot-aurora", "vulkan-aurora"])
 
     def test_platform_packages_from_the_repository_they_moved_from(self):
         declared = {"omarchy-mac": "d" * 40, "omarchy-mac-boot": "e" * 40}
diff --git a/image-builder/test/test_inspection.py b/image-builder/test/test_inspection.py
index 6e290ab..2ff92ed 100755
--- a/image-builder/test/test_inspection.py
+++ b/image-builder/test/test_inspection.py
@@ -919,11 +919,11 @@ class InspectionTest(unittest.TestCase):
     def test_test_image_keeps_the_sets_runtime(self):
         conf = (self.root / "etc/pacman.conf").read_text()
         self.assertIn("[options]\n" + fixtures.test_image_pin.MARK + "\n", conf)
-        self.assertIn("\nIgnorePkg = omarchy omarchy-mac omarchy-mac-boot omarchy-settings\n", conf)
-        self.assertRegex(self.inspect()["checks"]["pacman-config"]["detail"], "IgnorePkg = omarchy ")
+        self.assertIn("\nIgnorePkg = alsa-ucm-conf-aurora aurora-audio aurora-bless limine-mkinitcpio-hook linux-aurora linux-aurora-headers m1n1-aurora mesa-aurora omarchy omarchy-aurora-firmware omarchy-mac omarchy-mac-boot omarchy-settings speakerguardd uboot-aurora vulkan-aurora\n", conf)
+        self.assertRegex(self.inspect()["checks"]["pacman-config"]["detail"], "IgnorePkg = alsa-ucm-conf-aurora ")
         template = self.root / "usr/share/omarchy/default/pacman/aarch64/pacman-edge.conf"
         for name, text in (("unpinned", template.read_text()),
-                           ("another pin", conf.replace("IgnorePkg = omarchy ", "IgnorePkg = "))):
+                           ("another pin", conf.replace("IgnorePkg = alsa-ucm-conf-aurora ", "IgnorePkg = "))):
             with self.subTest(name):
                 (self.root / "etc/pacman.conf").write_text(text)
                 self.assertFails("pacman-config", "with the test image's pin")
@@ -1308,10 +1308,10 @@ class TestImagePinTest(unittest.TestCase):
     def test_pins_only_what_the_source_commit_built(self):
         pin = fixtures.test_image_pin
         names = pin.pinned(self.summary())
-        self.assertEqual(names, ["omarchy", "omarchy-mac", "omarchy-settings"])
+        self.assertEqual(names, ["omarchy", "omarchy-mac", "omarchy-settings", "uboot-aurora"])
         rendered = pin.render(self.TEMPLATE, names).decode()
         self.assertEqual(rendered, "# pacman\n\n[options]\n" + pin.MARK + "\n" + pin.REASON
-                         + "\nIgnorePkg = omarchy omarchy-mac omarchy-settings\nArchitecture = auto\n\n[core]\n"
+                         + "\nIgnorePkg = omarchy omarchy-mac omarchy-settings uboot-aurora\nArchitecture = auto\n\n[core]\n"
                          "Include = /etc/pacman.d/mirrorlist\n")
 
     def test_no_pin_outside_a_test_set(self):
