+J714S_KERNEL_VERSION = "7.3.0.aurora16.j714s3-1"
+J714S_KERNEL_RELEASE = "7.3.0-16.j714s3-1-j714s-merged-ARCH"
 J714S_ARGUMENTS = ("macsmc.m5_pcio_budget=2", "macsmc.m5_n1_budget=3")
+# What the merged kernel (betizzel/omarchy-m5 linux-aurora-n1 0001-0008) was verified
