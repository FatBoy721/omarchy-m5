+++ b/Integration/M5/J714s-Normal-System/tools/finish-inputs.py
@@ -39,13 +39,15 @@ def run(*args: str, **kwargs):
 
 
 def verify_main_commit(commit: str) -> None:
+    # The developer image is now built from betizzel/omarchy-m5 (installer/patches on
+    # omacom c07e54c), not a fork's main: the commit is this clean checkout's HEAD.
     if not re.fullmatch(r'[0-9a-f]{40}', commit):
         raise ValueError('builder commit must be a full lowercase Git SHA')
-    remote = run('git', 'ls-remote', 'origin', 'refs/heads/main', cwd=ROOT,
-                 stdout=subprocess.PIPE, text=True).stdout.split()[0]
-    if remote != commit:
-        raise ValueError(f'builder commit is not current origin/main ({remote})')
-    run('git', 'cat-file', '-e', f'{commit}^{{commit}}', cwd=ROOT)
+    head = run('git', 'rev-parse', 'HEAD', cwd=ROOT, stdout=subprocess.PIPE, text=True).stdout.strip()
+    if head != commit:
+        raise ValueError(f'builder commit is not this checkout\'s HEAD ({head})')
+    if run('git', 'status', '--porcelain', cwd=ROOT, stdout=subprocess.PIPE, text=True).stdout.strip():
+        raise ValueError('builder checkout is not clean')
 
 
