@@ -0,0 +1,51 @@
+#!/bin/bash
+# Preparing a candidate cannot modify normal recipes or select it for release.
+set -euo pipefail
+ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
+T=$(mktemp -d)
+trap 'rm -rf "$T"' EXIT
+
+before=$(git -C "$ROOT" diff -- pkgbuilds)
+"$ROOT/candidates/j714s-normal-boot/prepare" "$T/candidate"
+[[ $(git -C "$ROOT" diff -- pkgbuilds) == "$before" ]]
+[[ ! -d $T/candidate/pkgbuilds/m1n1-aurora/.omarchy ]]
+[[ ! -d $T/candidate/pkgbuilds/uboot-aurora/.omarchy ]]
+
+check_recipe() {
+  local package=$1 commit=$2 url=$3
+  (
+    cd "$T/candidate/pkgbuilds/$package"
+    source PKGBUILD
+    [[ $_commit == "$commit" ]]
+    [[ ${source[0]} == *"git+$url.git#commit=$commit" ]]
+    [[ $pkgver == *".j714s1" ]]
+    for index in "${!source[@]}"; do
+      if [[ ${sha256sums[index]} != 'SKIP' ]]; then
+        printf '%s  %s\n' "${sha256sums[index]}" "${source[index]}" | sha256sum -c -
+      fi
+    done
+  )
+}
+
+check_recipe m1n1-aurora bafef4b456a98c0a8966b4d9502d55694d2e4c9b https://github.com/edimoldovan/m1n1
+check_recipe uboot-aurora 70e990818a895454780797beedc6a7bdac9e2fd6 https://github.com/edimoldovan/u-boot
+validator=$T/candidate/pkgbuilds/m1n1-aurora/validate-qualification.py
+record=$T/candidate/pkgbuilds/m1n1-aurora/build-qualification.json
+if python3 "$validator" "$record" bafef4b456a98c0a8966b4d9502d55694d2e4c9b > "$T/promotion.log" 2>&1; then
+  echo 'FAIL: a hardware-unqualified candidate passed promotion validation' >&2
+  exit 1
+fi
+grep -q 'not hardware-qualified' "$T/promotion.log"
+
+printf 'keep\n' > "$T/candidate/sentinel"
+if "$ROOT/candidates/j714s-normal-boot/prepare" "$T/candidate" > "$T/repeat.log" 2>&1; then
+  echo 'FAIL: candidate preparation accepted an existing destination' >&2
+  exit 1
+fi
+[[ $(cat "$T/candidate/sentinel") == 'keep' ]]
+if "$ROOT/candidates/j714s-normal-boot/prepare" "$ROOT/candidates/forbidden-build" > "$T/inside.log" 2>&1; then
+  echo 'FAIL: candidate preparation accepted a destination in the checkout' >&2
+  exit 1
+fi
+[[ ! -e $ROOT/candidates/forbidden-build ]]
+echo 'PASS: candidate recipes pinned, isolated, checksummed and blocked from hardware promotion'

