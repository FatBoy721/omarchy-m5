+-		"tx_status_retries_exhausted", "tx_status_lifetime_expired",
+-	};
+-	struct centauri_wifi *wifi = seq->private;
+-	u8 payload[22] = {};
+-	unsigned int i;
+-	int ret;
+-
+-	put_unaligned_le64(BIT_ULL(25), payload);
+-	payload[8] = 1;
+-	put_unaligned_le16(363, payload + 9);
+-	put_unaligned_le16(9, payload + 11);
