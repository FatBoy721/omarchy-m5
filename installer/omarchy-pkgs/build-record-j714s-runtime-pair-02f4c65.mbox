+-		writel(reset[i][1], port + reset[i][0]);
+-	for (i = 0; i < 16; i++)
+-		writel(0, port + 0x3000 + 4 * i);
+-	for (i = 0; i < 256; i++)
+-		writel(0, port + 0x3800 + 4 * i);
+-	for (i = 0; i < ARRAY_SIZE(tune); i++)
