@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Exercise the prepared candidate helper with fixture DT/firmware, never a host."""
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+PACKAGE = Path(sys.argv.pop(1)).resolve()
+spec = importlib.util.spec_from_file_location('legacy_order', Path(__file__).with_name('aurora-firmware-ordering.py'))
+legacy = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(legacy)
+legacy.PACKAGE = PACKAGE
+
+
+class CentauriOrderingTests(unittest.TestCase):
+    def probe(self, *, firmware=True, model='apple,j714s', path='apple/centauri/j714sap-ftab.bin',
+              node_compatible='pci106b,1900', duplicate=False):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            dt = root / 'dt'
+            dt.mkdir()
+            compatible = dt / 'compatible'
+            compatible.write_bytes(model.encode() + b'\0')
+            for index in range(2 if duplicate else 1):
+                node = dt / f'apcie0/device{index}'
+                node.mkdir(parents=True)
+                (node / 'compatible').write_bytes(node_compatible.encode() + b'\0')
+                (node / 'firmware-name').write_bytes(path.encode() + b'\0')
+            if firmware:
+                blob = root / 'firmware/vendor/apple/centauri/j714sap-ftab.bin'
+                blob.parent.mkdir(parents=True)
+                blob.write_bytes(b'synthetic firmware fixture')
+            calls = root / 'calls'
+            modprobe = root / 'modprobe'
+            modprobe.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> "$CALLS"\n')
+            modprobe.chmod(0o755)
+            env = dict(os.environ, AURORA_DT_ROOT=str(dt), AURORA_DT_COMPATIBLE=str(compatible),
+                       AURORA_FIRMWARE_ROOT=str(root / 'firmware'), AURORA_MODPROBE=str(modprobe), CALLS=str(calls))
+            result = subprocess.run(['bash', str(PACKAGE / 'aurora-peripheral-firmware.sh')],
+                                    env=env, capture_output=True, text=True)
+            return result.returncode, calls.read_text().splitlines() if calls.exists() else []
+
+    def test_ready_exact_board_uses_only_first_explicit_probe(self):
+        self.assertEqual(self.probe(), (0, ['apple_centauri']))
+
+    def test_missing_firmware_defers_without_reset_or_reload(self):
+        self.assertEqual(self.probe(firmware=False), (0, []))
+
+    def test_missing_or_ambiguous_control_identity_does_not_probe(self):
+        self.assertEqual(self.probe(node_compatible='pci106b,1901'), (0, []))
+        self.assertEqual(self.probe(duplicate=True), (0, []))
+
+    def test_untrusted_firmware_paths_are_not_used(self):
+        for path in ('../outside.bin', 'apple/centauri/../../outside-ftab.bin',
+                     'apple/centauri/j714sap-ftab.bin/other', 'apple/centauri/j714sap-ftabXbin'):
+            with self.subTest(path=path):
+                self.assertEqual(self.probe(path=path), (0, []))
+
+    def test_sibling_board_keeps_legacy_path(self):
+        self.assertEqual(self.probe(model='apple,j714sc'), (0, ['aop']))
+        self.assertEqual(self.probe(model='apple,j714c'), (0, ['aop']))
+
+    def test_autoload_is_blacklisted_and_normal_hook_supplies_dependencies(self):
+        self.assertIn('blacklist apple_centauri', (PACKAGE / 'aurora-firmware-order.conf').read_text())
+        install = (PACKAGE / 'aurora-vendor-order.install').read_text()
+        for line in ('add_module apple_centauri', 'add_binary tr'):
+            self.assertIn(line, install)
+
+
+suite = unittest.TestSuite((unittest.defaultTestLoader.loadTestsFromTestCase(legacy.AdmissionTests),
+                           unittest.defaultTestLoader.loadTestsFromTestCase(CentauriOrderingTests)))
+result = unittest.TextTestRunner(verbosity=1).run(suite)
+raise SystemExit(not result.wasSuccessful())
