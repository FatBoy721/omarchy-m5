+-	update(phy, 0, 0, 0x200);
+-	update(phy, 0, 0, 0x400);
+-	udelay(100);
+-	update(port, 0x82c, 0, 1);
+-	writel((gpio & ~0xfU) | 3, pad);
+-	udelay(100);
+-	readl(phy);
+-	wait_bits(port + 0xa8, 3, 0, 20000);
+-	update(port, 0x82c, BIT(16), 0);
