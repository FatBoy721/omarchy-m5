++{
++	static const char *const names[] = { "port%d", "phy%d", "intr2axi%d" };
++	struct apple_pcie *pcie = port->pcie;
++	struct platform_device *pdev = to_platform_device(pcie->dev);
++	void __iomem *rp, *ep;
++	char name[16];
++	u32 value, bus;
++	u8 cap;
++	bool msi = false;
++	int ret, i;
