++		reg = <0x2 0x94600000 0x0 0x4000>,
++		      <0x2 0x94c00000 0x0 0xc4000>;
++		reg-names = "asc", "sram";
++		mboxes = <&mtp_mbox>;
++		iommus = <&mtp_dart 0>;
++		#helper-cells = <0>;
++	};
