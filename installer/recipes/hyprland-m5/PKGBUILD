# hyprland-m5: Omarchy's Hyprland 0.57.2-2 for the M5 Pro MacBook's DCP display.
#
# Gathered. The recipe is omacom/omarchy-pkgs pkgbuilds/hyprland 0.57.2-2 (its three patches kept)
# built as hyprland-m5 with two more patches:
#  0001 rolotrealanis98's direct-scanout failed-candidate latch (m5pro-linux contrib/validated/
#       desktop/hyprland, 46d3b2e): a fullscreen client the DCP cannot scan out was re-tested every
#       frame, leaking 31 MB scanout buffers to OOM on his J716s.
#  0002 betizzel/omarchy-m5 patches/hyprland/0001: choose an alpha format first; the firmware-27
#       DCP primary plane offers only alpha formats and stock Hyprland aborts on it.
# Run on TripleU613's J714s at 3024x1890@120, GPU-rendered through zink; FatBoy721 ran 0002 on his.
#
# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: ThatOneCalculator <kainoa@t1c.dev>
# Contributor: Brenno Lemos <brenno@syndel.is>
# Contributor: Gabriel Fox <inbox@gabrielfox.dev>

pkgname=hyprland-m5
pkgver=0.57.2
# Above Arch's 0.57.2-1, so an x86_64 machine that took Arch's build moves to this one
pkgrel=2
pkgdesc='Hyprland for the M5 Pro MacBook DCP (Omarchy 0.57.2-2 + direct-scanout latch + alpha-only primary planes)'
# Built for x86_64 too, so PCs get the patches below and move with the titlebars plugin: see README.md
arch=(x86_64 aarch64)
url="https://github.com/hyprwm/Hyprland"
license=(BSD-3-Clause)
depends=(cairo # libcairo.so
         aquamarine
         libgcc # libgcc_s.so
         'libstdc++' # libstdc++.so
         glibc # libc.so libm.so
         glib2
         glslang # libglslang-default-resource-limits.so libglslang.so
         hyprcursor
         hyprgraphics
         hyprland-guiutils
         hyprlang
         hyprutils
         hyprwire
         lcms2
         libcanberra
         libdrm # libdrm.so
         libei
         libglvnd
         libinput # libinput.so
         libx11
         libxcb # libxcb-dri3.so libxcb-present.so libxcb-render.so libxcb-res.so libxcb-shm.so libxcb.so libxcb-xfixes.so libxcb-xinput.so
         libxcomposite # libxcb-composite.so
         libxcursor # libXcursor.so
         libxfixes
         libxkbcommon
         libxrender
         lua # liblua.so
         mesa # libgbm.so
         muparser # libmuparser.so
         opengl-driver
         pango
         pixman
         re2
         sdbus-cpp
         tomlplusplus
         util-linux-libs
         wayland
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors # libxcb-errors.so
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil # libxcb-render-util.so
         xcb-util-wm # libxcb-ewmh.so  libxcb-icccm.so
         xorg-xwayland)
makedepends=(cmake
             glaze
             hyprland-protocols
             hyprwayland-scanner
             meson
             ninja
             xorgproto)
optdepends=('hyprpm: build and install plugins'
            'hyprshutdown: clean logout and shutdown helper'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=("hyprland=$pkgver" wayland-compositor)
conflicts=(hyprland)
_archive="Hyprland-$pkgver"
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
        nvidia-egl-teardown.patch
        wl-output-global-grace.patch
        monitor-rule-vrr.patch
        0001-direct-scanout-latch-failed-candidate.patch
        0002-output-support-alpha-only-scanout.patch)
sha256sums=('34dbec0738ab88c8228caf89385662688ab1601ea58fbe5c60a6b6ab383db46d'
            '26d62139b8ae55e286bcdff1838a6bc01a021d8f1039b40b8fa523df83f61610'
            '8fa0f57dc1b3246ab4e30ae81419150f4af7767fb31e739e36c824c6d99fab73'
            'c14fb0ec02d97100bcfa4e5c8daaf524972fa5c665e04960619744ba01c73c39'
            '3049a6d8bcef2ad5b3e34a2daf9ab59fb4d3f9b05b455d553d8435e53aca516b'
            '5fcd37fc0193223d10d309441f87acd82552fb497d5d9fc7f34f874a40bfdd42')

prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	# Release the EGL context before teardown; NVIDIA's EGL crashes on exit otherwise
	patch -Np1 --fuzz=0 -i "$srcdir/nvidia-egl-teardown.patch"
	# Destroying a wl_output global that clients may still be binding kills every client
	# when a dock's output flaps; wait before destroying it, as wlroots does
	patch -Np1 --fuzz=0 -i "$srcdir/wl-output-global-grace.patch"
	# A reload ignored a monitor rule's vrr unless something else about the rule changed
	patch -Np1 --fuzz=0 -i "$srcdir/monitor-rule-vrr.patch"
	# M5 DCP: rolotrealanis98's direct-scanout latch, then pick an alpha format first
	patch -Np1 --fuzz=0 -i "$srcdir/0001-direct-scanout-latch-failed-candidate.patch"
	patch -Np1 -i "$srcdir/0002-output-support-alpha-only-scanout.patch"
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$_archive"
	make release PREFIX=/usr
}

package() {
	depends+=(libEGL.so
	          libGLESv2.so
	          libaquamarine.so
	          libcanberra.so
	          libeis.so
	          libgio-2.0.so
	          libgobject-2.0.so
	          libhyprcursor.so
	          libhyprgraphics.so
	          libhyprlang.so
	          libhyprutils.so
	          libhyprwire.so
	          liblcms2.so
	          libpango-1.0.so
	          libpangocairo-1.0.so
	          libpixman-1.so
	          libre2.so
	          libreadline.so
	          libsdbus-c++.so
	          libtomlplusplus.so
	          libuuid.so
	          libwayland-server.so
	          libxkbcommon.so)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find $pkgdir -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
