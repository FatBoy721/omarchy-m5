CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_DART=y
CONFIG_BTRFS_FS=m
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=m
CONFIG_VFAT_FS=y
CONFIG_DRM_ASAHI=y
CONFIG_GPIO_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_APPLE_CENTAURI=m
CONFIG_POWER_RESET_MACSMC=m
CONFIG_MACSMC_POWER=y
CONFIG_DM_INTEGRITY=m
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_DRM_APPLE=y
CONFIG_APPLE_AOP=m
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
# edimoldovan omarchy-mac-pkgs 74d8f8bbef: lets kernel.sched_util_clamp_min_rt_default=0 stop
# realtime threads (PipeWire) holding the P clusters at top speed
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
# AOP sensors: lid angle and ambient light (DjDeveloperr #1542/#1548)
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
