build() {
  # AVD_VER/AVD_TIER as the J714s ADT's avd0 reports them (avd-version 5, tier 2)
  make -C avd-fw AVD_VER=5 AVD_TIER=2
}

package() {
  # These services run on the target system; packaging only installs files.
  depends=('bash' 'iw' 'kmod' 'omarchy-mac-boot' 'wireless-regdb' 'linux-aurora>=7.1.12.aurora5')
  install -Dm644 aurora-firmware-order.conf "$pkgdir/usr/lib/modprobe.d/aurora-firmware-order.conf"
  install -Dm755 aurora-peripheral-firmware.sh "$pkgdir/usr/lib/omarchy/initcpio/aurora-peripheral-firmware.sh"
  install -Dm644 aurora-peripheral-firmware.service "$pkgdir/usr/lib/systemd/system/aurora-peripheral-firmware.service"
  install -Dm755 aurora-vendor-order.install "$pkgdir/usr/lib/initcpio/install/aurora-vendor-order"
  install -Dm644 95-aurora-vendor-order.conf "$pkgdir/etc/mkinitcpio.conf.d/95-aurora-vendor-order.conf"
  install -Dm644 aurora-vendor-order-cryptsetup.conf "$pkgdir/usr/lib/omarchy/initcpio/aurora-vendor-order-cryptsetup.conf"
  install -Dm644 20-aurora-vendor-order.conf "$pkgdir/usr/lib/systemd/system/omarchy-vendor-firmware.service.d/20-aurora-vendor-order.conf"
  install -Dm755 aurora-regdom-fallback "$pkgdir/usr/lib/omarchy/aurora-regdom-fallback"
  install -Dm644 aurora-regdom-fallback.service "$pkgdir/usr/lib/systemd/system/aurora-regdom-fallback.service"
  install -Dm644 86-aurora-regdom-fallback.rules "$pkgdir/usr/lib/udev/rules.d/86-aurora-regdom-fallback.rules"

  # J714 (MacBook Pro 14", M5) audio, edimoldovan's (omarchy-mac-pkgs branch
  # j714-speaker-route-volume, 0a00f7a88711): speakersafetyd's j714 profile
  # (GPL-2.0-only, from speakersafetyd's j316.conf and m5pro-linux's J716
  # thermal model), the speaker graph (asahi-audio's J314 filters in J714
  # channel order) and the microphone graph, wired up by WirePlumber.
  install -Dm644 speakersafetyd-j714.conf "$pkgdir/usr/share/speakersafetyd/apple/j714.conf"
  install -Dm644 j714-speakers.json "$pkgdir/usr/share/omarchy-mac/j714/speakers.json"
  install -Dm644 j714-mic.json "$pkgdir/usr/share/omarchy-mac/j714/mic.json"
  install -Dm644 wireplumber-j714-speakers.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/j714-speakers.conf"
  install -Dm644 wireplumber-j714-mic.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/j714-mic.conf"

  # 6 GHz Wi-Fi on the N1 (edimoldovan/omarchy-mac-pkgs iwd-6ghz-bcm4388-only
  # 702a6ec363): iwd's own defaults in place of the Apple one that keeps 6 GHz off.
  install -Dm644 iwd-n1-main.conf "$pkgdir/usr/lib/omarchy-aurora/iwd-n1/main.conf"
  install -Dm644 30-aurora-n1-6ghz.conf "$pkgdir/usr/lib/systemd/system/iwd.service.d/30-aurora-n1-6ghz.conf"

  # Realtime threads (PipeWire) no longer hold the P clusters at top speed
  # (edimoldovan/omarchy-mac-pkgs rt-uclamp 74d8f8bbef); needs CONFIG_UCLAMP_TASK.
  install -Dm644 90-aurora-rt-uclamp.conf "$pkgdir/usr/lib/sysctl.d/90-aurora-rt-uclamp.conf"

  # The internal display through the DCP: when m1n1 hands it over, Hyprland scans out on the
  # apple-drm card (linear buffers) and renders on the GPU through zink, in the uwsm session
  # (user environment generator) and the SDDM greeter (start-hyprland-m5). Nothing changes on
  # a simpledrm boot. rolotrealanis98's J716s daily session, run on TripleU613's J714s.
  install -Dm755 aurora-m5-display-env "$pkgdir/usr/lib/omarchy-aurora/aurora-m5-display-env"
  install -Dm755 start-hyprland-m5 "$pkgdir/usr/lib/omarchy-aurora/start-hyprland-m5"
  install -d "$pkgdir/usr/lib/systemd/user-environment-generators"
  ln -s /usr/lib/omarchy-aurora/aurora-m5-display-env "$pkgdir/usr/lib/systemd/user-environment-generators/60-aurora-m5-display"
  install -Dm644 60-aurora-m5-display.conf "$pkgdir/etc/sddm.conf.d/60-aurora-m5-display.conf"

  # Speakers, headphone jack and microphones in PipeWire. The J714 UCM profiles are edimoldovan's
  # (aurora-silicon/alsa-ucm-conf-asahi #10, merged after alsa-ucm-conf-aurora 10.aurora3 was built;
  # drop them when that package carries them). The busy-card discovery is kazuhidet's (J713): without
  # it PipeWire skips the speaker card while speakersafetyd holds its sense PCM.
  install -Dm644 ucm-macaudio-j714.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/macaudio/MacBook Pro J714.conf"
  install -Dm644 ucm-aop-j714.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/t8140-aop-audio/MacBook Pro J714 AOP Audio.conf"
  install -Dm644 wireplumber-81-aurora-busy-discovery.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/81-aurora-busy-discovery.conf"

  # Hardware video decode: the J714s decoder (linux-aurora-n1 0017, DjDeveloperr's #1577) runs
  # avd-fw v5-t2, which the image's avd-fw 0.1 does not ship (it ends at v5-t1).
  install -Dm644 avd-fw/build/avd-fw-v5-t2.bin "$pkgdir/usr/lib/firmware/apple/avd-fw-v5-t2.bin"
  install -Dm644 avd-fw/LICENSE "$pkgdir/usr/share/licenses/$pkgname/avd-fw-LICENSE"
}
