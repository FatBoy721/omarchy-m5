prepare() {
  # A copy, so the patch never touches the downloaded file makepkg checks.
  cp -L "${_short}-load-driver" aurora-sep-load
  patch -Np1 -i aurora-sep-load-read-only.patch
  if grep -nE '(xart_writes|provision_keybag)=1' aurora-sep-load; then
    echo "the loader still turns enclave writes on" >&2
    return 1
  fi
}

check() {
  bash test-read-only-loader.sh aurora-sep-load
}

# A unit and the helper it runs, pointed at the packaged helper (upstream's _unit).
_unit() {
  local unit="$pkgdir/usr/lib/systemd/system/$2"

  install -Dm755 "$1" "$pkgdir/usr/lib/aurora-sep/$3"
  install -Dm644 "${_short}-$2" "$unit"
  sed -i "s|^\(Exec[A-Za-z]*=\)/usr/local/sbin/|\1/usr/lib/aurora-sep/|" "$unit"
  ! grep -q /usr/local "$unit"
}

package() {
  _unit aurora-sep-load aurora-sep.service aurora-sep-load
  _unit "${_short}-aurora-sep-ready" aurora-sep-ready.service aurora-sep-ready
  install -Dm644 "${_short}-aurora-sep.timer" "$pkgdir/usr/lib/systemd/system/aurora-sep.timer"
  install -Dm755 "${_short}-sensor-present" "$pkgdir/usr/lib/aurora-sep/aurora-sep-sensor-present"

  # The Touch ID calibration setup, run when a file is missing or refused.
  install -Dm755 "${_short}-touchid-setup-needed" "$pkgdir/usr/lib/aurora-sep/aurora-touchid-setup-needed"
  install -Dm755 "${_short}-aurora-touchid-setup" "$pkgdir/usr/bin/aurora-touchid-setup"
  install -Dm755 "${_short}-extract-mesa-calibration.py" "$pkgdir/usr/libexec/aurora/extract-mesa-calibration"
  install -Dm644 "${_short}-aurora-touchid-setup.service" "$pkgdir/usr/lib/systemd/system/aurora-touchid-setup.service"
  sed -i -e "s|^\(Exec[A-Za-z]*=\)/usr/local/sbin/aurora-touchid-setup |\1/usr/bin/aurora-touchid-setup |" \
    -e "s|^\(Exec[A-Za-z]*=\)/usr/local/sbin/|\1/usr/lib/aurora-sep/|" \
    "$pkgdir/usr/lib/systemd/system/aurora-touchid-setup.service"

  # Read-only tools, and the root-only recovery tools XART-SAFETY.md describes.
  install -Dm755 "${_short}-aurora-sep" "$pkgdir/usr/bin/aurora-sep"
  install -Dm755 "${_short}-sep-bio-identities" "$pkgdir/usr/bin/sep-bio-identities"
  install -Dm755 "${_short}-aurora-sep-policy-change" "$pkgdir/usr/bin/aurora-sep-policy-change"
  install -Dm755 "${_short}-apfs-xart-inspect.py" "$pkgdir/usr/lib/aurora-sep/apfs-xart-inspect.py"

  # fprintd: ordering only (fprintd-aurora-sep.conf says why).
  install -Dm644 fprintd-aurora-sep.conf "$pkgdir/usr/lib/systemd/system/fprintd.service.d/aurora-sep.conf"

  # No udev load (upstream's blacklist), and read-only unless the owner replaces
  # aurora-sep-xart.conf with /etc/modprobe.d/aurora-sep-xart.conf.
  install -Dm644 "${_short}-aurora-sep-load.conf" "$pkgdir/usr/lib/modprobe.d/aurora-sep-load.conf"
  install -Dm644 aurora-sep-xart.conf "$pkgdir/usr/lib/modprobe.d/aurora-sep-xart.conf"

  # An example only: it changes the power key for everyone.
  install -Dm644 "${_short}-logind-aurora-sep.conf" "$pkgdir/usr/share/aurora-sep/logind-aurora-sep.conf"

  local doc
  for doc in README.md XART-SAFETY.md HOST-STATE.md OS-IDENTITY.md; do
    install -Dm644 "${_short}-$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.omarchy-m5.md"

  # Nothing outside the docs may turn writes on (comments aside), and nothing is enabled.
  if grep -rlE '^[^#]*(xart_writes|provision_keybag)=1' "$pkgdir/usr/lib" "$pkgdir/usr/bin" "$pkgdir/usr/libexec"; then
    echo "a packaged file turns enclave writes on" >&2
    return 1
  fi
  grep -qx 'options apple_sep xart_writes=0 provision_keybag=0' "$pkgdir/usr/lib/modprobe.d/aurora-sep-xart.conf"
  if [[ -e $pkgdir/etc || -d $pkgdir/usr/lib/systemd/system-preset ]] ||
    find "$pkgdir/usr/lib/systemd/system" -name '*.wants' | grep -q .; then
    echo "the package enables a unit" >&2
    return 1
  fi
}
