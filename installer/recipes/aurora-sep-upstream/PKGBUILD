# aurora-silicon's Secure Enclave / Touch ID userspace (tools/aurora-sep), read-only by default
#
# For the experimental J714s upstream image. Upstream's own Arch package is
# tools/aurora-sep/packaging/arch/aurora-sep (pkgver 1, pkgrel 17 at this commit);
# this one installs the same loader, CLI, ready/setup services and calibration
# tool, pinned by commit and sha256, with three changes so the image never
# writes Secure Enclave or xART state unless the owner opts in (README.md):
#   - aurora-sep-xart.conf: options apple_sep xart_writes=0 provision_keybag=0
#     (the driver's defaults are 1 and 1);
#   - aurora-sep-load-read-only.patch: the loader no longer passes
#     xart_writes=1 provision_keybag=1 to modprobe (they would override
#     modprobe.d), and a read-only attach ends it cleanly;
#   - fprintd-aurora-sep.conf: fprintd is ordered after the loader instead of
#     Requires= it, so starting fprintd does not load the driver.
# No unit is enabled and there is no preset.

pkgname=aurora-sep
_commit=8679514f4dff40a7c907daf834208e6afca427f1
_short=${_commit:0:12}
pkgver=1.17.g${_short}
pkgrel=1
pkgdesc="Loader and Touch ID integration for the Apple SEP driver (read-only unless the owner opts in)"
url="https://github.com/aurora-silicon/linux/tree/${_commit}/tools/aurora-sep"
arch=(any)
license=(GPL-2.0-only)
depends=(
  coreutils
  fprintd
  keyutils
  kmod
  # sep-bio interface 5; libfprint-git (v4 only) must not replace it.
  libfprint-aurora
  python
  sh
)

_raw=https://raw.githubusercontent.com/aurora-silicon/linux/${_commit}/tools/aurora-sep
_upstream=(load-driver aurora-sep.service aurora-sep-ready aurora-sep-ready.service aurora-sep.timer
  aurora-sep-load.conf sensor-present touchid-setup-needed aurora-touchid-setup
  aurora-touchid-setup.service extract-mesa-calibration.py aurora-sep sep-bio-identities
  aurora-sep-policy-change apfs-xart-inspect.py logind-aurora-sep.conf
  README.md XART-SAFETY.md HOST-STATE.md OS-IDENTITY.md)
source=()
for _i in "${!_upstream[@]}"; do
  source[_i]="${_short}-${_upstream[_i]}::${_raw}/${_upstream[_i]}"
done
source+=(aurora-sep-load-read-only.patch aurora-sep-xart.conf fprintd-aurora-sep.conf
  README.md test-read-only-loader.sh)
# The upstream files: sha256 of `git show 8679514f4dff:tools/aurora-sep/<file>`.
