     // macOS 27.2 (26B123), read from a J813 stub booted by it (system and OS iBoot alike).
     [V27_2]      = {V27_2,      "27.2",        {27, 2, 0},     3, "mBoot-20457.41.3"},
+    // From betizzel's m1n1 (J714s): 27.3 beta 1 (26C5035r) is the first stub that boots all of
+    // the M5 Pro's cores; m1n1 reports a beta as <major>.<minor-1>.98.<n>.
+    [V27_3B1]    = {V27_3B1,    "27.3 beta",   {27, 2, 98, 1}, 4, "mBoot-20457.60.65.0.1"},
     // clang-format on
 };
 
