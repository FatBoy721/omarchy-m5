+/*
+ * The GPU's voltage bins are fused per chip, and iBoot publishes this chip's in the sgx node.
+ * The kernel keeps its own power model, but takes the bins from here rather than from a table
+ * measured on one unit: each ADT property is copied byte for byte (little-endian, as in the ADT)
+ * to an apple,adt-<name> property of the gpu node, and the kernel validates them. An ADT that
+ * lacks one leaves the property out, so a kernel that needs it refuses to start the GPU instead
+ * of guessing.
+ */
+static int t6050_copy_perf_states(void *dt, int sgx)
+{
+    static const char *const props[] = {
+        "perf-states",     "perf-states-sram", "perf-state-count",
+        "perf-state-table-count", "afr-perf-states", "cs-perf-states",
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(props); i++) {
+        u32 len = 0;
+        const void *val = adt_getprop(adt, sgx, props[i], &len);
+        if (!val || !len)
+            continue;
+        char name[48];
+        snprintf(name, sizeof(name), "apple,adt-%s", props[i]);
+        int gpu = fdt_path_offset(dt, "gpu");
+        if (gpu < 0 || fdt_setprop(dt, gpu, name, val, len)) {
+            printf("FDT: GPU: T6050: failed to set %s\n", name);
+            return -1;
+        }
+    }
+    return 0;
+}
