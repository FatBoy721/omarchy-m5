From 42ab1eb753c3bf31243991202e9a674bd461d0ea Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 12:47:46 +0100
Subject: [PATCH 2/3] Extract the IMX958 setfiles for the M5 Max J714c camera

The J714c front camera is an IMX958 (sensor 0x958). The apple_isp driver
loads apple/isp_2226_02XX.dat for its build rev 2 module, and
apple/isp_2224_01XX.dat for the older revision. Register both in the ISP
setfile registry so the installer extracts them from appleh16camerad
next to IMX558 1925.

Tested on the J714c: with 2226_02 loaded the camera streams 2560x1440
at 29 fps in a browser and in mpv.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Engine/overlay/src/omarchy_isp.py        | 11 +++++++----
 Engine/overlay/tests/test_omarchy_isp.py | 14 +++++++++++++-
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/Engine/overlay/src/omarchy_isp.py b/Engine/overlay/src/omarchy_isp.py
index 01efc02..e7644e4 100644
--- a/Engine/overlay/src/omarchy_isp.py
+++ b/Engine/overlay/src/omarchy_isp.py
@@ -1,8 +1,8 @@
 # SPDX-License-Identifier: MIT
 """Extend the engine's ISP registry and scan both Apple camera daemons.
 
-Keep every inherited supported sensor. IMX558 1925's magic and length are
-the apple_isp driver's setfile entry; other unqualified sensor IDs are not
+Keep every inherited supported sensor. IMX558 1925's and IMX958 2224's and
+2226's magic and length are the apple_isp driver's setfile entries; other unqualified sensor IDs are not
 enabled merely because a byte pattern occurs in the daemon.
 """
 
@@ -13,6 +13,9 @@ import struct
 
 SetFile = namedtuple("SetFile", "sensor magic name size")
 IMX558_1925 = SetFile(0x558, 0x19250306, "1925_03XX", 0xCBC0)
+IMX958_2224 = SetFile(0x958, 0x22240106, "2224_01XX", 0x6FF4)
+# The M5 Max J714c IMX958 module (build rev 2) is tuned by 2226_02.
+IMX958_2226 = SetFile(0x958, 0x22260201, "2226_02XX", 0x6FF4)
 DAEMON_NAMES = ("appleh13camerad", "appleh16camerad")
 ALIGNMENT = 0x1000
 log = logging.getLogger(__name__)
@@ -23,10 +26,10 @@ class IspError(ValueError):
 
 
 def extended_setfiles(inherited):
-    """Preserve inherited entries, adding 1925 once without silent conflicts."""
+    """Preserve inherited entries, adding 1925, 2224 and 2226 once without silent conflicts."""
     entries = {}
     names = {}
-    for entry in (*inherited, IMX558_1925):
+    for entry in (*inherited, IMX558_1925, IMX958_2224, IMX958_2226):
         previous = entries.get(entry.magic)
         if previous is not None and tuple(previous) != tuple(entry):
             raise IspError(f"conflicting ISP registry entry {entry.magic:#x}")
diff --git a/Engine/overlay/tests/test_omarchy_isp.py b/Engine/overlay/tests/test_omarchy_isp.py
index 73ab264..5f88e36 100644
--- a/Engine/overlay/tests/test_omarchy_isp.py
+++ b/Engine/overlay/tests/test_omarchy_isp.py
@@ -23,7 +23,7 @@ class IspTests(unittest.TestCase):
     def test_extends_registry_without_changing_inherited_entries(self):
         custom = isp.SetFile(1, 0xABCD1234, "future_01XX", 100)
         result = isp.extended_setfiles([LEGACY, IMX558_1921, custom])
-        self.assertEqual(result, (LEGACY, IMX558_1921, custom, isp.IMX558_1925))
+        self.assertEqual(result, (LEGACY, IMX558_1921, custom, isp.IMX558_1925, isp.IMX958_2224, isp.IMX958_2226))
         self.assertEqual(isp.extended_setfiles(result), result)
         with self.assertRaises(isp.IspError):
             isp.extended_setfiles([isp.IMX558_1925._replace(size=64)])
@@ -34,6 +34,18 @@ class IspTests(unittest.TestCase):
         self.assertEqual(output, {"apple/isp_1925_03XX.dat": data})
         self.assertEqual(len(next(iter(output.values()))), 52160)
 
+    def test_extracts_2224_full_kernel_size(self):
+        data = blob(isp.IMX958_2224, 0xCD)
+        output = isp.extract(bytes(4096) + data, [LEGACY])
+        self.assertEqual(output, {"apple/isp_2224_01XX.dat": data})
+        self.assertEqual(len(next(iter(output.values()))), 28672)
+
+    def test_extracts_2226_full_kernel_size(self):
+        data = blob(isp.IMX958_2226, 0xEF)
+        output = isp.extract(bytes(4096) + data, [LEGACY])
+        self.assertEqual(output, {"apple/isp_2226_02XX.dat": data})
+        self.assertEqual(len(next(iter(output.values()))), 28672)
+
     def test_both_daemons_and_legacy_only_directory(self):
         with tempfile.TemporaryDirectory() as tmp:
             directory = Path(tmp)
