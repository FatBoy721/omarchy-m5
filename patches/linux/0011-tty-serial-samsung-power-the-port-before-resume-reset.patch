Subject: [PATCH] tty: serial: samsung: power the port before its resume reset

On J714s/T6050, pm_test=devices panicked with an asynchronous SError in
s3c24xx_serial_resume+0x84 (an el1_abort on the UART at 0x505200004). The
unused debug UART is runtime suspended and genpd powers its domain
(UART0) down; the system resume callback then wrote the registers
without powering the port. Take a runtime PM reference around the
reset. The noirq callback needs none: genpd powers the domain on first.

---
diff --git a/drivers/tty/serial/samsung_tty.c b/drivers/tty/serial/samsung_tty.c
index d33a5d848..015fadfe9 100644
--- a/drivers/tty/serial/samsung_tty.c
+++ b/drivers/tty/serial/samsung_tty.c
@@ -2107,13 +2107,25 @@ static int __maybe_unused s3c24xx_serial_resume(struct device *dev)
 	struct s3c24xx_uart_port *ourport = to_ourport(port);
 
 	if (port) {
-		clk_prepare_enable(ourport->clk);
-		if (!IS_ERR(ourport->baudclk))
-			clk_prepare_enable(ourport->baudclk);
-		s3c24xx_serial_resetport(port, s3c24xx_port_to_cfg(port));
-		if (!IS_ERR(ourport->baudclk))
-			clk_disable_unprepare(ourport->baudclk);
-		clk_disable_unprepare(ourport->clk);
+		/*
+		 * omarchy-m5: an unused port is runtime suspended, and its PM
+		 * domain may be off (genpd powers it down). On Apple SoCs a
+		 * register write to a powered-off UART is an external abort
+		 * (SError), so power the port for the reset. Without runtime PM
+		 * the device is active and this takes nothing but a reference.
+		 */
+		if (pm_runtime_resume_and_get(dev) < 0) {
+			dev_warn(dev, "cannot power the port, skipping its reset\n");
+		} else {
+			clk_prepare_enable(ourport->clk);
+			if (!IS_ERR(ourport->baudclk))
+				clk_prepare_enable(ourport->baudclk);
+			s3c24xx_serial_resetport(port, s3c24xx_port_to_cfg(port));
+			if (!IS_ERR(ourport->baudclk))
+				clk_disable_unprepare(ourport->baudclk);
+			clk_disable_unprepare(ourport->clk);
+			pm_runtime_put_sync(dev);
+		}
 
 		uart_resume_port(&s3c24xx_uart_drv, port);
 	}
