Subject: [PATCH] arm64: idle: preserve registers across WFI on Apple M4 and later

On M4 and later Apple cores (T6050: MIDR parts 0x064/0x065) WFI powers
the core down and loses x0-x30 and FP/SIMD; SP, PC and memory survive.
CYC_OVRD is locked, so the core cannot be told to retain state, and
until now only idle=nop was stable, spinning every core at full clock.

cpu_do_idle() now enters WFI through apple_cpu_wfi(), which stores
x18-x30 (callee-saved, FP, LR and the shadow call stack pointer) on the
stack around DSB SY; WFI, restoring them after an ISB. Being a normal
call, it already tells the compiler x0-x17 and the flags are clobbered.
fpsimd_save_and_flush_cpu_state() first saves live user FP/SIMD state
and drops this CPU's ownership so the next return to userspace reloads
it. The decision is made in smp_prepare_boot_cpu() from the boot CPU's
MIDR (midr_is_apple_m4_or_later(): Apple part >= 0x052) as an
__ro_after_init flag, because the boot CPU can idle as soon as
rest_init() starts its idle thread, before any initcall. idle= is
parsed earlier in setup_arch(), so idle=nop/idle=yield still bypass WFI.
dmesg prints "Apple: preserving registers across WFI" when enabled.

Ported from aurora-silicon/linux (integration/aurora), GPL-2.0-only:
  c407e1097ba7 Ryan Murray: register-saving WFI helper (idle-apple.S,
               apple-idle.h) and the FP/SIMD flush in cpu_do_idle()
  6c03bd926fc5 DjDeveloperr: extend the match to T6050 0x064/0x065
  3f0822d73dbe Diljit Singh: midr_is_apple_m4_or_later() predicate
  34649b455f4a Jonathan Goyvaerts: decide in smp_prepare_boot_cpu()
Not ported: 3f0822d73dbe's forced id_aa64isar2.wfxt=0 in
pi/idreg-override.c (we pass arm64.nowfxt, patch 0009, so __delay()
never uses WFIT/WFET), 6c03bd926fc5's lib/delay.c WFxT bypass (same
reason), and the T8142-only idle=nop override from 5c9cbb25dba8.

---
diff --git a/arch/arm64/include/asm/apple-idle.h b/arch/arm64/include/asm/apple-idle.h
new file mode 100644
index 000000000..619882f65
--- /dev/null
+++ b/arch/arm64/include/asm/apple-idle.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_APPLE_IDLE_H
+#define __ASM_APPLE_IDLE_H
+
+/* WFI that preserves x18-x30 on affected Apple cores. */
+void apple_cpu_wfi(void);
+
+#ifdef CONFIG_ARCH_APPLE
+/* Called from smp_prepare_boot_cpu(): before the boot CPU's first idle. */
+void apple_wfi_quirk_init(void);
+#else
+static inline void apple_wfi_quirk_init(void) { }
+#endif
+
+#endif
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index 1b9f0cda1..26d59e0bc 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -153,6 +153,7 @@
 #define APPLE_CPU_PART_M2_AVALANCHE_PRO	0x035
 #define APPLE_CPU_PART_M2_BLIZZARD_MAX	0x038
 #define APPLE_CPU_PART_M2_AVALANCHE_MAX	0x039
+#define APPLE_CPU_PART_M4_DONAN_E	0x052
 
 #define AMPERE_CPU_PART_AMPERE1		0xAC3
 #define AMPERE_CPU_PART_AMPERE1A	0xAC4
@@ -271,6 +272,16 @@ static inline u32 __attribute_const__ read_cpuid_id(void)
 	return read_cpuid(MIDR_EL1);
 }
 
+/*
+ * Apple part numbers from Donan onward identify the M4 and later
+ * generations; T6050 (M5 Pro/Max) reports parts 0x064 and 0x065.
+ */
+static inline bool midr_is_apple_m4_or_later(u32 midr)
+{
+	return MIDR_IMPLEMENTOR(midr) == ARM_CPU_IMP_APPLE &&
+	       MIDR_PARTNUM(midr) >= APPLE_CPU_PART_M4_DONAN_E;
+}
+
 /*
  * Represent a range of MIDR values for a given CPU model and a
  * range of variant/revision values.
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index 7da199d7e..76d372424 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -37,6 +37,8 @@ obj-y			:= debug-monitors.o entry.o irq.o fpsimd.o		\
 			   cpufeature_impdef.o					\
 			   rsi.o jump_label.o
 
+obj-$(CONFIG_ARCH_APPLE)		+= idle-apple.o
+
 obj-$(CONFIG_COMPAT)			+= sys32.o signal32.o			\
 					   sys_compat.o
 obj-$(CONFIG_COMPAT)			+= sigreturn32.o
diff --git a/arch/arm64/kernel/idle.c b/arch/arm64/kernel/idle.c
index 42c5543f9..4fdbdf076 100644
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -4,11 +4,15 @@
  */
 
 #include <linux/cpu.h>
+#include <linux/init.h>
 #include <linux/irqflags.h>
 
+#include <asm/apple-idle.h>
 #include <asm/barrier.h>
 #include <asm/cpuidle.h>
 #include <asm/cpufeature.h>
+#include <asm/cputype.h>
+#include <asm/fpsimd.h>
 #include <asm/sysreg.h>
 
 enum {
@@ -34,6 +38,39 @@ static int __init setup_idle(char *arg)
 }
 early_param("idle", setup_idle);
 
+#ifdef CONFIG_ARCH_APPLE
+/*
+ * Preserve general-purpose and FP/SIMD state across WFI on M4 and later
+ * Apple cores.
+ *
+ * The decision has to be made before the boot CPU first idles, which can
+ * happen as soon as rest_init() starts its idle thread, long before any
+ * initcall runs: on these SoCs the boot CPU loses its registers too. It is
+ * made from smp_prepare_boot_cpu(), where static keys cannot be flipped
+ * yet, so it is a plain flag. idle= is parsed earlier (setup_arch()), and
+ * idle=nop or idle=yield still bypass WFI entirely.
+ */
+static bool apple_wfi_loses_regs __ro_after_init;
+
+void __init apple_wfi_quirk_init(void)
+{
+	if (midr_is_apple_m4_or_later(read_cpuid_id())) {
+		apple_wfi_loses_regs = true;
+		pr_info("Apple: preserving registers across WFI\n");
+	}
+}
+
+static __always_inline bool apple_wfi_needs_save(void)
+{
+	return unlikely(READ_ONCE(apple_wfi_loses_regs));
+}
+#else
+static __always_inline bool apple_wfi_needs_save(void)
+{
+	return false;
+}
+#endif
+
 /*
  *	cpu_do_idle()
  *
@@ -50,8 +87,18 @@ void __cpuidle cpu_do_idle(void)
 	arm_cpuidle_save_irq_context(&context);
 
 	if (likely(idle == ARM64_IDLE_WFI)) {
-		dsb(sy);
-		wfi();
+		if (apple_wfi_needs_save()) {
+			/*
+			 * The FP/SIMD registers do not survive either: drop the
+			 * lazy ownership so the next return to userspace reloads
+			 * them, even when the same task resumes on this CPU.
+			 */
+			fpsimd_save_and_flush_cpu_state();
+			apple_cpu_wfi();
+		} else {
+			dsb(sy);
+			wfi();
+		}
 	} else if (idle == ARM64_IDLE_YIELD) {
 		dsb(sy);
 		asm volatile("yield" ::: "memory");
diff --git a/arch/arm64/kernel/smp.c b/arch/arm64/kernel/smp.c
index cdcdd160e..89f77a041 100644
--- a/arch/arm64/kernel/smp.c
+++ b/arch/arm64/kernel/smp.c
@@ -37,6 +37,7 @@
 #include <linux/nmi.h>
 
 #include <asm/alternative.h>
+#include <asm/apple-idle.h>
 #include <asm/atomic.h>
 #include <asm/cacheflush.h>
 #include <asm/cpu.h>
@@ -455,6 +456,7 @@ void __init smp_prepare_boot_cpu(void)
 
 	cpuinfo_store_boot_cpu();
 	setup_boot_cpu_features();
+	apple_wfi_quirk_init();
 
 	/* Conditionally switch to GIC PMR for interrupt masking */
 	if (system_uses_irq_prio_masking())
diff --git a/arch/arm64/kernel/idle-apple.S b/arch/arm64/kernel/idle-apple.S
new file mode 100644
index 000000000..4f31e8410
--- /dev/null
+++ b/arch/arm64/kernel/idle-apple.S
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+
+/*
+ * Affected Apple cores can resume from WFI with cleared general registers.
+ * SP and stack memory survive. Preserve the AAPCS64 callee-saved registers
+ * and x18 (which may hold the shadow call stack), including the return PC.
+ * This follows the stateless-wait approach used during m1n1 M5 Windows
+ * bring-up. It does not configure an Apple deep-sleep state or DVFS policy.
+ *
+ * IRQ masking/context management remains with cpu_do_idle(). The direct
+ * function call tells its compiler that x0-x17 and flags are clobbered.
+ */
+	.macro apple_wait_save
+	stp	x29, x30, [sp, #-112]!
+	mov	x29, sp
+	stp	x19, x20, [sp, #16]
+	stp	x21, x22, [sp, #32]
+	stp	x23, x24, [sp, #48]
+	stp	x25, x26, [sp, #64]
+	stp	x27, x28, [sp, #80]
+	str	x18, [sp, #96]
+	dsb	sy
+	.endm
+
+	.macro apple_wait_restore
+	isb
+	ldr	x18, [sp, #96]
+	ldp	x19, x20, [sp, #16]
+	ldp	x21, x22, [sp, #32]
+	ldp	x23, x24, [sp, #48]
+	ldp	x25, x26, [sp, #64]
+	ldp	x27, x28, [sp, #80]
+	ldp	x29, x30, [sp], #112
+	ret
+	.endm
+
+	.pushsection .cpuidle.text, "ax"
+SYM_FUNC_START(apple_cpu_wfi)
+	apple_wait_save
+	wfi
+	apple_wait_restore
+SYM_FUNC_END(apple_cpu_wfi)
+	.popsection
