From a3a890a5925298715e14ec96c9ee6db7d60a9a27 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 01:57:54 +0100
Subject: [PATCH 03/24] soc: apple: rtkit: Boot T6050 coprocessors the way the
 loader does

On T6050 the coprocessors come up with the handshake the boot loader
uses:

- the system endpoints start in the loader's order (debug, crashlog,
  syslog, ioreport, oslog), and tracekit is not started;
- oslog notifications are not acknowledged, as on T8140 and T8142;
- the boot waits until the IOP reports the ON power state, since it can
  acknowledge intermediate states first;
- the AP power state ACK gets a 200 ms window and is not required: the
  loader never waits for it, and macsmc starts its endpoint right after
  the wake, before the SMC ACK arrives.

All four are limited to "apple,t6050" machines.

Tested on J714c (MacBook Pro 14-inch, M5 Max) in the bring-up tree these
changes come from: ANS boots and the internal SSD works.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soc/apple/rtkit.c | 50 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index 11334b3f68faa5..c37008e2d86e79 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -190,7 +190,13 @@ static void apple_rtkit_management_rx_hello(struct apple_rtkit *rtk, u64 msg)
 
 static void apple_rtkit_management_rx_epmap(struct apple_rtkit *rtk, u64 msg)
 {
-	int i, ep, ret;
+	/* T6050: the system endpoints start in the loader's order, 3 1 2 4 8. */
+	static const u8 t6050_order[] = { APPLE_RTKIT_EP_DEBUG, APPLE_RTKIT_EP_CRASHLOG,
+					   APPLE_RTKIT_EP_SYSLOG, APPLE_RTKIT_EP_IOREPORT,
+					   APPLE_RTKIT_EP_OSLOG };
+	bool loader_order = of_machine_is_compatible("apple,t6050");
+	int count = loader_order ? ARRAY_SIZE(t6050_order) : APPLE_RTKIT_APP_ENDPOINT_START;
+	int i, oi, ep, ret;
 	u64 reply;
 	unsigned long bitmap = FIELD_GET(APPLE_RTKIT_MGMT_EPMAP_BITMAP, msg);
 	u32 base = FIELD_GET(APPLE_RTKIT_MGMT_EPMAP_BASE, msg);
@@ -230,7 +236,10 @@ static void apple_rtkit_management_rx_epmap(struct apple_rtkit *rtk, u64 msg)
 	if (!(msg & APPLE_RTKIT_MGMT_EPMAP_LAST))
 		return;
 
-	for_each_set_bit(ep, rtk->endpoints, APPLE_RTKIT_APP_ENDPOINT_START) {
+	for (oi = 0; oi < count; oi++) {
+		ep = loader_order ? t6050_order[oi] : oi;
+		if (!test_bit(ep, rtk->endpoints))
+			continue;
 		switch (ep) {
 		/* the management endpoint is started by default */
 		case APPLE_RTKIT_EP_MGMT:
@@ -756,7 +765,8 @@ static void apple_rtkit_oslog_rx(struct apple_rtkit *rtk, u64 msg)
 	/* Preserve the tested Neo/M5 and synchronous-log no-ACK policy. */
 	if (type == APPLE_RTKIT_OSLOG_LOG &&
 	    (rtk->sync_syslog_ack || of_machine_is_compatible("apple,t8140") ||
-	     of_machine_is_compatible("apple,t8142"))) {
+	     of_machine_is_compatible("apple,t8142") ||
+	     of_machine_is_compatible("apple,t6050"))) {
 		dev_dbg(rtk->dev, "RTKit: oslog notification: %016llx\n", msg);
 		return;
 	}
@@ -1313,6 +1323,18 @@ static int apple_rtkit_set_ap_power_state(struct apple_rtkit *rtk,
 	if (ret)
 		return ret;
 
+	/*
+	 * T6050: the loader never waits for this acknowledgment, and not every
+	 * coprocessor sends it. Give it a short window so a caller that starts an
+	 * endpoint right away (macsmc) sees the AP state; carry on without it.
+	 */
+	if (of_machine_is_compatible("apple,t6050")) {
+		if (!wait_for_completion_timeout(&rtk->ap_pwr_ack_completion,
+						 msecs_to_jiffies(200)))
+			dev_dbg(rtk->dev, "RTKit: no AP power state ACK\n");
+		return 0;
+	}
+
 	ret = apple_rtkit_wait(rtk, &rtk->ap_pwr_ack_completion);
 	if (ret)
 		return ret;
@@ -1379,6 +1401,28 @@ static int apple_rtkit_boot_common(struct apple_rtkit *rtk, bool early_ap_power)
 		return ret;
 	}
 
+	/*
+	 * T6050: the loader only proceeds once the IOP reports ON, and
+	 * intermediate states can be acknowledged first. Wait for ON here too.
+	 */
+	if (of_machine_is_compatible("apple,t6050")) {
+		int tries = 10;
+
+		while ((rtk->iop_power_state & 0xff) != APPLE_RTKIT_PWR_STATE_ON && tries--) {
+			dev_dbg(rtk->dev, "RTKit: IOP power state 0x%x, waiting for ON\n",
+				rtk->iop_power_state);
+			reinit_completion(&rtk->iop_pwr_ack_completion);
+			if ((rtk->iop_power_state & 0xff) == APPLE_RTKIT_PWR_STATE_ON)
+				break;
+			ret = apple_rtkit_wait(rtk, &rtk->iop_pwr_ack_completion);
+			if (ret) {
+				dev_err(rtk->dev, "RTKit: IOP never reached ON (state 0x%x): %d\n",
+					rtk->iop_power_state, ret);
+				return ret;
+			}
+		}
+	}
+
 	return early_ap_power ? 0 :
 		apple_rtkit_set_ap_power_state(rtk, APPLE_RTKIT_PWR_STATE_ON);
 }

From 042c45ae0548175941d44e9e2e99ef310b43c5b6 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 01:58:28 +0100
Subject: [PATCH 04/24] nvme: apple: Add T6050

The T6050 ANS2 takes the T8140 queue setup with three differences, all
behind a new keep_cc_fields flag in its hardware description:

- the boot loader hands the controller over disabled while the RTKit
  session stays live, so an enabled CC with no fatal status is enough
  to adopt it;
- the controller reports ready only when CC keeps the entry-size fields
  the firmware set (IOSQES 7, 128-byte entries), so the enable keeps
  them instead of composing CC in nvme_enable_ctrl();
- the admin queue uses the full queue depth, the linear submission
  queue enable is ORed into the register, and the NVMMU TCB bases, ASQ,
  ACQ and AQA are written in the loader's order.

Match "apple,t6050-nvme-ans2".

Tested on J714c (MacBook Pro 14-inch, M5 Max) in the bring-up tree these
changes come from: the internal SSD holds the Omarchy root file system.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/nvme/host/apple.c | 92 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 81 insertions(+), 11 deletions(-)

diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index d3ef47fa840e49..c2921f1070d6a0 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -198,6 +198,8 @@ struct apple_nvme_hw {
 	bool has_queue_count;
 	bool has_separate_nvmmu;
 	bool needs_ioq_registers;
+	/* Enable with the firmware's CC fields (128-byte SQ entries) instead of the core's. */
+	bool keep_cc_fields;
 	u32 max_queue_depth;
 	unsigned long quirks;
 };
@@ -343,6 +345,13 @@ static bool apple_nvme_can_adopt_rtkit(struct apple_nvme *anv)
 	 * and ready identifies a live session. Borrowed buffers still require
 	 * reserved RAM and protected SART ranges.
 	 */
+	/*
+	 * T6050: the loader hands over the controller disabled with the RTKit
+	 * session live (it cannot be restarted after a stop). Adopt on RUN and
+	 * BOOT_STATUS alone there; the enable below starts the controller.
+	 */
+	if (anv->hw->keep_cc_fields && (cc & NVME_CC_ENABLE))
+		return !(csts & NVME_CSTS_CFS);
 	return (cc & NVME_CC_ENABLE) && (csts & NVME_CSTS_RDY) &&
 	       !(csts & NVME_CSTS_CFS);
 }
@@ -360,7 +369,8 @@ static unsigned int apple_nvme_queue_depth(struct apple_nvme_queue *q)
 	struct apple_nvme *anv = queue_to_apple_nvme(q);
 
 	if (q->is_adminq)
-		return APPLE_NVME_AQ_DEPTH;
+		return anv->hw->keep_cc_fields ? anv->hw->max_queue_depth :
+						  APPLE_NVME_AQ_DEPTH;
 
 	return anv->hw->max_queue_depth;
 }
@@ -1535,6 +1545,31 @@ static void apple_nvme_wait_freeze(struct apple_nvme *anv)
 	}
 }
 
+/*
+ * T6050: the controller only reports ready when CC keeps the entry-size fields
+ * the firmware set (IOSQES 7, 128-byte entries), as the loader does. The core's
+ * nvme_enable_ctrl composes CC with the standard IOSQES 6.
+ */
+static int apple_nvme_enable_ctrl_keep_cc(struct apple_nvme *anv)
+{
+	u32 cc, csts, timeout_ms;
+
+	anv->ctrl.cap = readq(anv->mmio_nvme + NVME_REG_CAP);
+	cc = readl(anv->mmio_nvme + NVME_REG_CC);
+	cc &= ~(NVME_CC_SHN_MASK | NVME_CC_ENABLE);
+	cc |= NVME_CC_ENABLE;
+	anv->ctrl.ctrl_config = cc;
+	writel(cc, anv->mmio_nvme + NVME_REG_CC);
+	timeout_ms = clamp_t(u32, (NVME_CAP_TIMEOUT(anv->ctrl.cap) + 1) * 500, 1000, 10000);
+	if (readl_poll_timeout(anv->mmio_nvme + NVME_REG_CSTS, csts,
+			       csts & NVME_CSTS_RDY, 100, timeout_ms * 1000)) {
+		dev_err(anv->dev, "controller not ready after enable, CC=%#x CSTS=%#x\n",
+			readl(anv->mmio_nvme + NVME_REG_CC), readl(anv->mmio_nvme + NVME_REG_CSTS));
+		return -ENODEV;
+	}
+	return 0;
+}
+
 static void apple_nvme_reset_work(struct work_struct *work)
 {
 	unsigned int nr_io_queues = 1;
@@ -1710,8 +1745,13 @@ static void apple_nvme_reset_work(struct work_struct *work)
 		 * Enable NVMMU and linear submission queues which is required
 		 * since T6000.
 		 */
-		writel(APPLE_ANS_LINEAR_SQ_EN,
-			anv->mmio_nvme + APPLE_ANS_LINEAR_SQ_CTRL);
+		if (anv->hw->keep_cc_fields)
+			writel(readl(anv->mmio_nvme + APPLE_ANS_LINEAR_SQ_CTRL) |
+			       APPLE_ANS_LINEAR_SQ_EN,
+			       anv->mmio_nvme + APPLE_ANS_LINEAR_SQ_CTRL);
+		else
+			writel(APPLE_ANS_LINEAR_SQ_EN,
+			       anv->mmio_nvme + APPLE_ANS_LINEAR_SQ_CTRL);
 		if (anv->hw->needs_ioq_registers) {
 			u32 lsq_ctrl = readl(anv->mmio_nvme +
 					     APPLE_ANS_LINEAR_SQ_CTRL);
@@ -1750,15 +1790,28 @@ static void apple_nvme_reset_work(struct work_struct *work)
 	}
 
 	/* Setup the admin queue */
-	aqa = APPLE_NVME_AQ_DEPTH - 1;
+	aqa = apple_nvme_queue_depth(&anv->adminq) - 1;
 	aqa |= aqa << 16;
-	writel(aqa, anv->mmio_nvme + NVME_REG_AQA);
-	apple_nvme_writeq(anv, anv->adminq.sq_dma_addr,
-			  anv->mmio_nvme + NVME_REG_ASQ);
-	apple_nvme_writeq(anv, anv->adminq.cq_dma_addr,
-			  anv->mmio_nvme + NVME_REG_ACQ);
+	if (anv->hw->keep_cc_fields) {
+		/* T6050: the loader's order, NVMMU TCB bases, ASQ, ACQ, then AQA. */
+		apple_nvme_writeq(anv, anv->adminq.tcb_dma_addr,
+				  anv->mmio_nvmmu + APPLE_NVMMU_ASQ_TCB_BASE);
+		apple_nvme_writeq(anv, anv->ioq.tcb_dma_addr,
+				  anv->mmio_nvmmu + APPLE_NVMMU_IOSQ_TCB_BASE);
+		apple_nvme_writeq(anv, anv->adminq.sq_dma_addr,
+				  anv->mmio_nvme + NVME_REG_ASQ);
+		apple_nvme_writeq(anv, anv->adminq.cq_dma_addr,
+				  anv->mmio_nvme + NVME_REG_ACQ);
+		writel(aqa, anv->mmio_nvme + NVME_REG_AQA);
+	} else {
+		writel(aqa, anv->mmio_nvme + NVME_REG_AQA);
+		apple_nvme_writeq(anv, anv->adminq.sq_dma_addr,
+				  anv->mmio_nvme + NVME_REG_ASQ);
+		apple_nvme_writeq(anv, anv->adminq.cq_dma_addr,
+				  anv->mmio_nvme + NVME_REG_ACQ);
+	}
 
-	if (anv->hw->has_lsq_nvmmu) {
+	if (anv->hw->has_lsq_nvmmu && !anv->hw->keep_cc_fields) {
 		/* Setup NVMMU for both queues */
 		apple_nvme_writeq(anv, anv->adminq.tcb_dma_addr,
 				  anv->mmio_nvmmu + APPLE_NVMMU_ASQ_TCB_BASE);
@@ -1771,7 +1824,8 @@ static void apple_nvme_reset_work(struct work_struct *work)
 	anv->ctrl.cap = readq(anv->mmio_nvme + NVME_REG_CAP);
 
 	dev_dbg(anv->dev, "Enabling controller now");
-	ret = nvme_enable_ctrl(&anv->ctrl);
+	ret = anv->hw->keep_cc_fields ? apple_nvme_enable_ctrl_keep_cc(anv) :
+					 nvme_enable_ctrl(&anv->ctrl);
 	if (ret)
 		goto out;
 
@@ -2642,11 +2696,27 @@ static const struct apple_nvme_hw apple_nvme_t8140_hw = {
 	.quirks = NVME_QUIRK_BROKEN_FUA,
 };
 
+/* T6050: T8140 queue setup, with the CC fields the firmware sets. */
+static const struct apple_nvme_hw apple_nvme_t6050_hw = {
+	.has_lsq_nvmmu = true,
+	.has_separate_nvmmu = true,
+	.needs_ioq_registers = true,
+	.max_queue_depth = 64,
+	/*
+	 * An fsynced overwrite completed and later reverted after an abrupt
+	 * reset; explicit flushes persisted the preceding data. Let the block
+	 * layer follow each FUA write with a flush.
+	 */
+	.quirks = NVME_QUIRK_BROKEN_FUA,
+	.keep_cc_fields = true,
+};
+
 static const struct of_device_id apple_nvme_of_match[] = {
 	{ .compatible = "apple,t8015-nvme-ans2", .data = &apple_nvme_t8015_hw },
 	{ .compatible = "apple,t8103-nvme-ans2", .data = &apple_nvme_t8103_hw },
 	{ .compatible = "apple,t8132-nvme-ans2", .data = &apple_nvme_t8132_hw },
 	{ .compatible = "apple,t8140-nvme-ans2", .data = &apple_nvme_t8140_hw },
+	{ .compatible = "apple,t6050-nvme-ans2", .data = &apple_nvme_t6050_hw },
 	{ .compatible = "apple,nvme-ans2", .data = &apple_nvme_t8103_hw },
 	{},
 };

From 349418ae96a486ab7464b9d77f9e53356a4328c4 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 02:17:20 +0100
Subject: [PATCH 05/24] soc: apple: rtkit-helper: Wake the T6050 MTP with early
 AP power

The T6050 MTP firmware, like T8142's, waits for the AP power state
before it acknowledges its own power state. Wake "apple,t6050-mtp" with
apple_rtkit_wake_early_ap() as "apple,t8142-mtp" is.

Tested on J714c (MacBook Pro 14-inch, M5 Max) in the bring-up tree
these changes come from: the MTP boots and the keyboard and trackpad
work.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soc/apple/rtkit-helper.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/rtkit-helper.c b/drivers/soc/apple/rtkit-helper.c
index 5f03bed772f264..d5d2b473219f21 100644
--- a/drivers/soc/apple/rtkit-helper.c
+++ b/drivers/soc/apple/rtkit-helper.c
@@ -169,7 +169,8 @@ static int apple_rtkit_helper_probe(struct platform_device *pdev)
 		       helper->asc_base + APPLE_ASC_CPU_CONTROL);
 
 	/* Works for both wake and boot */
-	if (of_device_is_compatible(dev->of_node, "apple,t8142-mtp"))
+	if (of_device_is_compatible(dev->of_node, "apple,t8142-mtp") ||
+	    of_device_is_compatible(dev->of_node, "apple,t6050-mtp"))
 		ret = apple_rtkit_wake_early_ap(helper->rtk);
 	else
 		ret = apple_rtkit_wake(helper->rtk);

From 7f9197156f4ce49d61b7b81ac6c5224bb7349e18 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 02:21:10 +0100
Subject: [PATCH 06/24] power: supply: macsmc-power: Initialise work items
 before the notifier

Probe initialised critical_work twice: once through
devm_work_autocancel() and again, with dbg_log_work, after
blocking_notifier_chain_register(). An SMC critical-battery event
arriving between the two would have its queued work re-initialised
under the workqueue. Initialise both before the notifier is registered
and drop the second INIT_WORK().

Link: https://github.com/rolotrealanis98/m5pro-linux/blob/main/contrib/pending/smc/patches/linux/0011-power-supply-macsmc-power-init-work-before-notifier.patch
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
---
 drivers/power/supply/macsmc-power.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index aec59fe13483c4..9e8388f9a824b4 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -1000,11 +1000,18 @@ static int macsmc_power_probe(struct platform_device *pdev)
 		return ret;
 	dev_set_drvdata(dev, power);
 
-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
+	/* devm_work_autocancel() initialises critical_work */
 	ret = devm_work_autocancel(dev, &power->critical_work, macsmc_power_critical_work);
 	if (ret)
 		return ret;
 
+	/*
+	 * Must be ready before the notifier is registered below: an SMC event
+	 * can arrive as soon as it is, and re-initialising a work item that
+	 * is already queued corrupts the workqueue.
+	 */
+	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
+
 	/*
 	 * Check for battery presence.
 	 * B0AV is a fundamental key.
@@ -1209,9 +1216,6 @@ static int macsmc_power_probe(struct platform_device *pdev)
 	power->nb.notifier_call = macsmc_power_event;
 	blocking_notifier_chain_register(&smc->event_handlers, &power->nb);
 
-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
-	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
-
 	g_power = power;
 
 	if (log_power)

From c715e329c24de23a9ea883262b65025de841bf04 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 02:31:29 +0100
Subject: [PATCH 07/24] drm/sysfb: simpledrm: Report an Apple built-in panel as
 eDP

Before its display coprocessor driver runs, a built-in Apple panel is a
simpledrm framebuffer whose connector is Unknown-1. Omarchy treats every
connector that is not eDP, LVDS or DSI as an external monitor, so
closing the lid kept the session in clamshell mode instead of locking
it. Give a framebuffer node with apple,internal-panel an eDP connector.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/sysfb/simpledrm.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sysfb/simpledrm.c b/drivers/gpu/drm/sysfb/simpledrm.c
index bb32b258a9b5f8..27208f700de457 100644
--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -839,8 +839,10 @@ static struct simpledrm_device *simpledrm_device_create(struct drm_driver *drv,
 	/* Connector */
 
 	connector = &sdev->connector;
+	/* A built-in laptop panel the loader hands over (Apple, before DCP). */
 	ret = drm_connector_init(dev, connector, &simpledrm_connector_funcs,
-				 DRM_MODE_CONNECTOR_Unknown);
+				 of_property_read_bool(dev->dev->of_node, "apple,internal-panel") ?
+				 DRM_MODE_CONNECTOR_eDP : DRM_MODE_CONNECTOR_Unknown);
 	if (ret)
 		return ERR_PTR(ret);
 	drm_connector_helper_add(connector, &simpledrm_connector_helper_funcs);

From 85ecd605c5a3235c057dba0d0ebe1f90a80f326b Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 02:44:12 +0100
Subject: [PATCH 08/24] dt-bindings: apple: Add T6050 and J714c

Add the T6050 (M5 Max) SoC and the MacBook Pro (14-inch, M5 Max) board
to the Apple platform binding, and the T6050 compatibles to the bindings
of the blocks its device tree describes: PMGR and its power states, ASC
mailbox, cluster cpufreq, I2C, DART, AICv3, watchdog, FPWM, GPIO, ANS2
NVMe, SART, SPMI, the abbey PMIC NVMEM, SMC, MTP and DockChannel. Its
CPU cores are "apple,sotra".

Where the device tree keeps an intermediate fallback the drivers match
(the MTP DART and AIC on T8142, the GPIO block and NVMe on T8140), the
binding lists the T6050 chain as it is. The T6050 NVMe controller has
the NVMMU region of T8132 and a fourth power domain, the PCIe lane PHY
of its storage link.

simple-framebuffer gains apple,internal-panel, which marks a framebuffer
as an Apple laptop's built-in panel.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
