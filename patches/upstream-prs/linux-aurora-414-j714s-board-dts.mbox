diff --git a/arch/arm64/boot/dts/apple/t6050-smc.dtsi b/arch/arm64/boot/dts/apple/t6050-smc.dtsi
new file mode 100644
index 00000000000000..eb1b94b01a1414
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-smc.dtsi
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T6050 SMC (System Management Controller) and the SPMI PMIC NVMEM cells
+ * its reboot and RTC children need, from the J714c ADT. Based on
+ * omarchy-m5's dt/t6050-smc.dtsi (github.com/betizzel/omarchy-m5); the
+ * structure follows t6031-die0.dtsi and t8122.dtsi.
+ *
+ * Board files add hwmon sensors (hwmon-*.dtsi) on top of &smc_hwmon. The
+ * T6050 SMC has no F0Md/F1Md: its fan mode keys are F0md/F1md (ui8,
+ * writable), so every T6050 board overrides apple,fan-mode after including
+ * hwmon-fan*.dtsi.
+ */
+
+#include <dt-bindings/spmi/spmi.h>
+
+&soc {
+	// ADT /arm-io/nub-spmi0: compatible "aapl,spmi", gen = 4,
+	// reg[0] = 0x8a014000 (-> 0x28a014000), ADT size 0x4000. The full
+	// ADT size is used: the gen 4 FIFO registers below sit at 0x200-0x220,
+	// outside the 0x100 window t6031 maps for its gen 1 layout (a 0x100
+	// resource only worked because ioremap maps a whole 16K page).
+	// interrupts = [256, 726, 281, ...]: 256 is the controller-internal
+	// SPMI_IRQ_NOTIFY hwirq (identical in all five SPMI nodes), 726 is the
+	// AIC line (same index convention as wdt: ADT interrupts[0] = 721).
+	// This is a gen 4 controller (ADT "gen" = 4): STATUS/CMD/REPLY sit at
+	// 0x200/0x210/0x220 and RX-empty is bit 30 (as in m1n1). The
+	// gen 1 layout (t8103) does not apply, so there is no fallback
+	// compatible. Linux runs gen 4 polled: its IRQ registers are
+	// undocumented.
+	//
+	// No power-domains: the ADT node has no power-gates, and ps_nub_spmi0
+	// (pmgr 0x120, boot value 0x1400024f = auto-PM + clock-gated) is
+	// apple,always-on in t6050-pmgr.dtsi.  t6031's equivalent node also has
+	// none.  Referencing it would only add a genpd dependency.
+	nub_spmi0: spmi@28a014000 {
+		/* Polled: this tree's gen 4 SPMI driver has no interrupt support. */
+		compatible = "apple,t6050-spmi", "apple,t8142-spmi";
+		reg = <0x2 0x8a014000 0x0 0x4000>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		// ADT /arm-io/nub-spmi0/spmi-abbeyL1: compatible
+		// "pmu,spmi","pmu,abbey", reg[0] = 0xe -> USID 14, is-primary.
+		// (spmi-mosquitoM0 = USID 9, btm = USID 0xb on the same bus.)
+		//
+		// Cell offsets are the Asahi "chapel" layout (t6031-die0.dtsi);
+		// the ADT abbey properties confirm the ones it lists:
+		//   info-pm_setting      = 0x2001
+		//   info-clock_offset    = {0x2100, 6}   (info-rtc_scrpad
+		//   0x2100)
+		//   info-fault_shadow    = {0x867b, 0x10}
+		//   info-scrpad_socd     = {0x8b00, 0x1800}
+		//   info-leg_scrpad      = 0xf800  -> boot_stage 0xf801 etc.
+		//   are
+		//                          base+1/+2/+3/+0xf as on chapel/stowe
+		//                          (the +N offsets are not in the ADT)
+		pmic1: pmic@e {
+			compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
+			reg = <0xe SPMI_USID>;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				pm_setting: pm-setting@2001 {
+					reg = <0x2001 0x1>;
+				};
+
+				rtc_offset: rtc-offset@2100 {
+					reg = <0x2100 0x6>;
+				};
+
+				fault_shadow: fault-shadow@867b {
+					reg = <0x867b 0x10>;
+				};
+
+				socd: socd@8b00 {
+					reg = <0x8b00 0x1800>;
+				};
+
+				boot_stage: boot-stage@f801 {
+					reg = <0xf801 0x1>;
+				};
+
+				boot_error_count: boot-error-count@f802,0 {
+					reg = <0xf802 0x1>;
+					bits = <0 4>;
+				};
+
+				panic_count: panic-count@f802,4 {
+					reg = <0xf802 0x1>;
+					bits = <4 4>;
+				};
+
+				boot_error_stage: boot-error-stage@f803 {
+					reg = <0xf803 0x1>;
+				};
+
+				shutdown_flag: shutdown-flag@f80f,3 {
+					reg = <0xf80f 0x1>;
+					bits = <3 1>;
+				};
+			};
+		};
+	};
+
+	// "smc" reg: ASC wrapper (driver does not map it; only index 1 is
+	// ioremapped).  "sram" reg: ADT iop-smc-nub region-base = 0x28de00000,
+	// region-size = 0x140000 (Asahi uses 0x100000 on M1-M4; the T6050
+	// firmware region is 0x140000, and the driver rejects any shmem buffer
+	// outside this window). smc_gpio is deliberately defined here although
+	// nothing consumes it yet.
+	smc: smc@28c600000 {
+		compatible = "apple,t6050-smc", "apple,t8103-smc";
+		reg = <0x2 0x8c600000 0x0 0x4000>,
+		      <0x2 0x8de00000 0x0 0x140000>;
+		reg-names = "smc", "sram";
+		mboxes = <&smc_mbox>;
+
+		smc_gpio: gpio {
+			compatible = "apple,smc-gpio";
+			#gpio-cells = <2>;
+			gpio-controller;
+		};
+
+		smc_hwmon: hwmon {
+			compatible = "apple,smc-hwmon";
+		};
+
+		// Registers SYS_OFF_PRIO_HIGH (192) restart + power-off
+		// handlers; the apple,t6050-wdt restart handler is priority
+		// 128 (apple_wdt.c), so once this probes,
+		// `reboot` goes through SMC 'phra' instead of the wdt.
+		// Kept disabled until an SMC 'phra' restart is shown to land
+		// in stage-1 m1n1 like the wdt reset does (remote reboots
+		// depend on that). It also writes boot_stage/shutdown_flag in
+		// the PMIC scratchpad, whose offsets are not yet verified.
+		smc_reboot: reboot {
+			compatible = "apple,smc-reboot";
+			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+				      <&boot_error_count>, <&panic_count>;
+			nvmem-cell-names = "shutdown_flag", "boot_stage",
+					   "boot_error_count", "panic_count";
+
+			status = "disabled";
+		};
+
+		smc_rtc: rtc {
+			compatible = "apple,smc-rtc";
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+		};
+	};
+
+	// ADT /arm-io/smc: compatible "iop,ascwrap-v6" (same as ans/mtp),
+	// reg[0] = 0x8c600000 (ASC wrapper, size 0x88000), mailbox at
+	// reg[0] + 0x8000 exactly like ans_mbox/mtp_mbox (as in m1n1),
+	// interrupts = [900, 899, 902, 901] = [n+1, n, n+3, n+2] with n = 899,
+	// so send-empty = 899 ... recv-not-empty = 902 (same reordering as
+	// ANS 1348,1347,1350,1349 -> 1347..1350 and MTP 677,676,679,678).
+	// No power-gates / clock-gates in the ADT node -> no power-domains.
+	smc_mbox: mbox@28c608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x8c608000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 899 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 900 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 901 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 902 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050.dtsi b/arch/arm64/boot/dts/apple/t6050.dtsi
new file mode 100644
index 00000000000000..70ba4e4d37106d
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050.dtsi
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple T6050 "M5 Max" SoC
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+#include "t6050-base.dtsi"
+
+/ {
+	compatible = "apple,t6050", "apple,arm-platform";
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	soc: soc {
+		compatible = "simple-bus";
+		ranges;
+		#address-cells = <2>;
+		/* Required to get >32-bit DMA via DARTs */
+		dma-ranges = <0 0 0 0 0xffffffff 0xffffc000>;
+		nonposted-mmio;
+		#size-cells = <2>;
+	};
+};
+
+/* T6050 is a single die: no multi-die templating. */
+#include "t6050-die0.dtsi"
+#include "t6050-pmgr.dtsi"
+#include "t6050-nvme.dtsi"

From 29eab2785dd731f475c585b75f0a70a468e2d160 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:23:44 -0500
Subject: [PATCH 10/24] soc: apple: rtkit: Wait up to 10 s for a T6050 ANS
 handshake reply

apple_rtkit_wait_for_completion() gives the coprocessor 1 s to answer.
On the T6050 (J716s, MacBook Pro 16-inch M5 Pro) the ANS firmware that
iBoot hands over sometimes needs about 3 s to answer the power-state and
endpoint-map handshake. With 1 s, nvme-apple fails with "ANS did not
boot" / "Reset failure status: -62" and the root device never appears,
although a later rebind of the same firmware succeeds.

Make the handshake timeout a per-instance setting, set with
apple_rtkit_set_handshake_timeout() and defaulting to the current
1000 ms, and use it for every handshake wait, including the polled
apple,sync-syslog-ack path. nvme-apple asks for 10 s on the T6050 ANS
only, so a dead coprocessor on any other SoC is still reported after
1 s, and a T6050 ANS that answers in time is not slowed down. The
200 ms AP power ACK window on T6050 machines is not changed.

Tested on J716s (MacBook Pro 16-inch, M5 Pro) in the tree these changes
come from: the boot that failed with -62 after 1 s mounts the root on
the internal SSD with 10 s, on every boot since. On this tree:
compile-tested.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/nvme/host/apple.c          | 10 ++++++++++
 drivers/soc/apple/rtkit-internal.h |  2 ++
 drivers/soc/apple/rtkit.c          | 25 +++++++++++++++++++------
 include/linux/soc/apple/rtkit.h    | 12 ++++++++++++
 4 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index c2921f1070d6a0..2a3167c9fcc16e 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -43,6 +43,8 @@
 #include "nvme.h"
 
 #define APPLE_ANS_BOOT_TIMEOUT	  USEC_PER_SEC
+/* RTKit handshake timeout for the T6050 ANS, see apple_nvme_alloc() */
+#define APPLE_NVME_T6050_HANDSHAKE_TIMEOUT_MS 10000
 
 #define APPLE_ANS_COPROC_CPU_CONTROL	 0x44
 #define APPLE_ANS_COPROC_CPU_CONTROL_RUN BIT(4)
@@ -2442,6 +2444,14 @@ static struct apple_nvme *apple_nvme_alloc(struct platform_device *pdev)
 		goto out_detach_genpd;
 	}
 
+	/*
+	 * The T6050 ANS firmware handed over by iBoot can take about 3 s to
+	 * answer the power-state and endpoint-map handshake.
+	 */
+	if (of_device_is_compatible(dev->of_node, "apple,t6050-nvme-ans2"))
+		apple_rtkit_set_handshake_timeout(anv->rtk,
+						  APPLE_NVME_T6050_HANDSHAKE_TIMEOUT_MS);
+
 	ret = devm_add_action_or_reset(dev, apple_nvme_free_rtkit, anv);
 	if (ret)
 		goto out_detach_genpd;
diff --git a/drivers/soc/apple/rtkit-internal.h b/drivers/soc/apple/rtkit-internal.h
index 417d4550ef3aeb..856b78d81fcd9d 100644
--- a/drivers/soc/apple/rtkit-internal.h
+++ b/drivers/soc/apple/rtkit-internal.h
@@ -47,6 +47,8 @@ struct apple_rtkit {
 
 	int boot_result;
 	int version;
+	/* How long to wait for each handshake reply from the co-processor. */
+	unsigned int handshake_timeout_ms;
 
 	unsigned int iop_power_state;
 	unsigned int ap_power_state;
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index c37008e2d86e79..314fb8b4408153 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -104,6 +104,9 @@ enum {
 #define APPLE_RTKIT_MIN_SUPPORTED_VERSION 11
 #define APPLE_RTKIT_MAX_SUPPORTED_VERSION 12
 
+/* Default wait for each handshake reply, see apple_rtkit_set_handshake_timeout() */
+#define APPLE_RTKIT_HANDSHAKE_TIMEOUT_MS 1000
+
 struct apple_rtkit_rx_work {
 	struct apple_rtkit *rtk;
 	u8 ep;
@@ -1138,6 +1141,7 @@ static struct apple_rtkit *__apple_rtkit_init(struct device *dev, void *cookie,
 	rtk->dev = dev;
 	rtk->cookie = cookie;
 	rtk->ops = ops;
+	rtk->handshake_timeout_ms = APPLE_RTKIT_HANDSHAKE_TIMEOUT_MS;
 	rtk->sync_syslog_ack =
 		of_property_read_bool(dev->of_node, "apple,sync-syslog-ack");
 	INIT_KFIFO(rtk->sync_ack_fifo);
@@ -1208,7 +1212,8 @@ struct apple_rtkit *apple_rtkit_init_adopted(struct device *dev, void *cookie,
 }
 EXPORT_SYMBOL_GPL(apple_rtkit_init_adopted);
 
-static int apple_rtkit_wait_for_completion(struct completion *c);
+static int apple_rtkit_wait_for_completion(struct apple_rtkit *rtk,
+					   struct completion *c);
 
 /*
  * apple,sync-syslog-ack (AsahiLinux/linux#607): the mailbox can leave
@@ -1222,9 +1227,9 @@ static int apple_rtkit_wait(struct apple_rtkit *rtk, struct completion *c)
 	int ret;
 
 	if (!rtk->sync_syslog_ack)
-		return apple_rtkit_wait_for_completion(c);
+		return apple_rtkit_wait_for_completion(rtk, c);
 
-	timeout = jiffies + msecs_to_jiffies(1000);
+	timeout = jiffies + msecs_to_jiffies(rtk->handshake_timeout_ms);
 	do {
 		ret = apple_rtkit_poll(rtk);
 		if (ret < 0)
@@ -1242,12 +1247,13 @@ static int apple_rtkit_wait(struct apple_rtkit *rtk, struct completion *c)
 	return try_wait_for_completion(c) ? 0 : -ETIME;
 }
 
-static int apple_rtkit_wait_for_completion(struct completion *c)
+static int apple_rtkit_wait_for_completion(struct apple_rtkit *rtk,
+					   struct completion *c)
 {
+	unsigned long timeout = msecs_to_jiffies(rtk->handshake_timeout_ms);
 	long t;
 
-	t = wait_for_completion_interruptible_timeout(c,
-						      msecs_to_jiffies(1000));
+	t = wait_for_completion_interruptible_timeout(c, timeout);
 	if (t < 0)
 		return t;
 	else if (t == 0)
@@ -1256,6 +1262,13 @@ static int apple_rtkit_wait_for_completion(struct completion *c)
 		return 0;
 }
 
+void apple_rtkit_set_handshake_timeout(struct apple_rtkit *rtk,
+				       unsigned int timeout_ms)
+{
+	rtk->handshake_timeout_ms = timeout_ms ?: APPLE_RTKIT_HANDSHAKE_TIMEOUT_MS;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_set_handshake_timeout);
+
 int apple_rtkit_reinit(struct apple_rtkit *rtk)
 {
 	unsigned long flags;
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index 1ba27a92e2b144..a90ceb0de2757b 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -155,6 +155,18 @@ void apple_rtkit_free_retaining_buffers(struct apple_rtkit *rtk);
  */
 int apple_rtkit_reinit(struct apple_rtkit *rtk);
 
+/*
+ * Set how long each handshake step (power state and endpoint map replies)
+ * waits for the co-processor, for one that is known to answer slowly. Call
