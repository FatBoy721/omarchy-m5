From 35f6c2d35d0a123f6686632f93ebaecdd80d47f1 Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 18:45:04 +0100
Subject: [PATCH 16/24] arm64: apple: t6050-j714c: Power off and restart
 through the SMC

Power-off from Omarchy halted with the boot logo on screen: nothing
registered a power-off handler, so the kernel turned the request into a
halt. Enable the SMC reboot node and build its driver: power-off writes
MBSE = off1, and restart now goes through SMC phra ahead of the
watchdog.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
[Rolando: only the t6050-smc.dtsi part of commit 38e75c9f1c07 ("arm64:
 apple: t6050-j714c: Power off and restart through the SMC") in
 edimoldovan/linux-aurora; this tree has no j714c.config, and
 j716s.config builds POWER_RESET_MACSMC in]
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 arch/arm64/boot/dts/apple/t6050-smc.dtsi | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6050-smc.dtsi b/arch/arm64/boot/dts/apple/t6050-smc.dtsi
index eb1b94b01a1414..c38a76538d62a1 100644
--- a/arch/arm64/boot/dts/apple/t6050-smc.dtsi
+++ b/arch/arm64/boot/dts/apple/t6050-smc.dtsi
@@ -131,19 +131,14 @@
 		// Registers SYS_OFF_PRIO_HIGH (192) restart + power-off
 		// handlers; the apple,t6050-wdt restart handler is priority
 		// 128 (apple_wdt.c), so once this probes,
-		// `reboot` goes through SMC 'phra' instead of the wdt.
-		// Kept disabled until an SMC 'phra' restart is shown to land
-		// in stage-1 m1n1 like the wdt reset does (remote reboots
-		// depend on that). It also writes boot_stage/shutdown_flag in
-		// the PMIC scratchpad, whose offsets are not yet verified.
+		// `reboot` goes through SMC 'phra' instead of the wdt. The
+		// PMIC scratchpad cells it writes match t6031 (M3 Max).
 		smc_reboot: reboot {
 			compatible = "apple,smc-reboot";
 			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
 				      <&boot_error_count>, <&panic_count>;
 			nvmem-cell-names = "shutdown_flag", "boot_stage",
 					   "boot_error_count", "panic_count";
-
-			status = "disabled";
 		};
 
 		smc_rtc: rtc {

From 6769e7b51d983f0f00b061ac780b21ee4407c0d8 Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 20:21:42 +0100
Subject: [PATCH 17/24] arm64: dts: apple: t6050-j714c: drive the trackpad AFE
 reset line

Left to the MTP firmware (apple,firmware-managed-reset), the J714c's
trackpad AFE sometimes never answers its bootloader: the MTP logs
"AFE[0] Chip Boot Failure for HBPP: No HINT_L", the multi-touch
interface never reports ready, and every later start fails the same
way. It hit both disk boots and some proxy boots on Nov 7, on every
kernel build.

As on t8142-j813, give dockchannel-hid the AFE reset line instead. The
J714c ADT has multi-touch function-afe-reset = smc-pmu
pKW8('pcIO', 0x10000, 0x11c0000): SMC pcIO output 28 in the J700's
encoding, where level 1 asserts the reset. macsmc-gpio's J700 pcIO
lines become a per-machine table with a J714c entry for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

[Rolando: commit 768d807c3cf9 ("arm64: dts: apple: t6050-j714c: drive the
 trackpad AFE reset line") in edimoldovan/linux-aurora, on #404's
 t6050-j714c.dts, which still had apple,firmware-managed-reset and no
 gpio.h include; the original carries no Signed-off-by from its author]
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 arch/arm64/boot/dts/apple/t6050-j714c.dts |  9 ++-
 drivers/gpio/gpio-macsmc.c                | 90 ++++++++++++-----------
 2 files changed, 57 insertions(+), 42 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6050-j714c.dts b/arch/arm64/boot/dts/apple/t6050-j714c.dts
index 9b81215ba9c6f8..7f57833557d301 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714c.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714c.dts
@@ -13,6 +13,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/apple-aic.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/leds/common.h>
@@ -88,6 +89,13 @@
 };
 
 &mtp_hid {
+	/*
+	 * ADT multi-touch function-afe-reset = smc-pmu pKW8('pcIO', 0x10000,
+	 * 0x11c0000), SMC pcIO output 28; level 1 asserts the reset. Left to
+	 * the MTP firmware, the AFE sometimes never answers ("No HINT_L").
+	 */
+	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_HIGH>;
+
 	actuator {
 	};
 
@@ -98,7 +106,6 @@
 
 	mtp_mt: multi-touch {
 		firmware-name = "apple/tpmtfw-j714c.bin";
-		apple,firmware-managed-reset;
 		apple,power-method = <2>;
 	};
 
diff --git a/drivers/gpio/gpio-macsmc.c b/drivers/gpio/gpio-macsmc.c
index 424f19b1c4a5d0..7036186a185b8c 100644
--- a/drivers/gpio/gpio-macsmc.c
+++ b/drivers/gpio/gpio-macsmc.c
@@ -18,20 +18,31 @@
 #define MAX_GPIO 64
 
 /*
- * J700 resets its trackpad analog front end through the SMC "pcIO" key
- * rather than a gPxx GPIO key. The Apple device tree describes the reset as
- * the platform function pKW8("pcIO", 0x10000, 0x130000): an eight-byte write
- * with 0x10000 in the low word, 0x130000 in the high word and the requested
- * level in bits 15:0. Bits 23:16 of the high word hold the pin number.
+ * J700 and J714c reset their trackpad analog front end through the SMC
+ * "pcIO" key rather than a gPxx GPIO key. The Apple device tree describes the
+ * reset as a platform function such as pKW8("pcIO", 0x10000, 0x130000): an
+ * eight-byte write with 0x10000 in the low word, 0x130000 in the high word
+ * and the requested level in bits 15:0. Bits 23:16 of the high word hold the
+ * pin number.
  */
-#define MACSMC_J700_AFE_RESET_GPIO	19
-#define MACSMC_J700_AFE_RESET_LO	0x10000
-#define MACSMC_J700_AFE_RESET_HI	0x130000
+struct macsmc_pcio_line {
+	unsigned int gpio;
+	u32 lo, hi;
+};
 
-/* J700 amfm-sunrise function-reg_on: pKW8("pcIO", 0x800000, 0x80000). */
-#define MACSMC_J700_RADIO_REG_ON_GPIO	8
-#define MACSMC_J700_RADIO_REG_ON_LO	0x800000
-#define MACSMC_J700_RADIO_REG_ON_HI	0x80000
+static const struct macsmc_pcio_line macsmc_j700_pcio[] = {
+	/* multi-touch function-afe-reset */
+	{ 19, 0x10000, 0x130000 },
+	/* amfm-sunrise function-reg_on */
+	{ 8, 0x800000, 0x80000 },
+	{ }
+};
+
+static const struct macsmc_pcio_line macsmc_j714c_pcio[] = {
+	/* multi-touch function-afe-reset: pKW8("pcIO", 0x10000, 0x11c0000) */
+	{ 28, 0x10000, 0x11c0000 },
+	{ }
+};
 
 /*
  * Commands 0-6 are, presumably, the intended API.
@@ -94,16 +105,19 @@ struct macsmc_gpio {
 	int first_index;
 	smc_key base_key;
 
-	bool j700_pcio;
-	DECLARE_BITMAP(j700_pcio_level, MAX_GPIO);
+	const struct macsmc_pcio_line *pcio;
+	DECLARE_BITMAP(pcio_level, MAX_GPIO);
 };
 
-static bool macsmc_gpio_is_j700_pcio(struct macsmc_gpio *smcgp,
-				     unsigned int offset)
+static const struct macsmc_pcio_line *macsmc_gpio_pcio(struct macsmc_gpio *smcgp,
+						       unsigned int offset)
 {
-	return smcgp->j700_pcio &&
-	       (offset == MACSMC_J700_AFE_RESET_GPIO ||
-		offset == MACSMC_J700_RADIO_REG_ON_GPIO);
+	const struct macsmc_pcio_line *line;
