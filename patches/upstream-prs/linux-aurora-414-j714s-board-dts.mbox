+void apple_rtkit_set_handshake_timeout(struct apple_rtkit *rtk,
+				       unsigned int timeout_ms);
+
 /*
  * Handle RTKit's boot process. Should be called after the CPU of the
  * co-processor has been started.

From 41ce7f1b850ff147a1d2fc2592798c2199eed05a Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:24:17 -0500
Subject: [PATCH 11/24] hwmon: (macsmc) Keep a fan whose optional keys are
 missing

macsmc_hwmon_create_fan() returns an error, dropping the whole fan, when
any of apple,fan-minimum/-maximum/-target/-mode names a key the SMC does
not have. The T6050 SMC spells the mode keys F0md and F1md instead of
F0Md and F1Md, so a T6050 board that includes hwmon-fan-dual.dtsi and
misses the override loses both fans, although their speed keys are
there.

Treat the optional keys as optional: drop only that attribute, report
the missing keys in one info-level line per fan, and clear the mode key,
which disables manual control (fan_control), unless the minimum, maximum
and target keys exist as well: the write path reads the first two before
it writes the third.

The missing-key path has not run on hardware: the J716s device tree has
the override, and with it both fans report their speed, minimum
(1350 rpm) and maximum (5349 and 5777 rpm) in the tree these changes
come from, as without this change. On this tree: compile-tested.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/hwmon/macsmc-hwmon.c | 57 ++++++++++++++++++++++++------------
 1 file changed, 38 insertions(+), 19 deletions(-)

diff --git a/drivers/hwmon/macsmc-hwmon.c b/drivers/hwmon/macsmc-hwmon.c
index 7e0a2312d2d292..d545ad53d17a6d 100644
--- a/drivers/hwmon/macsmc-hwmon.c
+++ b/drivers/hwmon/macsmc-hwmon.c
@@ -865,6 +865,8 @@ static int macsmc_hwmon_create_fan(struct device *dev, struct apple_smc *smc,
 				   struct macsmc_hwmon_fan *fan)
 {
 	const char *label, *now, *min, *max, *set, *mode;
+	char missing[64] = "";
+	int len = 0;
 	int ret;
 
 	ret = of_property_read_string(fan_node, "apple,key-id", &now);
@@ -887,37 +889,54 @@ static int macsmc_hwmon_create_fan(struct device *dev, struct apple_smc *smc,
 		fan->attrs |= HWMON_F_LABEL;
 	}
 
-	/* The following keys are not required to simply monitor fan speed */
+	/*
+	 * The following keys are not required to simply monitor fan speed.
+	 * A key the firmware lacks (the T6050 SMC spells the mode key F0md,
+	 * not F0Md) drops only that attribute, not the whole fan; the missing
+	 * keys are reported together below.
+	 */
 	if (!of_property_read_string(fan_node, "apple,fan-minimum", &min)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->min, min);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_MIN;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->min, min))
+			len += scnprintf(missing + len, sizeof(missing) - len,
+					 " minimum %s", min);
+		else
+			fan->attrs |= HWMON_F_MIN;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-maximum", &max)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->max, max);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_MAX;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->max, max))
+			len += scnprintf(missing + len, sizeof(missing) - len,
+					 " maximum %s", max);
+		else
+			fan->attrs |= HWMON_F_MAX;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-target", &set)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->set, set);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_TARGET;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->set, set))
+			len += scnprintf(missing + len, sizeof(missing) - len,
+					 " target %s", set);
+		else
+			fan->attrs |= HWMON_F_TARGET;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-mode", &mode)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode);
-		if (ret)
-			return ret;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode))
+			len += scnprintf(missing + len, sizeof(missing) - len,
+					 " mode %s", mode);
 	}
 
+	if (len)
+		dev_info(dev, "Fan %s: optional keys not found:%s\n", now, missing);
+
+	/*
+	 * Manual control (fan_control) writes the mode key and checks the
+	 * request against the minimum and maximum keys before writing the
+	 * target: it needs all four.
+	 */
+	if ((fan->attrs & (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET)) !=
+	    (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET))
+		fan->mode.macsmc_key = 0;
+
 	/* Initialise fan control mode to automatic */
 	fan->manual = false;
 

From 54a8e95eb340c50d1f75e7ed8a3e620e1e73d0ef Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:25:18 -0500
Subject: [PATCH 12/24] arm64: idle: T6050 idles in WFI even with idle=nop

m1n1 appends "idle=nop arm64.nowfxt" to the command line on every chip
whose Apple system registers are locked (M4 and later, T8140 aside), for
kernels that do not preserve the state WFI loses there. It appends them
after the user's arguments, so an idle= on the command line cannot
override it. This kernel preserves that state (apple_wfi_quirk_init()),
and idreg-override forces WFxT off on M4 and later, so on T6050
idle=nop only makes every idle CPU spin: cpuidle's WFI state calls
cpu_do_idle(), which does nothing with idle=nop.

Keep WFI as the idle method on T6050 (MIDR parts 0x064 and 0x065, added
to cputype.h). The switch is made in apple_wfi_quirk_init(), after the
register-saving key is enabled and before the secondary CPUs start; the
boot CPU spins until then, as it does today. Other chips are not
changed. This relies on idle=nop being in effect until that
early_initcall: a loader that does not append it would let the boot
CPU idle in WFI before the registers are saved, which is not changed
here.

Add apple_keep_idle_nop to keep idle=nop for comparisons and as a
fallback that needs no new kernel.

Tested on J716s (MacBook Pro 16-inch, M5 Pro) in the tree these changes
come from: the system draws 9.8 W at idle on the charger instead of
16.4 W (SMC total system power), and a 56-minute idle soak with an FP
consistency check on all 18 CPUs and four s2idle steps up to a real
suspend/resume passed. On the 14-inch M5 Pro (J714s), betizzel measured
5.6 W against 15.3 W, and a per-CPU register check passed 250,000 1 ms
sleeps on each of its 15 CPUs. On this tree: compile-tested.

Link: https://github.com/betizzel/omarchy-m5/commit/a5df9e4df61b60dd6195e13a2a3a043d76b92c0f
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 .../admin-guide/kernel-parameters.txt         |  7 +++++
 arch/arm64/include/asm/cputype.h              |  4 +++
 arch/arm64/kernel/idle.c                      | 26 +++++++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index c5e4ab0ba915f0..a0a655039415f0 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -549,6 +549,13 @@ Kernel parameters
 	apm=		[APM] Advanced Power Management
 			See header of arch/x86/kernel/apm_32.c.
 
+	apple_keep_idle_nop
+			[ARM64,EARLY] On T6050, keep idle=nop. These cores
+			idle in WFI by default, and an idle=nop that the boot
+			loader appends is ignored, because the kernel
+			preserves the registers WFI loses there. With this
+			flag idle=nop spins the idle loop as elsewhere.
+
 	apparmor=	[APPARMOR] Disable or enable AppArmor at boot time
 			Format: { "0" | "1" }
 			See security/apparmor/Kconfig help text
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index 4a3fd1fabeecd1..2bbac91357582c 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -158,6 +158,8 @@
 #define APPLE_CPU_PART_TAHITI_P		0x061
 #define APPLE_CPU_PART_T8142_E		0x062
 #define APPLE_CPU_PART_T8142_P		0x063
+#define APPLE_CPU_PART_T6050_M		0x064
+#define APPLE_CPU_PART_T6050_P		0x065
 #define APPLE_CPU_PART_T8152_E		0x072
 #define APPLE_CPU_PART_T8152_P		0x073
 
@@ -257,6 +259,8 @@
 #define MIDR_APPLE_TAHITI_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_TAHITI_P)
 #define MIDR_APPLE_T8142_E MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8142_E)
 #define MIDR_APPLE_T8142_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8142_P)
+#define MIDR_APPLE_T6050_M MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T6050_M)
+#define MIDR_APPLE_T6050_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T6050_P)
 #define MIDR_APPLE_T8152_E MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8152_E)
 #define MIDR_APPLE_T8152_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8152_P)
 #define MIDR_AMPERE1 MIDR_CPU_MODEL(ARM_CPU_IMP_AMPERE, AMPERE_CPU_PART_AMPERE1)
diff --git a/arch/arm64/kernel/idle.c b/arch/arm64/kernel/idle.c
index f632551030d118..4478bb6f89bb3c 100644
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -46,13 +46,39 @@ early_param("idle", setup_idle);
  * patched-out branch.
  */
 static DEFINE_STATIC_KEY_FALSE(apple_wfi_loses_regs);
+static bool apple_keep_idle_nop __initdata;
+
+/*
+ * The boot loader appends idle=nop after the user's arguments, so it cannot
+ * be overridden on the command line. This flag keeps it anyway.
+ */
+static int __init setup_apple_keep_idle_nop(char *arg)
+{
+	apple_keep_idle_nop = true;
+	return 0;
+}
+early_param("apple_keep_idle_nop", setup_apple_keep_idle_nop);
 
 static int __init apple_wfi_quirk_init(void)
 {
+	u32 model = read_cpuid_id() & MIDR_CPU_MODEL_MASK;
+
 	if (midr_is_apple_m4_or_later(read_cpuid_id())) {
 		static_branch_enable(&apple_wfi_loses_regs);
 		pr_info("Apple: preserving registers across WFI\n");
 	}
+	/*
+	 * m1n1 passes idle=nop on M4 and later for kernels that do not
+	 * preserve the registers WFI loses there. This one does, from here
+	 * on, so on T6050 spinning only keeps every idle core busy: the
+	 * system draws about 7 W more at idle. The secondary CPUs are not up
+	 * yet, and the boot CPU has spun until now, so WFI is safe from here.
+	 */
+	if (idle == ARM64_IDLE_NOP && !apple_keep_idle_nop &&
+	    (model == MIDR_APPLE_T6050_M || model == MIDR_APPLE_T6050_P)) {
+		idle = ARM64_IDLE_WFI;
+		pr_info("Apple: idling in WFI, ignoring idle=nop\n");
+	}
 	return 0;
 }
 early_initcall(apple_wfi_quirk_init);

From 9d9bf231386894110e283972260b3e0b359a7ace Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:25:36 -0500
Subject: [PATCH 13/24] HID: dockchannel-hid: Settle 50 ms after releasing the
 AFE reset

Power method 2 with a host-driven AFE reset releases the line for a
power-on and sends HasChanged immediately. The sequence validated on the
J716s (MacBook Pro 16-inch, M5 Pro, MTP firmware 6320.86.1; "Touch MT
ready" on 3 of 3 boots, with the reset on SMC gp1c, active low) waits
50 ms after the release before HasChanged, as this driver already does
for a firmware-managed reset. Do the same for the host-driven line.

Log a failure to drive the line as an error. Each assert and release is
logged at debug level only, so dynamic debug can trace the line without
adding a message to the boot log on every power transition.

Tested on J716s in the tree these changes come from: the keyboard and
the trackpad's multi-touch device come up on every boot. On this tree:
compile-tested.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 24 ++++++++++++++-----
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index e47de457f7f04f..00362e761d303f 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -436,7 +436,8 @@ static int dchid_reset_interface(struct dchid_iface *iface, int state)
 /*
  * Power method 2: announce the transition, drive the AFE reset line to the
  * new state and confirm the transition. The reset is asserted for a power-off
- * and held for 50 ms, and released for a power-on.
+ * and held for 50 ms, and released for a power-on and given 50 ms to settle
+ * before the transition is confirmed.
  */
 static int dchid_pm2_set_power(struct dchid_iface *iface, u8 state)
 {
@@ -454,12 +455,23 @@ static int dchid_pm2_set_power(struct dchid_iface *iface, u8 state)
 		if (state == DCHID_POWER_STATE_ON)
 			fsleep(50 * USEC_PER_MSEC);
 	} else {
-		ret = gpiod_set_value_cansleep(dchid->afe_reset,
-					       state == DCHID_POWER_STATE_OFF);
-		if (ret < 0)
+		bool off = state == DCHID_POWER_STATE_OFF;
+
+		ret = gpiod_set_value_cansleep(dchid->afe_reset, off);
+		if (ret < 0) {
+			dev_err(dchid->dev, "%s: failed to %s the AFE reset: %d\n",
+				iface->name, off ? "assert" : "release", ret);
 			return ret;
-		if (state == DCHID_POWER_STATE_OFF)
-			fsleep(50 * USEC_PER_MSEC);
+		}
+		dev_dbg(dchid->dev, "%s: AFE reset %s\n", iface->name,
+			off ? "asserted" : "released");
+		/*
+		 * The sequence validated on J716s (M5 Pro, MTP firmware
+		 * 6320.86.1, "Touch MT ready" on 3 of 3 boots) also waits
+		 * 50 ms after the release before HasChanged, as the
+		 * firmware-managed path above does.
+		 */
+		fsleep(50 * USEC_PER_MSEC);
 	}
 
 	dchid_pm2_command(iface->index, state, true, msg);

From 2c3c5ff5e762a63061da2c7ce063335d6faf8906 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:25:46 -0500
Subject: [PATCH 14/24] Input: macsmc-input - Confirm a lid-open report during
 system sleep

On the J716s (MacBook Pro 16-inch, M5 Pro) closing the lid starts a
suspend through logind, and the system is awake again 0.7 s later. The
SMC's own syslog shows the cause: about 230 ms after the close
("SMC HID Event: 03 01 00") it reports the lid open ("03 00 01", event
0x72030001, the same bytes as a real opening) while the lid stays shut,
at the same moment as the trackpad coprocessor logs "Sending Cumulus
Report to enter Dependent Mode" (Cumulus is the touch AFE). The driver
takes the report at face value: it is in the sleep window, so it reports
a hard wakeup, pm_system_wakeup() aborts the suspend or ends
suspend-to-idle, and logind then reads "Lid opened".

In the sleep window, between .prepare and .complete, check a lid-open
report before passing it on. Read the SMC's lid key MSLD, the one probe
reads the initial state from: if it says closed, the report is dropped.
If it agrees but the sleep has run for lid_wake_settle_ms or less
(default 2000 ms, 0 restores the old behaviour), the report does not
wake the system either. A held-back report leaves SW_LID closed, and
.complete reports MSLD again, so the switch matches the SMC after any
wakeup. Each decision is logged with the event, the time into the sleep
and MSLD, so a test can tell which check fired.

The notifier runs in the SMC's RTKit worker and the SMC's replies are
taken from the mailbox interrupt (recv_message_early), so reading a key
there does not wait on the worker. The sleep time is taken from
CLOCK_BOOTTIME, which includes the time suspend-to-idle spends with
timekeeping suspended.

What this does not fix: if MSLD agrees with the false report, the SMC
already counts the lid as open, and the real opening that follows may
send no event at all. The system then stays asleep until a key, a
trackpad click or the power button wakes it, instead of waking at once.

Not changed: lid-close reports, the power button, and any lid-open
report outside the sleep window.

Tested on the J716s, in the tree these changes come from, with logind
suspending on lid close (s2idle): the close sleeps ("Timekeeping
suspended for 39.477 seconds") and the real opening wakes it through the
confirm path ("lid open 72030001 at +40069 ms in sleep, MSLD=0:
wakeup"). No spurious report came during that sleep, so the hold-back
path has not run on hardware yet. On this tree: compile-tested.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/input/misc/macsmc-input.c | 84 +++++++++++++++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/drivers/input/misc/macsmc-input.c b/drivers/input/misc/macsmc-input.c
index e149b043fef820..ab6099ca2c383e 100644
--- a/drivers/input/misc/macsmc-input.c
+++ b/drivers/input/misc/macsmc-input.c
@@ -11,23 +11,37 @@
 #include <linux/input.h>
 #include <linux/mfd/core.h>
 #include <linux/mfd/macsmc.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
 #include <linux/reboot.h>
 
+static unsigned int lid_wake_settle_ms = 2000;
+module_param(lid_wake_settle_ms, uint, 0644);
+MODULE_PARM_DESC(lid_wake_settle_ms,
+		 "A lid-open report this many ms or less after system sleep starts does not wake the system (0 = always wake)");
+
 /**
  * struct macsmc_input
  * @dev: Underlying struct device for the input sub-device
  * @smc: Pointer to apple_smc struct of the mfd parent
  * @input: Allocated input_dev; devres managed
  * @nb: Notifier block used for incoming events from SMC (e.g. button pressed down)
+ * @lid_lock: Serialises lid reports with the system sleep callbacks
  * @wakeup_mode: Set to true when system is suspended and power button events should wake it
+ * @lid_held: A lid-open report was not passed on during this system sleep
+ * @sleep_start: CLOCK_BOOTTIME at which this system sleep started
  */
 struct macsmc_input {
 	struct device *dev;
 	struct apple_smc *smc;
 	struct input_dev *input;
 	struct notifier_block nb;
+	struct mutex lid_lock; /* protects the three fields below */
 	bool wakeup_mode;
+	bool lid_held;
+	ktime_t sleep_start;
 };
 
 #define SMC_EV_BTN 0x7201
@@ -79,10 +93,57 @@ static void macsmc_input_event_button(struct macsmc_input *smcin, unsigned long
 	}
 }
 
+/*
+ * On the J716s the SMC has reported the lid open (event 0x72030001, the same
+ * bytes as a real opening) while the lid stayed shut, about 230 ms after the
+ * close that started the suspend and in step with the trackpad coprocessor
+ * moving its AFE to "Dependent Mode". Taken at face value, that report ends
+ * the suspend the close started. So in the sleep window an open report wakes
+ * the system only if the SMC's lid key agrees and the sleep has run for
+ * longer than lid_wake_settle_ms. Called with lid_lock held.
+ */
+static bool macsmc_input_lid_wake_ok(struct macsmc_input *smcin, unsigned long event)
+{
+	s64 ms = ktime_ms_delta(ktime_get_boottime(), smcin->sleep_start);
+	u8 closed;
+	int ret;
+
+	ret = apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &closed);
+	if (ret < 0) {
+		dev_warn(smcin->dev, "lid open %08lx at +%lld ms in sleep, MSLD read failed: %d\n",
+			 event, ms, ret);
+		closed = 0;
+	}
+
+	if (closed) {
+		dev_info(smcin->dev, "lid open %08lx at +%lld ms in sleep, MSLD=%u: ignored\n",
+			 event, ms, closed);
+		return false;
+	}
+
+	if (lid_wake_settle_ms && ms <= lid_wake_settle_ms) {
+		dev_info(smcin->dev, "lid open %08lx at +%lld ms in sleep, MSLD=0, within %u ms: no wakeup\n",
+			 event, ms, lid_wake_settle_ms);
+		return false;
+	}
+
+	dev_info(smcin->dev, "lid open %08lx at +%lld ms in sleep, MSLD=0: wakeup\n", event, ms);
+	return true;
+}
+
 static void macsmc_input_event_lid(struct macsmc_input *smcin, unsigned long event)
 {
 	u8 lid_state = !!((event >> 8) & 0xff);
 
+	guard(mutex)(&smcin->lid_lock);
+
+	if (smcin->wakeup_mode && !lid_state &&
+	    !macsmc_input_lid_wake_ok(smcin, event)) {
+		/* SW_LID stays closed; complete() resynchronises it from MSLD. */
+		smcin->lid_held = true;
+		return;
+	}
+
 	pm_wakeup_dev_event(smcin->dev, 0, (smcin->wakeup_mode && !lid_state));
 	input_report_switch(smcin->input, SW_LID, lid_state);
 	input_sync(smcin->input);
@@ -134,6 +195,10 @@ static int macsmc_input_probe(struct platform_device *pdev)
 	smcin->smc = smc;
 	platform_set_drvdata(pdev, smcin);
 
+	error = devm_mutex_init(&pdev->dev, &smcin->lid_lock);
+	if (error)
+		return error;
+
 	smcin->input = devm_input_allocate_device(&pdev->dev);
 	if (!smcin->input)
 		return -ENOMEM;
@@ -198,6 +263,9 @@ static int macsmc_input_pm_prepare(struct device *dev)
 {
 	struct macsmc_input *smcin = dev_get_drvdata(dev);
 
+	guard(mutex)(&smcin->lid_lock);
+	smcin->sleep_start = ktime_get_boottime();
+	smcin->lid_held = false;
 	smcin->wakeup_mode = true;
 	return 0;
 }
@@ -205,8 +273,24 @@ static int macsmc_input_pm_prepare(struct device *dev)
 static void macsmc_input_pm_complete(struct device *dev)
 {
 	struct macsmc_input *smcin = dev_get_drvdata(dev);
+	u8 closed;
+	int error;
 
+	guard(mutex)(&smcin->lid_lock);
 	smcin->wakeup_mode = false;
+	if (!smcin->lid_held)
+		return;
+	smcin->lid_held = false;
+
+	/* An open report was held back: report what the SMC says now. */
+	error = apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &closed);
+	if (error < 0) {
+		dev_warn(dev, "Failed to read the lid state after sleep: %d\n", error);
+		return;
+	}
+	dev_info(dev, "lid after sleep: MSLD=%u\n", closed);
+	input_report_switch(smcin->input, SW_LID, !!closed);
+	input_sync(smcin->input);
 }
 
 static const struct dev_pm_ops macsmc_input_pm_ops = {

