+		// and 1 are cluster-type "M", cluster 2 is cluster-type "P".
+		// reg encodes cluster << 8 | core. MIDR part 0x68 ("Sotra C"
+		// family).
+		cpu_m00: cpu@0 {
+			compatible = "apple,sotra";
+			reg = <0x0 0x40000>;
+			cpu-release-addr = <0 0>; /* to be filled by loader */
+			device_type = "cpu";
+			enable-method = "spin-table";
+			next-level-cache = <&l2_cache_0>;
+			operating-points-v2 = <&mcluster0_opp>;
+			performance-domains = <&cpufreq_m0>;
+		};
