From d4c0f512cb8e7abec59e280d9495d911017012d4 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:39:43 -0500
Subject: [PATCH 18/24] gpio: macsmc: Drive the J716s trackpad AFE reset
 through pcIO

The J716s (MacBook Pro 16-inch, M5 Pro) Apple Device Tree describes the
trackpad's AFE reset with the same platform function as the J714c's,
multi-touch function-afe-reset = smc-pmu pKW8('pcIO', 0x10000,
0x11c0000): SMC pcIO output 28, where level 1 asserts the reset. Give
the J716s the J714c's pcIO line table.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/gpio/gpio-macsmc.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/gpio/gpio-macsmc.c b/drivers/gpio/gpio-macsmc.c
index 7036186a185b8c..60c776a7df44a2 100644
--- a/drivers/gpio/gpio-macsmc.c
+++ b/drivers/gpio/gpio-macsmc.c
@@ -18,7 +18,7 @@
 #define MAX_GPIO 64
 
 /*
- * J700 and J714c reset their trackpad analog front end through the SMC
+ * J700, J714c and J716s reset their trackpad analog front end through the SMC
  * "pcIO" key rather than a gPxx GPIO key. The Apple device tree describes the
  * reset as a platform function such as pKW8("pcIO", 0x10000, 0x130000): an
  * eight-byte write with 0x10000 in the low word, 0x130000 in the high word
@@ -38,6 +38,7 @@ static const struct macsmc_pcio_line macsmc_j700_pcio[] = {
 	{ }
 };
 
+/* J714c and J716s: the same template in both Apple device trees */
 static const struct macsmc_pcio_line macsmc_j714c_pcio[] = {
 	/* multi-touch function-afe-reset: pKW8("pcIO", 0x10000, 0x11c0000) */
 	{ 28, 0x10000, 0x11c0000 },
@@ -322,7 +323,8 @@ static int macsmc_gpio_probe(struct platform_device *pdev)
 	if (device_is_compatible(&pdev->dev, "apple,smc-gpio")) {
 		if (of_machine_is_compatible("apple,j700"))
 			smcgp->pcio = macsmc_j700_pcio;
-		else if (of_machine_is_compatible("apple,j714c"))
+		else if (of_machine_is_compatible("apple,j714c") ||
+			 of_machine_is_compatible("apple,j716s"))
 			smcgp->pcio = macsmc_j714c_pcio;
 	}
 

From 89cbb3fa1fb2d666f15629dc09c7ff72d64e2f00 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:46:08 -0500
Subject: [PATCH 19/24] arm64: dts: apple: Add J716s (MacBook Pro 16-inch, M5
 Pro)

Add the 16-inch MacBook Pro with the M5 Pro (J716s, Mac17,8), a T6050
board, on the T6050 files the J714c uses. Its Apple Device Tree lists
the 18 CPUs in the order of t6050-base.dtsi. t6050-j716s.dts has:

- memory, the boot framebuffer marked as the built-in panel, and the
  serial console, as on the J714c;
- the keyboard and trackpad (trackpad firmware apple/tpmtfw-j716s.bin,
  power method 2, the host-driven AFE reset on SMC pcIO output 28, the
  same ADT template as the J714c's);
- the keyboard backlight (pwm-leds on fpwm0, 40000 ns period);
- the SMC with the common, dual-fan and laptop sensors and the F0md/F1md
  fan mode keys, as on the J714c. Restart and power-off go through the
  SMC (t6050-smc.dtsi): on this board the PMIC scratchpad cells it
  writes were read back (a restart from Linux is no longer counted as a
  failed boot by iBoot), and an SMC restart comes back into the boot
  loader as a watchdog restart does.

Not described yet: USB on both Type-C ports, PCIe with the N1 (Wi-Fi
and Bluetooth) and the SD reader, audio, the GPU and the display
controller.

As on the J714c, the keyboard and trackpad need the loader to program
the MTP DAPF (m1n1 on T6050).

Tested on J716s in the tree this description comes from (aurora-silicon
integration/aurora with the equivalent nodes on its T6050 files): 18
CPUs, the root file system on the internal SSD, the keyboard and the
trackpad's multi-touch device, kbd_backlight, AC and battery, the SMC
fan, power, voltage and current sensors, the panel as eDP-1, lid-close
sleep and wake, and restart and power-off through the SMC. On this
tree: dtbs and dtbs_check only, not booted. In the tested tree the AFE
reset was driven as SMC GPIO gp1c of the second bank, active low, which
the J716s ADT names as the same line; the pcIO path has not run on this
board.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 arch/arm64/boot/dts/apple/Makefile        |   1 +
 arch/arm64/boot/dts/apple/t6050-j716s.dts | 140 ++++++++++++++++++++++
 2 files changed, 141 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t6050-j716s.dts

diff --git a/arch/arm64/boot/dts/apple/Makefile b/arch/arm64/boot/dts/apple/Makefile
index b59ae4f6a6c475..8b605c635d6cd4 100644
--- a/arch/arm64/boot/dts/apple/Makefile
+++ b/arch/arm64/boot/dts/apple/Makefile
@@ -95,6 +95,7 @@ dtb-$(CONFIG_ARCH_APPLE) += t6032-j575d.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6034-j514m.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6034-j516m.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714c.dtb
+dtb-$(CONFIG_ARCH_APPLE) += t6050-j716s.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t8112-j413.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t8112-j415.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t8112-j473.dtb
diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
new file mode 100644
index 00000000000000..761218d9d3bac2
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple MacBook Pro (16-inch, M5 Pro, 2026)
+ *
+ * target-type: J716s (Mac17,8)
+ *
+ * The M5 Pro here is a T6050 with all 18 CPU cores, laid out as on the
+ * J714c. The loader supplies usable memory, CPU release addresses,
+ * framebuffer geometry and the keyboard layout. Peripheral power domains
+ * come from t6050-pmgr.dtsi; the framebuffer holds the display domain.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+
+#include "t6050.dtsi"
+#include "t6050-smc.dtsi"
+
+/ {
+	compatible = "apple,j716s", "apple,t6050", "apple,arm-platform";
+	#address-cells = <2>;
+	chassis-type = "laptop";
+	interrupt-parent = <&aic>;
+	model = "Apple MacBook Pro (16-inch, M5 Pro, 2026)";
+	#size-cells = <2>;
+
+	aliases {
+		keyboard = &keyboard;
+		serial0 = &serial0;
+	};
+
+	chosen {
+		ranges;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		stdout-path = "serial0:1500000n8";
+
+		framebuffer@0 {
+			compatible = "apple,simple-framebuffer",
+				     "simple-framebuffer";
+			reg = <0 0 0 0>; /* Filled by the loader. */
+			power-domains = <&ps_disp_cpu>;
+			apple,internal-panel; /* simpledrm reports it as eDP */
+
+			/* m1n1 only enables it on chips it knows. */
+			status = "okay";
+		};
+	};
+
+	memory@10000000000 {
+		reg = <0x100 0 0 0>; /* Filled by the loader. */
+		device_type = "memory";
+	};
+
+	/* ADT pwm0/kbd-backlight: channel 0 at 25 kHz */
+	led-controller {
+		compatible = "pwm-leds";
+
+		led-0 {
+			color = <LED_COLOR_ID_WHITE>;
+			default-state = "keep";
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+			label = "kbd_backlight";
+			max-brightness = <255>;
+			pwms = <&fpwm0 0 40000>;
+		};
+	};
+};
+
+&fpwm0 {
+	status = "okay";
+};
+
+&mtp {
+	status = "okay";
+};
+
+&mtp_mbox {
+	status = "okay";
+};
+
+&mtp_dart {
+	status = "okay";
+};
+
+&mtp_dockchannel {
+	status = "okay";
+};
+
+&mtp_hid {
+	/*
+	 * ADT multi-touch function-afe-reset = smc-pmu pKW8('pcIO', 0x10000,
+	 * 0x11c0000), SMC pcIO output 28 as on the J714c; level 1 asserts the
+	 * reset.
+	 */
+	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_HIGH>;
+
+	actuator {
+	};
+
+	keyboard: keyboard {
+		hid-country-code = <0>;
+		apple,keyboard-layout-id = <0>;
+	};
+
+	multi-touch {
+		firmware-name = "apple/tpmtfw-j716s.bin";
+		apple,power-method = <2>;
+	};
+
+	stm {
+	};
+
+	tp_accel {
+	};
+};
+
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
+#include "hwmon-laptop.dtsi"
+
+/*
+ * The T6050 SMC spells the fan mode keys F0md/F1md; F0Md/F1Md from
+ * hwmon-fan*.dtsi do not exist.
+ */
+&smc_hwmon {
+	fan-F0Ac {
+		apple,fan-mode = "F0md";
+	};
+
+	fan-F1Ac {
+		apple,fan-mode = "F1md";
+	};
+};

From ffa59d70cf29a3ad4ed30c953b6c7c7fa50e26e2 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:46:09 -0500
Subject: [PATCH 20/24] arm64: configs: Add a J716s fragment

Add j716s.config, the drivers on the J716s boot path built in, for a
root file system that carries no modules: storage (ANS NVMe, SART,
RTKit helper), the SMC and its consumers with the SPMI PMIC cells,
cpufreq, the DockChannel keyboard and trackpad, and the keyboard
backlight. Rust and the display controller driver stay off: nothing on
this boot path needs them yet. Used as

  make ARCH=arm64 LLVM=1 defconfig asahi.config j716s.config

like the j813 fragments.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 arch/arm64/configs/j716s.config | 41 +++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)
 create mode 100644 arch/arm64/configs/j716s.config

diff --git a/arch/arm64/configs/j716s.config b/arch/arm64/configs/j716s.config
new file mode 100644
index 00000000000000..0627a221cab3c4
--- /dev/null
+++ b/arch/arm64/configs/j716s.config
@@ -0,0 +1,41 @@
+# MacBook Pro (16-inch, M5 Pro, 2026), J716s: the drivers on its boot path
+# built in, for a root file system that carries no modules, on top of
+# defconfig and asahi.config:
+#   make ARCH=arm64 LLVM=1 defconfig asahi.config j716s.config
+
+# Nothing on the T6050 boot path needs Rust yet
+CONFIG_RUST=n
+CONFIG_DRM_APPLE=n
+
+# Storage: ANS NVMe behind SART, RTKit
+CONFIG_NVME_APPLE=y
+CONFIG_APPLE_SART=y
+CONFIG_APPLE_RTKIT_HELPER=y
+
+# SMC and its consumers; the PMIC NVMEM cells the RTC and reboot read
+CONFIG_MFD_MACSMC=y
+CONFIG_GPIO_MACSMC=y
+CONFIG_INPUT_MACSMC_INPUT=y
+CONFIG_POWER_RESET_MACSMC=y
+CONFIG_SENSORS_MACSMC_HWMON=y
+CONFIG_MACSMC_POWER=y
+CONFIG_RTC_DRV_MACSMC=y
+CONFIG_SPMI_APPLE=y
+CONFIG_NVMEM_APPLE_SPMI=y
+
+# CPU frequency
+CONFIG_ARM_APPLE_SOC_CPUFREQ=y
+
+# Keyboard and trackpad: DockChannel HID. HID_MAGICMOUSE drives the
+# trackpad; the MTP haptic driver would force it to =m, so it stays off
+# (no click haptics).
+CONFIG_APPLE_DOCKCHANNEL=y
+CONFIG_HID_DOCKCHANNEL=y
+CONFIG_HID_APPLE=y
+CONFIG_HID_MAGICMOUSE=y
+CONFIG_HID_APPLE_MTP_HAPTIC=n
+CONFIG_HIDRAW=y
+
+# Keyboard backlight
+CONFIG_PWM_APPLE=y
+CONFIG_LEDS_PWM=y

From 23480bf91efd7a742effebcd7f85a0d6c9711e45 Mon Sep 17 00:00:00 2001
From: Dj <hey@djdev.me>
Date: Fri, 6 Nov 2026 18:48:49 -0500
Subject: [PATCH 21/24] power: supply: macsmc-power: read battery identity
 strings at their key size

Probe reads BMDN, BMSN and BMDT with the size of the destination buffer
instead of the size of the key. SMC read requests must describe the key,
not the buffer. Read each identity key's info first, refuse a key that
is empty, unreadable or too large for the buffer, read exactly its size
and terminate the string. Also check for the SMC parent before using it.

This is the drivers/power/supply/macsmc-power.c part of commit
54b12371013e ("mfd: macsmc: Support T6050 power and pcIO consumers") on
aurora-silicon branch j716c/t6050-platform, which applies unchanged; the
gpio-macsmc, macsmc MFD and binding parts are left out. A T6050 kernel
without it hung in macsmc-power probe (J716s, 2026-11-05, last line
after "Apple SMC power/lid events"); whether these reads were the cause
is not established.

Signed-off-by: Dj <hey@djdev.me>
Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/power/supply/macsmc-power.c | 41 ++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index 9e8388f9a824b4..e6c3687d94ab0d 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -970,10 +970,34 @@ static int macsmc_power_event(struct notifier_block *nb, unsigned long event, vo
 	return NOTIFY_DONE;
 }
 
+static int macsmc_read_identity(struct apple_smc *smc, smc_key key,
+			       char *out, size_t capacity)
+{
+	struct apple_smc_key_info info;
+	int ret;
+
+	if (!capacity)
+		return -EINVAL;
+	out[0] = '\0';
+	ret = apple_smc_get_key_info(smc, key, &info);
+	if (ret < 0)
+		return ret;
+	if (!info.size || info.size >= capacity || !(info.flags & APPLE_SMC_READABLE))
+		return -EINVAL;
+	/* SMC read requests must describe this key, not the destination buffer. */
+	ret = apple_smc_read(smc, key, out, info.size);
+	if (ret != info.size) {
+		out[0] = '\0';
+		return ret < 0 ? ret : -EIO;
+	}
+	out[info.size] = '\0';
+	return 0;
+}
+
 static int macsmc_power_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
-	struct apple_smc *smc = dev_get_drvdata(pdev->dev.parent);
+	struct apple_smc *smc;
 	struct power_supply_config psy_cfg = {};
 	struct apple_smc_key_info info;
 	struct macsmc_power *power;
@@ -986,6 +1010,9 @@ static int macsmc_power_probe(struct platform_device *pdev)
 	enum power_supply_property *props;
 	size_t nprops;
 
+	if (!dev->parent)
+		return dev_err_probe(dev, -ENODEV, "Missing SMC parent\n");
+	smc = dev_get_drvdata(dev->parent);
 	if (!smc)
 		return -ENODEV;
 
@@ -1148,12 +1175,12 @@ static int macsmc_power_probe(struct platform_device *pdev)
 		power->batt_desc.num_properties = nprops;
 
 		/* Fetch identity strings */
-		apple_smc_read(smc, SMC_KEY(BMDN), power->model_name,
-			       sizeof(power->model_name) - 1);
-		apple_smc_read(smc, SMC_KEY(BMSN), power->serial_number,
-			       sizeof(power->serial_number) - 1);
-		apple_smc_read(smc, SMC_KEY(BMDT), power->mfg_date,
-			       sizeof(power->mfg_date) - 1);
+		macsmc_read_identity(smc, SMC_KEY(BMDN), power->model_name,
+				     sizeof(power->model_name));
+		macsmc_read_identity(smc, SMC_KEY(BMSN), power->serial_number,
+				     sizeof(power->serial_number));
+		macsmc_read_identity(smc, SMC_KEY(BMDT), power->mfg_date,
+				     sizeof(power->mfg_date));
 
 		apple_smc_read_u8(power->smc, SMC_KEY(BNCB), &power->num_cells);
 		power->nominal_voltage_mv = MACSMC_NOMINAL_CELL_VOLTAGE_MV * power->num_cells;

