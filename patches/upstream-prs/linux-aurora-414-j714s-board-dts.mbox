+	// cpu reg is the MPIDR affinity. On T6050 the boot core reads
+	// MPIDR_EL1 0x80040000: Aff2 is 4, cluster in Aff1, core in Aff0.
+	// Clusters 1 and 2 follow that pattern; their cores do not start today.
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&cpu_m00>; };
+				core1 { cpu = <&cpu_m01>; };
+				core2 { cpu = <&cpu_m02>; };
+				core3 { cpu = <&cpu_m03>; };
+				core4 { cpu = <&cpu_m04>; };
+				core5 { cpu = <&cpu_m05>; };
+			};
+
+			cluster1 {
+				core0 { cpu = <&cpu_m10>; };
+				core1 { cpu = <&cpu_m11>; };
+				core2 { cpu = <&cpu_m12>; };
+				core3 { cpu = <&cpu_m13>; };
+				core4 { cpu = <&cpu_m14>; };
+				core5 { cpu = <&cpu_m15>; };
+			};
+
+			cluster2 {
+				core0 { cpu = <&cpu_p00>; };
+				core1 { cpu = <&cpu_p01>; };
+				core2 { cpu = <&cpu_p02>; };
+				core3 { cpu = <&cpu_p03>; };
+				core4 { cpu = <&cpu_p04>; };
+				core5 { cpu = <&cpu_p05>; };
+			};
+		};
