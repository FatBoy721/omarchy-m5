From 4b0a276d79532760644adb0a8567606cc9611a62 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Thu, 29 Oct 2026 00:41:23 +0100
Subject: [PATCH 05/10] kboot: GPU handoff for T6050

Generalise dt_set_gpu_t8140 into dt_set_gpu_g17 parameterised by the G17
perf-state shape (count, active states, table count) and the accepted
compatibles, and call it for T6050 (apple,agx-t6050; 14/13/4) as well as
T8140. Fills the OPP table and the four UAT reserved-memory regions from the
ADT and leaves the node enabled when the data validates.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/kboot_gpu.c | 43 ++++++++++++++++++++++++++++++-------------
 1 file changed, 30 insertions(+), 13 deletions(-)

diff --git a/src/kboot_gpu.c b/src/kboot_gpu.c
index 718d4676c..3d8c12cbe 100644
--- a/src/kboot_gpu.c
+++ b/src/kboot_gpu.c
@@ -2984,13 +2984,26 @@ static int dt_set_gpu_t8122(void *dt)
     return 0;
 }
 
-static int dt_set_gpu_t8140(void *dt)
+/* G17 GPUs: the ADT perf-state shape and the compatibles the loader accepts. */
+struct g17_gpu {
+    const char *name;
+    const char *compatible;
+    const char *adt_compatible;
+    u32 count;      /* perf-state-count, and the DT OPP entries */
+    u32 num_states; /* gpu-num-perf-states */
+    u32 tables;     /* perf-state-table-count; the OPPs come from the first table */
+};
+
+static const struct g17_gpu g17_t8140 = {"T8140", "apple,agx-t8140", "gpu,t8140", 16, 15, 1};
+static const struct g17_gpu g17_t6050 = {"T6050", "apple,agx-t6050", "gpu,t6050", 14, 13, 4};
+
+static int dt_set_gpu_g17(void *dt, const struct g17_gpu *g)
 {
     int gpu = fdt_path_offset(dt, "gpu");
     if (gpu < 0)
         return 0;
-    if (fdt_node_check_compatible(dt, gpu, "apple,agx-t8140") &&
-        fdt_node_check_compatible(dt, gpu, "gpu,t8140"))
+    if (fdt_node_check_compatible(dt, gpu, g->compatible) &&
+        fdt_node_check_compatible(dt, gpu, g->adt_compatible))
         return 0;
 
     int sgx = adt_path_offset(adt, "/arm-io/sgx");
@@ -2998,14 +3011,14 @@ static int dt_set_gpu_t8140(void *dt)
     const struct perf_state *states, *sram;
     if (sgx < 0 || ADT_GETPROP(adt, sgx, "perf-state-count", &count) != sizeof(count) ||
         ADT_GETPROP(adt, sgx, "gpu-num-perf-states", &num_states) != sizeof(num_states) ||
-        ADT_GETPROP(adt, sgx, "perf-state-table-count", &tables) != sizeof(tables) || count != 16 ||
-        num_states != 15 || tables != 1)
+        ADT_GETPROP(adt, sgx, "perf-state-table-count", &tables) != sizeof(tables) ||
+        count != g->count || num_states != g->num_states || tables != g->tables)
         goto disable;
     states = adt_getprop(adt, sgx, "perf-states", &len);
-    if (!states || len != count * sizeof(*states))
+    if (!states || len != tables * count * sizeof(*states))
         goto disable;
     sram = adt_getprop(adt, sgx, "perf-states-sram", &len);
-    if (!sram || len != count * sizeof(*sram))
+    if (!sram || len != tables * count * sizeof(*sram))
         goto disable;
     for (u32 i = 0; i < count; i++)
         if (states[i].volt > UINT32_MAX / 1000)
@@ -3018,14 +3031,16 @@ static int dt_set_gpu_t8140(void *dt)
     int table = fdt_node_offset_by_phandle(dt, fdt32_ld(opp_ph));
     if (table < 0)
         goto disable;
-    int opp, opp_count = 0;
+    int opp;
+    u32 opp_count = 0;
     fdt_for_each_subnode(opp, dt, table)
     {
-        if (++opp_count > 16 || !fdt_getprop(dt, opp, "opp-hz", &ph_len) || ph_len != sizeof(u64) ||
-            !fdt_getprop(dt, opp, "opp-microvolt", &ph_len) || ph_len != sizeof(u32))
+        if (++opp_count > g->count || !fdt_getprop(dt, opp, "opp-hz", &ph_len) ||
+            ph_len != sizeof(u64) || !fdt_getprop(dt, opp, "opp-microvolt", &ph_len) ||
+            ph_len != sizeof(u32))
             goto disable;
     }
-    if (opp_count != 16)
+    if (opp_count != g->count)
         goto disable;
 
     static const struct {
@@ -3070,14 +3085,16 @@ static int dt_set_gpu_t8140(void *dt)
     gpu = fdt_path_offset(dt, "gpu");
     if (gpu >= 0 && fdt_setprop_string(dt, gpu, "status", "disabled"))
         return -1;
-    printf("FDT: GPU: invalid T8140 ADT or DT data, disabling GPU\n");
+    printf("FDT: GPU: invalid %s ADT or DT data, disabling GPU\n", g->name);
     return 0;
 }
 
 int dt_set_gpu(void *dt)
 {
     if (chip_id == T8140)
-        return dt_set_gpu_t8140(dt);
+        return dt_set_gpu_g17(dt, &g17_t8140);
+    if (chip_id == T6050)
+        return dt_set_gpu_g17(dt, &g17_t6050);
 
     bool has_cs_afr = false;
     int (*calc_power)(u32 count, u32 table_count, const struct perf_state *core,

From 24bb2fdbebe12545b850ad26c1e59f587a27aa46 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Thu, 5 Nov 2026 20:11:42 +0100
Subject: [PATCH 06/10] payload: boot= takes the stage 1 config's proxy window
 without its chainload target

A stage 1 with boot= loads the kernel, DTB and initramfs from the ESP
itself, so the secondaries start from the image iBoot loaded and their
locked RVBAR needs no relay. The embedded stage 1 config is the only
source of the USB proxy window, but a valid config also set the
chainload target, and boot= plus chainload= is refused. With boot= set,
the config now only provides the window.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/payload.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/payload.c b/src/payload.c
index 035968ba4..c2bf37caa 100644
--- a/src/payload.c
+++ b/src/payload.c
@@ -403,7 +403,8 @@ int payload_run(void)
 
 #ifndef ESP_STAGE2
     if (!stage1_config_applied) {
-        const char *target = stage1_config_target();
+        /* With boot= the embedded config only sets the proxy window: no chainload target. */
+        const char *target = boot_spec ? NULL : stage1_config_target();
         if (target) {
             if (chainload_spec && strcmp(chainload_spec, target)) {
                 printf("Payload: embedded and appended chainload targets differ\n");

From 608a1777d0388d4ed4520e7b7ada471d75ccf1cc Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Fri, 6 Nov 2026 14:07:00 +0100
Subject: [PATCH 07/10] dapf: add the T6050 PMP DART (dart-pmp0)

Add /arm-io/dart-pmp0 to dapf_entries[] so dapf_init programs the T6050
PMP's DAPF filter. Without it the PMP ASC MMIO window stays fabric-gated
and AP access SYNC-faults. dart-pmp0 is dart,t8110 with a
dapf-instance-0 property, which dapf_init -> dapf_init_t8110 already
handles; the DAPF aperture is reg[1] (0x2841b0000). After
dapf_init("/arm-io/dart-pmp0", 1) the PMP ASC CPU_CONTROL reads cleanly,
where a raw read without the filter faults.

On the FDT path the kernel DT aliases pmp0 to the PMP's DART with
status = okay to match this entry.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/dapf.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/dapf.c b/src/dapf.c
index b9a053853..2ed0e0332 100644
--- a/src/dapf.c
+++ b/src/dapf.c
@@ -187,8 +187,14 @@ struct entry {
 
 struct entry dapf_entries[] = {
     /* Keep dart-ane out: its Linux driver owns that DAPF on T8140. */
-    {"/arm-io/dart-aop", 1, "aop"}, {"/arm-io/dart-mtp", 1, "mtp"},  {"/arm-io/dart-pmp", 1, "pmp"},
-    {"/arm-io/dart-isp", 5, "isp"}, {"/arm-io/dart-isp0", 5, "isp"}, {NULL, -1, NULL},
+    {"/arm-io/dart-aop", 1, "aop"},
+    {"/arm-io/dart-mtp", 1, "mtp"},
+    {"/arm-io/dart-pmp", 1, "pmp"},
+    /* T6050: the PMP's DART is dart-pmp0 (dart,t8110; DAPF aperture reg[1], live-verified). */
+    {"/arm-io/dart-pmp0", 1, "pmp0"},
+    {"/arm-io/dart-isp", 5, "isp"},
+    {"/arm-io/dart-isp0", 5, "isp"},
+    {NULL, -1, NULL},
 };
 
 int dapf_init_fdt(const void *fdt)

From 162b25f62c02a250f561c822fa6a8fbcf1401fe6 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 10:34:15 +0100
Subject: [PATCH 08/10] payload: an appended kernel takes the stage 1 config's
 proxy window without its chainload target

A stage 1 that carries its next stage (U-Boot as the kernel payload, with
its devicetree) uses the embedded config for the proxy window only, as
boot= does. The default stage 2 target would otherwise replace the
appended kernel.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/payload.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/payload.c b/src/payload.c
index c2bf37caa..38da81d1e 100644
--- a/src/payload.c
+++ b/src/payload.c
@@ -403,8 +403,11 @@ int payload_run(void)
 
 #ifndef ESP_STAGE2
     if (!stage1_config_applied) {
-        /* With boot= the embedded config only sets the proxy window: no chainload target. */
-        const char *target = boot_spec ? NULL : stage1_config_target();
+        /*
+         * With boot= or an appended kernel (U-Boot) the embedded config only sets the proxy
+         * window: no chainload target.
+         */
+        const char *target = (boot_spec || kernel) ? NULL : stage1_config_target();
         if (target) {
             if (chainload_spec && strcmp(chainload_spec, target)) {
                 printf("Payload: embedded and appended chainload targets differ\n");

From ad08bf5449bdb0226783e4602d47899e84494840 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 19:38:03 +0100
Subject: [PATCH 09/10] payload: T6050 stage 2 marks stage 1's live ANS session
 for U-Boot

Stage 1 reads m1n1/boot.bin with its own NVMe driver and hands the ANS
session over live (nvme.adopt=live-rtkit-v1). The ANS firmware takes
its RTKit handshake once per boot, so U-Boot must adopt that session
instead of starting one. Set /chosen/asahi,nvme-adopt for the appended
next stage; U-Boot's T6050 NVMe driver adopts when it is present.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/payload.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/payload.c b/src/payload.c
index 38da81d1e..8c90e5efb 100644
--- a/src/payload.c
+++ b/src/payload.c
@@ -512,6 +512,14 @@ int payload_run(void)
 
         if (config_lost)
             kboot_set_config_lost();
+
+#ifdef ESP_STAGE2
+        /* T6050: stage 1 left the ANS session live; the next stage (U-Boot) adopts it. */
+        if (chip_id == T6050 && nvme_adopt_live_session && !boot_spec &&
+            kboot_set_chosen("asahi,nvme-adopt", "live-rtkit-v1") < 0)
+            printf("Failed to kboot set asahi,nvme-adopt\n");
+#endif
+
         if (kboot_prepare_dt(fdt)) {
             printf("Failed to prepare FDT!\n");
             goto boot_failed;

From c02070dcf0a9830e39e7fcb66c186f2aec3ceecc Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Tue, 27 Oct 2026 00:54:35 +0100
Subject: [PATCH 10/10] main: T6050_NO_HOST_PREP build switch skips the USB
 host prep

A test build (make EXTRA_CFLAGS="-Wstack-usage=2048 -DT6050_NO_HOST_PREP")
leaves the ports as the proxy left them and prints "T6050 host prep
skipped", so a boot shows whether the kernel's apple,t6050-usb2-phy driver
sets up the USB-C ports on its own. The /chosen/apple,t6050-usbprep record
is then all zeros.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 103ab882d574c29b4926ad66936c204193feceec)
---
 src/main.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/main.c b/src/main.c
index 136fcc62c..09ecbca2f 100644
--- a/src/main.c
+++ b/src/main.c
@@ -335,7 +335,12 @@ void m1n1_main(void)
 #ifndef BRINGUP
     if (chip_id != T8152) {
         usb_iodev_shutdown();
+#ifdef T6050_NO_HOST_PREP
+        /* Test build: the kernel's apple,t6050-usb2-phy does the port setup alone. */
+        printf("T6050 host prep skipped\n");
+#else
         usb_t6050_host_prep();
+#endif
         /* Its firmware may still use memory the next stage will reuse. */
         if (display_shutdown(DCP_SLEEP_IF_EXTERNAL) < 0) {
             printf("Display handoff failed; returning to proxy\n");
