From 620fcd6aa696c0d0546d66c02cfe4fa45d4538a4 Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:59:11 -0500
Subject: [PATCH] kboot: T6050: give the dcp and display-subsystem nodes a
 phandle for the DCP handoff

dtc gives an unreferenced node no phandle, and nothing references the dcp
node or the display subsystem, so dt_set_display_t6050() refused every
handoff on the shared board tree ("a display node has no phandle").
Allocate one for each inside the undoable DT edit.
---
 src/kboot.c | 26 +++++++++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index 1e7d1ca..4fe98c5 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -5565,6 +5565,18 @@ static int t6050_disp_publish(const struct t6050_disp_nodes *ph, u64 vram, u64 v
     return 0;
 }
 
+/* The phandle of the first @compat node, giving it a new one if it has none */
+static bool t6050_disp_phandle(const char *compat, u32 *phandle)
+{
+    int node = fdt_node_offset_by_compatible(dt, -1, compat);
+
+    if (node < 0)
+        return false;
+    if (*phandle)
+        return true;
+    return !fdt_generate_phandle(dt, phandle) && !fdt_setprop_u32(dt, node, "phandle", *phandle);
+}
+
 static void dt_set_display_t6050(void)
 {
     static const struct fw_version_info compat_27_0 = {V27_0, "27.0", {27, 0, 0}, 3, "override"};
@@ -5620,6 +5632,11 @@ static void dt_set_display_t6050(void)
         t6050_dcp_log("OVERRIDE: firmware-compat 27.0.0\n");
         compat = &compat_27_0;
     }
+    /*
+     * The DARTs and the mailbox are referenced, so they carry phandles. Nothing references the
+     * dcp and display-subsystem nodes themselves, and dtc gives an unreferenced node none: those
+     * two get one inside the undoable edit below.
+     */
     struct t6050_disp_nodes ph = {
         .dcp = fdt_get_phandle(dt, dcp),
         .disp = fdt_get_phandle(dt, disp),
@@ -5627,13 +5644,16 @@ static void dt_set_display_t6050(void)
         .dart_disp = fdt_get_phandle(dt, dart_disp),
         .mbox = fdt_get_phandle(dt, mbox),
     };
-    if (!ph.dcp || !ph.disp || !ph.dart_dcp || !ph.dart_disp || !ph.mbox) {
-        t6050_dcp_log("a display node has no phandle: no handoff\n");
+    if (!ph.dart_dcp || !ph.dart_disp || !ph.mbox) {
+        t6050_dcp_log("a DART or the mailbox has no phandle: no handoff\n");
         return;
     }
 
     void *saved = t6050_dt_save();
-    if (!saved || !t6050_dt_done(saved, !t6050_disp_publish(&ph, vram, vram_size, compat))) {
+    bool ok = saved && t6050_disp_phandle("apple,t6050-dcp", &ph.dcp) &&
+              t6050_disp_phandle("apple,display-subsystem", &ph.disp) &&
+              !t6050_disp_publish(&ph, vram, vram_size, compat);
+    if (!saved || !t6050_dt_done(saved, ok)) {
         t6050_dcp_log("DT edit failed: no handoff\n");
         return;
     }
-- 
