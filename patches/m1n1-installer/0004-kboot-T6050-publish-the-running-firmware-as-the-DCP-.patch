From 701de351f56d6566c814feb384fe33cb61ea57cc Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Tue, 10 Nov 2026 13:06:08 -0500
Subject: [PATCH] kboot: T6050: publish the running firmware as the DCP
 firmware-compat

The firmware-27 DCP driver keys its method tables by the loader's
apple,firmware-compat as the running version (27.3 beta 1 = 27.2.98.1,
as betizzel's m1n1 publishes it). The <27 3 0> this loader published for
27.3 beta 1 matched no table: "DCP firmware-compat 27.3.0 has no 27.x
method table".
---
 src/kboot.c | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index 4fe98c5..ee7b2a5 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -5400,8 +5400,8 @@ static void dt_reserve_t6050_oslogs(void)
  * and the kboot_display_handoff.c walk is written for two-level tables; these are four-level).
  *
  * apple,firmware-compat names the DCP interface the stub's firmware implements: the stub's own
- * version, except that the 27.3 beta 1 stub publishes <27 3 0>, the interface read from its DCP
- * firmware (IOMFB method tags and swap layout). chosen.asahi,t6050-dcp-compat=27.0.0 publishes
+ * version, so 27.3 beta 1 publishes <27 2 98 1>, the key the firmware-27 DCP driver
+ * (linux-aurora 0013) chooses its method table and swap layout by. chosen.asahi,t6050-dcp-compat=27.0.0 publishes
  * <27 0 0> instead: that claims an ABI this firmware was not built for; experiment only.
  */
 #define T6050_ASC_CPU_CONTROL     0x44
@@ -5580,7 +5580,6 @@ static bool t6050_disp_phandle(const char *compat, u32 *phandle)
 static void dt_set_display_t6050(void)
 {
     static const struct fw_version_info compat_27_0 = {V27_0, "27.0", {27, 0, 0}, 3, "override"};
-    static const struct fw_version_info compat_27_3 = {V27_3B1, "27.3", {27, 3, 0}, 3, "compat"};
     struct t6050_disp_state e;
 
     t6050_disp_read(&e);
@@ -5626,8 +5625,7 @@ static void dt_set_display_t6050(void)
         t6050_dcp_log("no ADT /vram above OS RAM: no handoff\n");
         return;
     }
-    const struct fw_version_info *compat =
-        os_firmware.version == V27_3B1 ? &compat_27_3 : &os_firmware;
+    const struct fw_version_info *compat = &os_firmware;
     if (t6050_chosen_is("asahi,t6050-dcp-compat", "27.0.0")) {
         t6050_dcp_log("OVERRIDE: firmware-compat 27.0.0\n");
         compat = &compat_27_0;
-- 
2.56.0

