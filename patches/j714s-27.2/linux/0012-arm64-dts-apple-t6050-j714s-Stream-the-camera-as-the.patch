From 38cc56960f09c2771c75cac0332ff31433ca36a1 Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Thu, 12 Nov 2026 04:15:12 -0500
Subject: [PATCH 12/18] arm64: dts: apple: t6050-j714s: Stream the camera as
 the J714c does

Take edimoldovan's J714c presets (omacom/linux-aurora #422, e8233e1bbe91
and 8916070002f4) for the J714s's IMX958: the full sensor cropped to the
centre, 1920x1080 and 2560x1440 in firmware configuration 6 (two merged
exposures, as macOS streams), 1280x720 in configuration 7.

Tested on the J714s (macOS 27.3 beta 1 firmware): all three stream NV12
at 30 fps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H3rUWsmTuAiei3A7JojjHG
---
 arch/arm64/boot/dts/apple/t6050-j714s.dts | 36 +++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6050-j714s.dts b/arch/arm64/boot/dts/apple/t6050-j714s.dts
index b6c7675864b9..c894e54e7a07 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714s.dts
@@ -610,6 +610,42 @@ fan-F1Ac {
 /* The same T6050 camera as J716c (J714sAP ADT); the loader sets the J714s sensor type. */
 #include "t6050-j716c-isp.dtsi"
 
+/*
+ * The J714s's IMX958 streams as edimoldovan's J714c does (omacom/linux-aurora
+ * #422): the full sensor cropped to the centre, inside the lens circle.
+ * 1920x1080 and 2560x1440 use firmware configuration 6, the one macOS streams
+ * (two exposures, 3040x5760, merged to 3040x2880); 1280x720 uses
+ * configuration 7 (3040x2880). 1920x1080 and 1280x720 scale a 2400x1350
+ * window; 2560x1440 is the centre 1:1.
+ */
+&isp0 {
+	/delete-node/ sensor-presets;
+
+	sensor-presets {
+		/* 1920x1080 */
+		preset0 {
+			apple,config-index = <6>;
+			apple,input-size = <3040 2880>;
+			apple,output-size = <1920 1080>;
+			apple,crop = <320 765 2400 1350>;
+		};
+		/* 1280x720 */
+		preset1 {
+			apple,config-index = <7>;
+			apple,input-size = <3040 2880>;
+			apple,output-size = <1280 720>;
+			apple,crop = <320 765 2400 1350>;
+		};
+		/* 2560x1440 */
+		preset2 {
+			apple,config-index = <6>;
+			apple,input-size = <3040 2880>;
+			apple,output-size = <2560 1440>;
+			apple,crop = <240 720 2560 1440>;
+		};
+	};
+};
+
 /* The GPU and the internal panel, for the boot loader's handoff */
 #include "t6050-j714s-gpu-panel.dtsi"
 
