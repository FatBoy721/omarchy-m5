--- codex-tier2-kbd/src/drivers/hid/dockchannel-hid/dockchannel-hid.c	2026-11-06 01:28:48.629398117 -0500
+++ codex-ftype/src/drivers/hid/dockchannel-hid/dockchannel-hid.c	2026-11-06 02:11:21.038747391 -0500
@@ -1166,10 +1166,23 @@
 	return ret <= 0 ? ret : ret - 1;
 }
 
-/* Note: buf includes report number! */
-static int dchid_set_report(struct dchid_iface *iface, void *buf, size_t len)
+/*
+ * Note: buf includes report number!
+ * The SET framing carries the caller's report type: a feature SET goes out as GROUP=FEATURE (flags 0x80), as the
+ * driver's own comm commands already do (dchid_comm_cmd). Before this fix every SET was framed as OUTPUT (0x40), so
+ * HID-core feature SETs (HIDIOCSFEATURE, hid_hw_raw_request(FEATURE, SET)) lost their type on the wire. Output SETs
+ * (and the unused input-SET case) keep the previous OUTPUT framing.
+ */
+/* M5_SETTYPE_BEGIN */
+static u32 dchid_set_report_type(unsigned char rtype)
 {
-	return dchid_cmd(iface, HID_OUTPUT_REPORT, REQ_SET_REPORT, buf, len, NULL, 0);
+	return rtype == HID_FEATURE_REPORT ? HID_FEATURE_REPORT : HID_OUTPUT_REPORT;
+}
+/* M5_SETTYPE_END */
+
+static int dchid_set_report(struct dchid_iface *iface, unsigned char rtype, void *buf, size_t len)
+{
+	return dchid_cmd(iface, dchid_set_report_type(rtype), REQ_SET_REPORT, buf, len, NULL, 0);
 }
 
 static int dchid_raw_request(struct hid_device *hdev,
@@ -1186,7 +1199,7 @@
 		buf[0] = reportnum;
 		return dchid_cmd(iface, rtype, REQ_GET_REPORT, &reportnum, 1, buf + 1, len - 1);
 	case HID_REQ_SET_REPORT:
-		return dchid_set_report(iface, buf, len);
+		return dchid_set_report(iface, rtype, buf, len);
 	default:
 		return -EIO;
 	}
