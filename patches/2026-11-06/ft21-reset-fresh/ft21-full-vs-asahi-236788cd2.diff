+	 * setup_machine_fdt(), so a green band with no blue one points at the
+	 * devicetree rather than at anything earlier.
+	 */
+	omarchy_fb_marker(OMARCHY_MARK_MMU);
+
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
@@ -296,7 +304,15 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	 * cpufeature code and early parameters.
 	 */
 	jump_label_init();
+	/*
+	 * omarchy-m5: let `earlycon=efifb` draw the kernel log on the panel;
+	 * it attaches inside parse_early_param().
+	 */
+	omarchy_fb_earlycon_init();
+
 	parse_early_param();
+	/* m5: first line on the m5fb earlycon proves setup_arch was reached */
+	pr_notice("m5: setup_arch reached, earlycon parsed\n");
 
 	dynamic_scs_init();
 
@@ -333,6 +349,12 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	paging_init();
 
+	/*
+	 * omarchy-m5: memblock and the linear map survived, which means the
+	 * memory nodes m1n1 patched into the FDT were sane.
+	 */
+	omarchy_fb_marker(OMARCHY_MARK_PAGING);
+
 	acpi_table_upgrade();
 
 	/* Parse the ACPI tables for possible boot-time configuration */
diff --git c/drivers/cpufreq/apple-soc-cpufreq.c i/drivers/cpufreq/apple-soc-cpufreq.c
index 5ad274a1e..579a1a9b2 100644
--- c/drivers/cpufreq/apple-soc-cpufreq.c
+++ i/drivers/cpufreq/apple-soc-cpufreq.c
@@ -73,10 +73,31 @@ struct apple_cpu_priv {
 	struct device *cpu_dev;
 	void __iomem *reg_base;
 	const struct apple_soc_cpufreq_info *info;
+	unsigned int boot_ps;		/* m5 FT11: CMD PS1 read at init (iBoot's state) */
+	bool wrote;			/* m5 FT11: at least one accepted DVFS write */
 };
 
 static struct cpufreq_driver apple_soc_cpufreq_driver;
 
+/*
+ * m5 FT11 write gate (J714s/T6050 bring-up). Default: the driver only READS the CMD register (+0x20); every
+ * DVFS write is refused (-EPERM) until the operator sets allow_write=1, and even then only P-states inside
+ * [cap_min_ps, cap_max_ps] (0 = the boot P-state, so the default window is exactly the boot state) are accepted.
+ * Each accepted write is followed by a bounded readback (BUSY clear and PS1 == requested within 400 us); on any
+ * failure the driver writes the boot P-state once and latches all further writes off. On module exit, if a
+ * write was accepted, the boot P-state is restored (one write, same checks). Params are runtime-writable (0644)
+ * so the operator can open the window without reloading.
+ */
+static bool allow_write;
+module_param(allow_write, bool, 0644);
+MODULE_PARM_DESC(allow_write, "m5: permit DVFS CMD writes (default 0 = read-only)");
+static unsigned int cap_min_ps, cap_max_ps;
+module_param(cap_min_ps, uint, 0644);
+MODULE_PARM_DESC(cap_min_ps, "m5: lowest P-state a write may request (0 = boot P-state)");
+module_param(cap_max_ps, uint, 0644);
+MODULE_PARM_DESC(cap_max_ps, "m5: highest P-state a write may request (0 = boot P-state)");
+static bool m5_latched;
+
 static const struct apple_soc_cpufreq_info soc_s5l8960x_info = {
 	.has_ps2 = false,
 	.max_pstate = 7,
@@ -112,7 +133,26 @@ static const struct apple_soc_cpufreq_info soc_default_info = {
 	.ps1_shift = APPLE_DVFS_CMD_PS1_SHIFT,
 };
 
+/*
+ * T6050 (M5 Pro): CMD +0x20, PS1 [4:0], no PS2, STATUS layout unknown -> read PS1 from CMD (cur_pstate_mask 0).
+ * Source: edimoldovan/linux-aurora c5b0600d19a44f0803cb93cbbd29b663cfa28a77 apple-soc-cpufreq.c:256-262 (soc_t8142_info,
+ * matched for "apple,t6050-cluster-cpufreq" at :309-313), GPL-2.0-only; m1n1 aurora cf57aebc cpufreq.c:10-21
+ * (CLUSTER_PSTATE 0x20020 from the DVFS block 0x210e00000). NATIVE (FT9, m5_dvfsrd 00897bd4): CMD@0x210e20020 =
+ * 0x400106 (busy 0, PS1 6). PS1 is the last accepted request, not a measured clock.
+ */
+static const struct apple_soc_cpufreq_info soc_t6050_info = {
+	.has_ps2 = false,
+	.max_pstate = 31,
+	.cur_pstate_mask = 0,
+	.ps1_mask = APPLE_DVFS_CMD_PS1,
+	.ps1_shift = APPLE_DVFS_CMD_PS1_SHIFT,
+};
+
 static const struct of_device_id apple_soc_cpufreq_of_match[] __maybe_unused = {
+	{
+		.compatible = "apple,t6050-cluster-cpufreq",
+		.data = &soc_t6050_info,
+	},
 	{
 		.compatible = "apple,s5l8960x-cluster-cpufreq",
 		.data = &soc_s5l8960x_info,
@@ -168,41 +208,95 @@ static unsigned int apple_soc_cpufreq_get_rate(unsigned int cpu)
 	return 0;
 }
 
+/*
+ * One DVFS request + bounded readback. Caller holds the gate.
+ *   -EBUSY: BUSY never cleared BEFORE the write -> NOTHING was written (no rollback needed).
+ *   -EIO:   the write was issued but CMD did not show BUSY clear + PS1 == request within 400 us.
+ *   0:      CMD shows the request LATCHED (PS1 == request, BUSY clear). This is the CMD register echoing the
+ *           request, NOT proof of the cluster's actual clock/state (STATUS layout unknown on T6050; bit 31 = BUSY
+ *           is the mainline layout, unverified on T6050).
+ */
+static int m5_dvfs_write(struct apple_cpu_priv *priv, unsigned int pstate)
+{
+	u64 reg, old;
+
+	if (readq_poll_timeout_atomic(priv->reg_base + APPLE_DVFS_CMD, reg,
+				      !(reg & APPLE_DVFS_CMD_BUSY), 2,
+				      APPLE_DVFS_TRANSITION_TIMEOUT)) {
+		dev_err(priv->cpu_dev, "m5: DVFS CMD %#llx BUSY before request PS %u: nothing written\n", reg, pstate);
+		return -EBUSY;
+	}
+	old = reg;
+	reg &= ~priv->info->ps1_mask;
+	reg |= ((u64)pstate << priv->info->ps1_shift) & priv->info->ps1_mask;
+	if (priv->info->has_ps2)
+		FIELD_MODIFY(APPLE_DVFS_CMD_PS2, &reg, pstate);
+	reg |= APPLE_DVFS_CMD_SET;
+	writeq_relaxed(reg, priv->reg_base + APPLE_DVFS_CMD);
+	if (readq_poll_timeout_atomic(priv->reg_base + APPLE_DVFS_CMD, reg,
+				      !(reg & APPLE_DVFS_CMD_BUSY) &&
+				      ((reg & priv->info->ps1_mask) >> priv->info->ps1_shift) == pstate, 2,
+				      APPLE_DVFS_TRANSITION_TIMEOUT)) {
+		dev_err(priv->cpu_dev, "m5: DVFS CMD %#llx -> request PS %u written, not latched within %u us (now %#llx)\n",
+			old, pstate, APPLE_DVFS_TRANSITION_TIMEOUT, reg);
+		return -EIO;
+	}
+	dev_info(priv->cpu_dev, "m5: DVFS CMD %#llx -> %#llx: request PS %u latched (CMD echo; not an actual-clock proof)\n",
+		 old, reg, pstate);
+	return 0;
+}
+
+/*
+ * Restore iBoot's P-state if this load ever had an accepted write (priv->wrote) and is not latched; then latch.
+ * Used by .exit (rmmod) and .suspend (cpufreq_suspend(): device_shutdown() on reboot/kexec/poweroff, and system
+ * suspend). With no accepted write this does nothing (the default read-only load stays at zero writes). It does
+ * not consult allow_write/the window: it only ever returns to the boot state (safe direction; owner may gate).
+ * A hardware-watchdog reset bypasses this entirely.
+ */
+static void m5_restore_boot(struct apple_cpu_priv *priv, const char *why)
+{
+	if (priv && priv->wrote && !m5_latched) {
+		u64 cmd = readq_relaxed(priv->reg_base + APPLE_DVFS_CMD);
+
+		if (((cmd & priv->info->ps1_mask) >> priv->info->ps1_shift) != priv->boot_ps)
+			dev_info(priv->cpu_dev, "m5: %s: restore boot PS %u: %d\n", why, priv->boot_ps,
+				 m5_dvfs_write(priv, priv->boot_ps));
+	}
+	m5_latched = true;
+}
+
 static int apple_soc_cpufreq_set_target(struct cpufreq_policy *policy,
 					unsigned int index)
 {
