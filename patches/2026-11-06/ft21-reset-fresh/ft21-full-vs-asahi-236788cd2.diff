+EXPORT_SYMBOL_GPL(apple_rtkit_helper_stop);
+
+/*
+ * FT2 (m5boot/Codex test kernel only). Native FT1: after the first RUN the MTP faulted at SID 0 read
+ * IOVA 0x2_8830_c000, status 0x2000 = "STE invalid" (aurora apple_dart_t8110_v2_fault_name). Opt-in:
+ * m5_mtp_zeropage=0x28830c000 maps ONE zeroed, read-only RAM page (no MMIO, no identity) at that IOVA
+ * into the MTP's current translated (DMA) domain before the RUN write. Any other value is refused.
+ * Without the token nothing here runs.
+ * - Granule: PAGE_SIZE is 16 KiB (CONFIG_ARM64_16K_PAGES) = the DART page size; the IOVA is 16 KiB aligned.
+ * - Aperture: the IOVA is below the DMA-API aperture (apple-dart sets aperture_start = dma_min, 0x100_00004000),
+ *   so the allocator can never hand it out; iommu_map() only checks alignment (as for the DT direct mappings
+ *   at 0x1000000, which sit below the aperture too).
+ * - Lifetime: the page is allocated once and never freed, and the mapping is never removed. A firmware
+ *   read after a failed probe can therefore never hit freed memory (no UAF), and no stale PTE can point at
+ *   reused memory. On a later probe (rebind) the mapping is re-checked: if the current domain already
+ *   translates the IOVA to our page, nothing happens; if it is unmapped (domain replaced), it is mapped again;
+ *   if it maps something else, we refuse.
+ */
+#include <linux/iommu.h>
+#include <asm/cacheflush.h>
+static unsigned long m5_zp_iova;
+static struct page *m5_zp_page;
+static int __init m5_mtp_zeropage_setup(char *s)
+{
+	return !kstrtoul(s, 0, &m5_zp_iova);
+}
+__setup("m5_mtp_zeropage=", m5_mtp_zeropage_setup);
+
+/*
+ * FT3 (separate opt-in, effective only together with m5_mtp_zeropage=0x28830c000 and the MTP guard):
+ * m5_mtp_zeropage_rw=1 maps the SAME single zeroed RAM page READ|WRITE (still no MMIO, no identity), and
+ * the page is dumped (first 32 bytes + non-zero u32 offsets) to learn what the firmware writes there.
+ * The MTP DT node has no dma-coherent: the zeroed page is cleaned to PoC before mapping (so no dirty CPU line
+ * can later be evicted over a firmware write), and invalidated to PoC before every CPU read in the dump.
+ */
+static bool m5_zp_rw;
+static int __init m5_mtp_zeropage_rw_setup(char *s)
+{
+	return !kstrtobool(s, &m5_zp_rw);
+}
+__setup("m5_mtp_zeropage_rw=", m5_mtp_zeropage_rw_setup);
+
+/*
+ * FT4 (separate opt-in, only with m5_mtp_zeropage=0x28830c000 and the MTP guard): native FT3 crashed on the
+ * next DAPF window, SID 0 read at 0x2881e4050 (status 0x3000 = level-3 PTE invalid). m5_mtp_page2= maps the
+ * 16 KiB page 0x2881e4000:
+ *   zero    : a second zeroed RAM page (READ, plus WRITE iff m5_mtp_zeropage_rw=1), PoC-cleaned, never freed;
+ *   gpio-ro : identity READ-only mapping of the real page (IOMMU_MMIO, no WRITE: the device cannot write it).
+ * Anything else is refused. Mapped together with page 1 before the RUN write; same lifetime/re-check rules.
+ */
+#define M5_P2_IOVA 0x2881e4000UL
+static int m5_p2_mode;	/* 0 off, 1 zero, 2 gpio-ro */
+static struct page *m5_p2_page;
+static int __init m5_mtp_page2_setup(char *s)
+{
+	if (!strcmp(s, "zero"))
+		m5_p2_mode = 1;
+	else if (!strcmp(s, "gpio-ro"))
+		m5_p2_mode = 2;
+	else
+		pr_err("m5: page2: '%s' refused (zero|gpio-ro)\n", s);
+	return 1;
+}
+__setup("m5_mtp_page2=", m5_mtp_page2_setup);
+
+/* FT16: opt-in aurora T6050 early-AP RTKit ordering for the MTP (default off) */
+static bool m5_early_ap;
+static int __init m5_mtp_early_ap_setup(char *s)
+{
+	m5_early_ap = !strcmp(s, "1");
+	return 1;
+}
+__setup("m5_mtp_early_ap=", m5_mtp_early_ap_setup);
+
+static bool m5_zp_is_mtp(struct device *dev)
+{
+	struct resource *asc = platform_get_resource_byname(to_platform_device(dev), IORESOURCE_MEM, "asc");
+
+	return asc && asc->start == 0x294600000ULL;
+}
+
+static void m5_mtp_zeropage_dump(struct device *dev, const char *tag)
+{
+	unsigned long a;
+	u32 *w;
+	unsigned int i, nz = 0, shown = 0;
+
+	if (!m5_zp_page || !m5_zp_is_mtp(dev))
+		return;
+	w = page_address(m5_zp_page);
+	a = (unsigned long)w;
+	dcache_inval_poc(a, a + PAGE_SIZE);
+	for (i = 0; i < PAGE_SIZE / 4; i++)
+		nz += w[i] != 0;
+	dev_info(dev, "m5: zeropage[%s]: head %32phN; non-zero u32 words: %u\n", tag, w, nz);
+	for (i = 0; i < PAGE_SIZE / 4 && shown < 16; i++)
+		if (w[i]) {
+			dev_info(dev, "m5: zeropage[%s]: +%#x = %#010x\n", tag, i * 4, w[i]);
+			shown++;
+		}
+	if (!m5_p2_page)
+		return;
+	w = page_address(m5_p2_page);
+	a = (unsigned long)w;
+	dcache_inval_poc(a, a + PAGE_SIZE);
+	for (i = 0, nz = 0, shown = 0; i < PAGE_SIZE / 4; i++)
+		nz += w[i] != 0;
+	dev_info(dev, "m5: page2[%s]: +0x40 %16phN; non-zero u32 words: %u\n", tag, (u8 *)w + 0x40, nz);
+	for (i = 0; i < PAGE_SIZE / 4 && shown < 16; i++)
+		if (w[i]) {
+			dev_info(dev, "m5: page2[%s]: +%#x = %#010x\n", tag, i * 4, w[i]);
+			shown++;
+		}
+}
+
+static void m5_mtp_page2_map(struct device *dev, struct iommu_domain *dom)
+{
+	phys_addr_t want, cur;
+	int ret, prot;
+
+	if (!m5_p2_mode)
+		return;
+	if (m5_p2_mode == 1) {
+		if (!m5_p2_page) {
+			m5_p2_page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+			if (!m5_p2_page) {
+				dev_err(dev, "m5: page2: alloc failed\n");
+				return;
+			}
+			dcache_clean_inval_poc((unsigned long)page_address(m5_p2_page),
+					       (unsigned long)page_address(m5_p2_page) + PAGE_SIZE);
+		}
+		want = page_to_phys(m5_p2_page);
+		prot = IOMMU_READ | (m5_zp_rw ? IOMMU_WRITE : 0);
+	} else {
+		want = M5_P2_IOVA;	/* identity, read-only MMIO */
+		prot = IOMMU_READ | IOMMU_MMIO;
+	}
+	cur = iommu_iova_to_phys(dom, M5_P2_IOVA);
+	if (cur == want) {
+		dev_info(dev, "m5: page2: iova %#lx already -> %pa\n", M5_P2_IOVA, &cur);
+		return;
+	}
+	if (cur) {
+		dev_err(dev, "m5: page2: iova %#lx already maps %pa: refused\n", M5_P2_IOVA, &cur);
+		return;
+	}
+	ret = iommu_map(dom, M5_P2_IOVA, want, PAGE_SIZE, prot, GFP_KERNEL);
+	cur = iommu_iova_to_phys(dom, M5_P2_IOVA);
+	dev_info(dev, "m5: page2 (%s): iommu_map(iova %#lx, %#lx bytes, %s%s) = %d; now -> %pa\n",
+		 m5_p2_mode == 1 ? "zero RAM" : "gpio identity", M5_P2_IOVA, PAGE_SIZE,
+		 prot & IOMMU_WRITE ? "READ|WRITE" : "READ", m5_p2_mode == 2 ? "|MMIO" : "", ret, &cur);
+}
+
+/*
+ * FT14-DAPF (opt-in m5_mtp_dapf=adt; default off): the FAITHFUL replacement for the two RAM pages.
+ * 1. Program the MTP DART's DAPF bank (ADT dart-mtp reg[1] = 0x2_94810000, 0x4000) with the ADT
+ *    "dapf-instance-0" records exactly as m1n1 dapf_init_t8110a() does (AsahiLinux/m1n1 70757dc7 src/dapf.c
+ *    :70-82, GPL-2.0-or-later; called for /arm-io/dart-mtp index 1 by dapf_init_all() :172-196 from kboot.c:3124).
+ *    Per record i at base + 0x40*i: +0x04 = r4, +0x08 = start (64), +0x10 = end (64), +0x00 = r0, +0x20 = r20.
+ *    Values: J714s ADT (reports/04-j714s-full.txt:518), 5 x 52-byte t8110a records, all r4 0 / r0 0x31 / r20 1.
+ * 2. Read every programmed field back; ANY mismatch -> nothing is mapped (fail closed) and the caller keeps the
+ *    RAM-page fallback (m5_mtp_zeropage/page2) unchanged.
+ * 3. Only then identity-map (IOVA == PA, IOMMU_READ|IOMMU_WRITE|IOMMU_MMIO) exactly the two 16K pages the
+ *    firmware is known to use (DAPF windows 0 and 2): 0x2_8830c000, 0x2_881e4000 (aura dt_reserve_t8132_aop_windows
+ *    model: firmware reaches its DAPF windows at their physical addresses). Never SID bypass, never DRAM.
+ * Before the first RUN only (same hook as the RAM pages). UNPROVEN: that EL1 may write the DAPF bank (a write
+ * could also fault); that T6050 enforces DAPF (TCR 0x9: translate + 4-level, no bypass bits). Not assumed.
+ */
+static bool m5_dapf_adt;
+static int __init m5_mtp_dapf_setup(char *s)
+{
+	m5_dapf_adt = !strcmp(s, "adt");
+	if (!m5_dapf_adt)
+		pr_err("m5: m5_mtp_dapf=%s refused (adt)\n", s);
+	return 1;
+}
+__setup("m5_mtp_dapf=", m5_mtp_dapf_setup);
+
+#define M5_DAPF_BANK	0x294810000UL
+static const struct { u64 start, end; } m5_dapf_rec[5] = {
+	{0x28830c000ULL, 0x28830c07fULL}, {0x288320900ULL, 0x288320b1bULL}, {0x2881e4050ULL, 0x2881e4053ULL},
+	{0x288360100ULL, 0x28836010bULL}, {0x288f00014ULL, 0x288f00017ULL},
+};
+#define M5_DAPF_R0	0x31	/* (r0_hi << 4) | r0_lo = (3 << 4) | 1 */
+#define M5_DAPF_R4	0
+#define M5_DAPF_R20	1
+static const unsigned long m5_dapf_pages[2] = {0x28830c000UL, 0x2881e4000UL};
+
+static void m5_dapf_dump(struct device *dev, void __iomem *b, const char *tag)
+{
+	for (int i = 0; i < 5; i++) {
+		void __iomem *r = b + 0x40 * i;
+
+		dev_info(dev, "m5: dapf[%s] %d: +0 %#x +4 %#x +8 %#llx +10 %#llx +20 %#x\n", tag, i, readl(r),
+			 readl(r + 4), readq(r + 8), readq(r + 0x10), readl(r + 0x20));
+	}
+}
+
+/*
+ * Result: M5_DAPF_OK    = DAPF verified AND both identity pages present (RAM pages must NOT be mapped);
+ *         M5_DAPF_RAM   = nothing of ours left mapped, IOVAs clean: the caller may map the RAM fallback;
+ *         M5_DAPF_ABORT = a foreign mapping, or our own cleanup could not be verified: map NOTHING more.
+ * FT14-r2: only pages this call mapped (mine[]) are ever unmapped; a pre-existing identity is used, never removed.
+ */
+enum { M5_DAPF_OK, M5_DAPF_RAM, M5_DAPF_ABORT };
+/*
+ * FT14-r3 (review B1/B2), after aura dapf_program_t8132() (aurora-silicon/aura 077aabec src/dapf.c :162-169 put
+ * order, :195-250 program/verify/restore; file SPDX MIT AND GPL-2.0-only): "The low two bits of an end and all but
+ * the low byte of r0 do not read back" -> compare end & ~3 and r0 & 0xff, r4/start/r20 exactly; "On any mismatch,
+ * every slice gets its previous values back". Our restore is also VERIFIED with the same masks.
+ */
+struct m5_dapf_slice { u64 start, end; u32 r0, r4, r20; };
+
+static void m5_dapf_put(void __iomem *r, const struct m5_dapf_slice *v)
+{
+	writel(v->r4, r + 0x04);
+	writeq(v->start, r + 0x08);
+	writeq(v->end, r + 0x10);
+	writel(v->r0, r + 0x00);
+	writel(v->r20, r + 0x20);
+}
+
+static bool m5_dapf_match(void __iomem *r, const struct m5_dapf_slice *v)
+{
+	return readl(r + 0x04) == v->r4 && readq(r + 0x08) == v->start &&
+	       (readq(r + 0x10) & ~3ULL) == (v->end & ~3ULL) && (readl(r) & 0xff) == (v->r0 & 0xff) &&
+	       readl(r + 0x20) == v->r20;
+}
+
+/* put every snapshotted slice back and verify it; false = the bank state is unknown */
+static bool m5_dapf_restore(struct device *dev, void __iomem *b, const struct m5_dapf_slice *had)
+{
+	bool ok = true;
+	int i;
+
+	for (i = 0; i < 5; i++)
+		m5_dapf_put(b + 0x40 * i, &had[i]);
+	for (i = 0; i < 5; i++)
+		if (!m5_dapf_match(b + 0x40 * i, &had[i])) {
+			dev_err(dev, "m5: dapf: slice %d restore did NOT verify\n", i);
+			ok = false;
+		}
+	m5_dapf_dump(dev, b, ok ? "restored" : "restore-FAILED");
+	return ok;
+}
+
+static int m5_mtp_dapf_map(struct device *dev, struct iommu_domain *dom)
+{
+	void __iomem *b;
+	struct m5_dapf_slice had[5], want;
+	bool ok = true;
+	bool mine[2] = { false, false };
+	int i, ret, res = M5_DAPF_OK;
+
+	b = ioremap(M5_DAPF_BANK, 0x4000);
+	if (!b) {
+		dev_err(dev, "m5: dapf: ioremap failed: RAM fallback\n");
+		return M5_DAPF_RAM;
+	}
+	m5_dapf_dump(dev, b, "pre");
+	for (i = 0; i < 5; i++) {	/* snapshot BEFORE any write */
+		void __iomem *r = b + 0x40 * i;
+
+		had[i] = (struct m5_dapf_slice){ .start = readq(r + 0x08), .end = readq(r + 0x10),
+			.r0 = readl(r), .r4 = readl(r + 0x04), .r20 = readl(r + 0x20) };
+	}
+	for (i = 0; i < 5; i++) {	/* m1n1 dapf_init_t8110a / aura dapf_t8132_put order */
+		want = (struct m5_dapf_slice){ m5_dapf_rec[i].start, m5_dapf_rec[i].end, M5_DAPF_R0, M5_DAPF_R4,
+					       M5_DAPF_R20 };
+		m5_dapf_put(b + 0x40 * i, &want);
+	}
+	for (i = 0; i < 5; i++) {
+		want = (struct m5_dapf_slice){ m5_dapf_rec[i].start, m5_dapf_rec[i].end, M5_DAPF_R0, M5_DAPF_R4,
+					       M5_DAPF_R20 };
+		if (!m5_dapf_match(b + 0x40 * i, &want)) {
+			dev_err(dev, "m5: dapf: record %d readback MISMATCH (masked compare)\n", i);
+			ok = false;
+		}
+	}
+	m5_dapf_dump(dev, b, "post");
+	if (!ok) {
+		res = m5_dapf_restore(dev, b, had) ? M5_DAPF_RAM : M5_DAPF_ABORT;
+		iounmap(b);
+		dev_err(dev, "m5: dapf: verification failed: NO identity mapping; %s\n",
+			res == M5_DAPF_RAM ? "previous DAPF restored (verified), RAM fallback" :
+					     "restore NOT verified: ABORT (no RAM fallback)");
+		return res;
+	}
+	for (i = 0; i < 2 && res == M5_DAPF_OK; i++) {
+		phys_addr_t cur = iommu_iova_to_phys(dom, m5_dapf_pages[i]);
+
+		if (cur == m5_dapf_pages[i]) {	/* pre-existing identity (rebind): use it, never remove it */
+			dev_info(dev, "m5: dapf: iova %#lx already identity (not ours)\n", m5_dapf_pages[i]);
+			continue;
+		}
+		if (cur) {
+			dev_err(dev, "m5: dapf: iova %#lx already maps %pa (foreign): ABORT, nothing more mapped\n",
+				m5_dapf_pages[i], &cur);
+			res = M5_DAPF_ABORT;
+			break;
+		}
+		ret = iommu_map(dom, m5_dapf_pages[i], m5_dapf_pages[i], PAGE_SIZE,
+				IOMMU_READ | IOMMU_WRITE | IOMMU_MMIO, GFP_KERNEL);
+		cur = iommu_iova_to_phys(dom, m5_dapf_pages[i]);
+		dev_info(dev, "m5: dapf: identity map %#lx (16K, READ|WRITE|MMIO) = %d -> %pa\n", m5_dapf_pages[i],
+			 ret, &cur);
+		if (cur)		/* whatever is there now was installed by this call: we own it */
+			mine[i] = true;
+		if (ret || cur != m5_dapf_pages[i])
+			res = M5_DAPF_RAM;	/* undo below (including this slot) */
+	}
+	if (res == M5_DAPF_OK) {
+		iounmap(b);
+		return M5_DAPF_OK;
+	}
+	for (i = 0; i < 2; i++) {	/* undo ONLY our own mappings, and verify each */
+		size_t un;
+
+		if (!mine[i])
+			continue;
+		un = iommu_unmap(dom, m5_dapf_pages[i], PAGE_SIZE);
+		if (un != PAGE_SIZE || iommu_iova_to_phys(dom, m5_dapf_pages[i])) {
+			dev_err(dev, "m5: dapf: unmap %#lx = %zu, still -> %pa: cleanup NOT verified: ABORT\n",
+				m5_dapf_pages[i], un, &(phys_addr_t){ iommu_iova_to_phys(dom, m5_dapf_pages[i]) });
+			res = M5_DAPF_ABORT;
+		} else {
+			dev_info(dev, "m5: dapf: unmapped our %#lx (verified)\n", m5_dapf_pages[i]);
+		}
+	}
+	if (res == M5_DAPF_RAM && !m5_dapf_restore(dev, b, had))	/* falling back: previous DAPF back */
+		res = M5_DAPF_ABORT;
+	iounmap(b);
+	dev_err(dev, "m5: dapf: identity mapping incomplete: %s\n",
+		res == M5_DAPF_ABORT ? "ABORT (no RAM fallback)" : "own mappings undone, DAPF restored, RAM fallback");
+	return res;
+}
+
+static void m5_mtp_zeropage_map(struct device *dev)
+{
+	struct iommu_domain *dom;
+	phys_addr_t cur;
+	int ret;
+
+	struct resource *asc;
+
+	if (!m5_zp_iova)
+		return;
+	/* Only the MTP: its "asc" MEM resource starts at 0x294600000. Any other rtk-helper device is left alone. */
+	asc = platform_get_resource_byname(to_platform_device(dev), IORESOURCE_MEM, "asc");
+	if (!asc || asc->start != 0x294600000ULL) {
+		dev_info(dev, "m5: zeropage: not the MTP (asc %pa): skipped\n", asc ? &asc->start : NULL);
+		return;
+	}
+	if (m5_zp_iova != 0x28830c000UL || !IS_ALIGNED(m5_zp_iova, PAGE_SIZE)) {
+		dev_err(dev, "m5: zeropage: iova %#lx refused (only 0x28830c000)\n", m5_zp_iova);
+		return;
+	}
+	dom = iommu_get_domain_for_dev(dev);
+	if (!dom || !(dom->type & __IOMMU_DOMAIN_PAGING)) {
+		dev_err(dev, "m5: zeropage: no translated domain (type %#x): not mapped\n", dom ? dom->type : 0);
+		return;
+	}
+	if (!(dom->pgsize_bitmap & PAGE_SIZE)) {
+		dev_err(dev, "m5: zeropage: domain pgsize %#lx lacks %#lx: not mapped\n", dom->pgsize_bitmap, PAGE_SIZE);
+		return;
+	}
+	if (m5_dapf_adt) {	/* FT14: the faithful path replaces both RAM pages */
+		int r = m5_mtp_dapf_map(dev, dom);
+
+		if (r == M5_DAPF_OK) {
+			dev_info(dev, "m5: dapf: faithful DAPF + identity MMIO active: RAM pages NOT mapped\n");
+			return;
+		}
+		if (r == M5_DAPF_ABORT) {
+			dev_err(dev, "m5: dapf: ABORT: RAM pages NOT mapped over a foreign/unverified mapping\n");
+			return;
+		}
+	}
+	if (!m5_zp_page) {
+		m5_zp_page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+		if (!m5_zp_page) {
+			dev_err(dev, "m5: zeropage: alloc failed\n");
+			return;
+		}
+		/* non-coherent device: push the zeros to PoC before the device can see the page */
+		dcache_clean_inval_poc((unsigned long)page_address(m5_zp_page),
+				       (unsigned long)page_address(m5_zp_page) + PAGE_SIZE);
+	}
+	cur = iommu_iova_to_phys(dom, m5_zp_iova);
+	if (cur == page_to_phys(m5_zp_page)) {
+		dev_info(dev, "m5: zeropage: iova %#lx already -> %pa (our zero page)\n", m5_zp_iova, &cur);
+		m5_mtp_page2_map(dev, dom);	/* FT4: page 2 only alongside a mapped page 1 */
+		return;
+	}
+	if (cur) {
+		dev_err(dev, "m5: zeropage: iova %#lx already maps %pa: refused\n", m5_zp_iova, &cur);
+		return;
+	}
+	ret = iommu_map(dom, m5_zp_iova, page_to_phys(m5_zp_page), PAGE_SIZE,
+			IOMMU_READ | (m5_zp_rw ? IOMMU_WRITE : 0), GFP_KERNEL);
+	cur = iommu_iova_to_phys(dom, m5_zp_iova);
+	dev_info(dev, "m5: zeropage: iommu_map(iova %#lx, %#lx bytes, %s) = %d; now -> %pa\n",
+		 m5_zp_iova, PAGE_SIZE, m5_zp_rw ? "READ|WRITE" : "READ", ret, &cur);
+	if (!ret)
+		m5_mtp_page2_map(dev, dom);	/* FT4: page 2 only alongside a mapped page 1 */
+}
+
+/* FT9 (opt-in m5_mtp_pin20=high): before the first MTP RUN, drive nub-gpio pin 20 DATA high exactly as the
+ * reviewed m5_nubgpio_set op=raise did natively (PS 0x2ff, pin 0x76a02 -> 0x76a03, "IPD HIDSPI attached").
+ * Gates: MTP instance (asc 0x294600000), CPU not running (first RUN), NUB_GPIO PS ACTUAL == 0xf, pin word
+ * exactly 0x00076a02 (write 0x00076a03, only bit 0 differs) or exactly 0x00076a03 (no-op). Anything else: no write.
+ * Fields: pinctrl-apple-gpio.c:45-66, pmgr-pwrstate.c:20-36. PMGR is only read. */
+#define M5_NUBGPIO_PS_PA	0x288300088UL
+#define M5_PIN20_PA		0x2881e4050UL
+#define M5_PIN20_LOW		0x00076a02U
+#define M5_PIN20_HIGH		0x00076a03U
+static bool m5_pin20_high;
+static int __init m5_mtp_pin20_setup(char *s)
+{
+	if (!strcmp(s, "high"))
+		m5_pin20_high = true;
+	else
+		pr_err("m5: pin20: '%s' refused (high)\n", s);
+	return 1;
+}
+__setup("m5_mtp_pin20=", m5_mtp_pin20_setup);
+
+static void m5_mtp_pin20_prerun(struct device *dev, bool was_running)
+{
+	void __iomem *p;
+	u32 ps, cur, rb;
+
+	if (!m5_pin20_high)
+		return;
+	if (!m5_zp_is_mtp(dev) || was_running) {
+		dev_info(dev, "m5: pin20: skipped (%s): nothing written\n",
+			 was_running ? "CPU already RUN" : "not the MTP");
+		return;
+	}
+	p = ioremap(M5_NUBGPIO_PS_PA, 4);
+	if (!p)
+		return;
+	ps = readl(p);
+	iounmap(p);
+	if (FIELD_GET(GENMASK(7, 4), ps) != 0xf) {
+		dev_info(dev, "m5: pin20: PS %#010x actual != 0xf: nothing written\n", ps);
+		return;
+	}
+	p = ioremap(M5_PIN20_PA, 4);
+	if (!p)
+		return;
+	cur = readl(p);
+	if (cur == M5_PIN20_HIGH) {
+		dev_info(dev, "m5: pin20: PS %#010x; pin20 already %#010x (high): no-op\n", ps, cur);
+	} else if (cur != M5_PIN20_LOW) {
+		dev_info(dev, "m5: pin20: PS %#010x; pin20 %#010x, expected exactly %#010x: nothing written\n",
+			 ps, cur, M5_PIN20_LOW);
+	} else {
+		writel(M5_PIN20_HIGH, p);	/* only DATA (bit 0) differs */
+		rb = readl(p);
+		dev_info(dev, "m5: pin20: PS %#010x; pin20 original %#010x -> wrote %#010x, readback %#010x (%s)\n",
+			 ps, cur, M5_PIN20_HIGH, rb, rb == M5_PIN20_HIGH ? "ok" : "MISMATCH");
+	}
+	iounmap(p);
+}
+
