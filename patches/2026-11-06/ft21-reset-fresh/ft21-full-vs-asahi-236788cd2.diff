diff --git c/arch/arm64/boot/dts/apple/t6050-j714s-m5.dtsi i/arch/arm64/boot/dts/apple/t6050-j714s-m5.dtsi
new file mode 100644
index 000000000..dfe6254db
--- /dev/null
+++ i/arch/arm64/boot/dts/apple/t6050-j714s-m5.dtsi
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * m5-omarchy first-boot overrides for J714s, variant I3W (task 33; = I3 + wdt enabled). Included last by t6050-j714s.dts.
+ * NATIVE gz5: SError right after the MTP DART probe returned (the next DART to probe was
+ * dwc3_0_dart_0 @ 0x2a2f00000; the SError regs held x0 = 0x2a2f0000).
+ */
+
+/* 1. MTP (keyboard/trackpad over DockChannel) and its DART: off until DAPF is understood. */
+&mtp { status = "disabled"; };
+&mtp_mbox { status = "disabled"; };
+&mtp_dart { status = "disabled"; };
+&mtp_dockchannel { status = "disabled"; };
+&mtp_hid { status = "disabled"; };
+
+/* 2. Only the gadget port stays: dwc3_0 = ADT usb-drd0 = Port-USB-C@1 (left-back, by MagSafe).
+ *    Its DARTs and the controller had no power-domains; ADT dart-usb0 has clock-gates, so a register
+ *    access with ATC0 USB gated off would SError. Bind them to ps_atc0_usb (as Asahi t600x DTs do). */
+&dwc3_0 { power-domains = <&ps_atc0_usb>; };
+&dwc3_0_dart_0 { power-domains = <&ps_atc0_usb>; };
+&dwc3_0_dart_1 { power-domains = <&ps_atc0_usb>; };
+
+&dwc3_1 { status = "disabled"; };
+&dwc3_1_dart_0 { status = "disabled"; };
+&dwc3_1_dart_1 { status = "disabled"; };
+&dwc3_2 { status = "disabled"; };
+&dwc3_2_dart_0 { status = "disabled"; };
+&dwc3_2_dart_1 { status = "disabled"; };
+
+/* 3. (task 25 addendum) Visible console after the initcalls: a static simple-framebuffer, so simpledrm +
+ *    fbcon bind even if the loader doesn't fill/enable this node. Values: the J714s 24 GB panel as m5boot
+ *    and the ADT report it (base 0x105d3110000, 3024x1964, stride 12096, x2r10g10b10). m5boot may
+ *    overwrite reg/size/format with its runtime values. No power-domains: the display is live from iBoot
+ *    and pd_ignore_unused keeps it on (adding disp domains = PMGR writes, see gz6). */
+&framebuffer0 {
+	reg = <0x105 0xd3110000 0x0 0x16a8000>;		/* 12096 * 1964 */
+	width = <3024>;
+	height = <1964>;
+	stride = <12096>;
+	format = "x2r10g10b10";
+	status = "okay";
+};
+
+/* 4. Variant C (task 26): nothing that probes late or isn't needed for shell + NVMe. gz6 reset ~45 s after
+ *    the initcalls, around the deferred-probe timeouts and "sync_state() pending (pinctrl)" lines. */
+&dwc3_0 { status = "disabled"; };
+&dwc3_0_dart_0 { status = "disabled"; };
+&dwc3_0_dart_1 { status = "disabled"; };
+&pinctrl_nub { status = "disabled"; };
+&pinctrl_aop { status = "disabled"; };
+&pinctrl_ap { status = "disabled"; };
+&serial0 { status = "disabled"; };
+&wdt { status = "disabled"; };
+
+/* 5. Variant I1 (task 28): internal keyboard/trackpad back on. USB DARTs stay off (DTB C), which removes the
+ *    gz5 SError's other suspect (an unpowered USB0 DART read; third-party report: ATC0 USB is off at hand-off).
+ *    The MTP has no PMGR domain (ADT) and iBoot preloads its firmware (pre-loaded = 1). DAPF is not
+ *    programmed by Linux: see report 28. Trackpad firmware apple/tpmtfw-j714s.bin is in the initramfs + rootfs. */
+&mtp { status = "okay"; };
+&mtp_mbox { status = "okay"; };
+&mtp_dart { status = "okay"; };
+&mtp_dockchannel { status = "okay"; };
+&mtp_hid { status = "okay"; };
+
+/* 7. Variant I3 (task 31): describe the iBoot-preloaded MTP firmware to Linux.
+ *    From the ADT (/arm-io/mtp and iop-mtp-nub "segment-ranges", 3 x 32-byte entries {u64 phys, u64 iova,
+ *    u64 remap, u32 size, u32 flags}; names from "segment-names"):
+ *      __TEXT   phys 0x294c00000  iova 0x1000000  size 0x54000 (MTP SRAM)
+ *      __DATA   phys 0x294c54000  iova 0x1054000  size 0x6c000 (MTP SRAM)
+ *      __OS_LOG phys 0x1000ccdc000 iova 0x10c0000 size 0x3000  (DRAM; inside m5boot's carveout reservation)
+ *    Values from our ADT dump (macOS boot); m5boot should verify/replace them from the runtime ADT (report 31).
+ *    Linux turns these into IOMMU_RESV_TRANSLATED regions on the MTP's DART (of_iommu_get_resv_regions()
+ *    via apple_dart_get_resv_regions(); mapped by iommu_create_device_direct_mappings()), so the firmware's
+ *    IOVAs resolve to its preloaded segments after Linux resets the DART at probe. */
+/ {
+	reserved-memory {
+		mtp_fw_text: mtp-text@294c00000 {
+			reg = <0x2 0x94c00000 0x0 0x54000>;
+			iommu-addresses = <&mtp 0x0 0x1000000 0x0 0x54000>;
+			no-map;
+		};
+		mtp_fw_data: mtp-data@294c54000 {
+			reg = <0x2 0x94c54000 0x0 0x6c000>;
+			iommu-addresses = <&mtp 0x0 0x1054000 0x0 0x6c000>;
+			no-map;
+		};
+		mtp_fw_oslog: mtp-oslog@1000ccdc000 {
+			reg = <0x100 0x0ccdc000 0x0 0x3000>;
+			iommu-addresses = <&mtp 0x0 0x10c0000 0x0 0x3000>;
+			no-map;
+		};
+	};
+};
+
+&mtp {
+	memory-region = <&mtp_fw_text>, <&mtp_fw_data>, <&mtp_fw_oslog>;
+	memory-region-names = "mtp-text", "mtp-data", "mtp-oslog";
+};
+
+/* 8. Variant I3W (task 33): I3 + the main watchdog enabled (apple_wdt: /dev/watchdog, restart handler). */
+&wdt { status = "okay"; };
+
+/* 9. Variant U2 (task 43): I3W + USB0 gadget power. Needs cmdline
+ *    m5_pmgr_ro m5_pmgr_allow=atc0_common,atc0_usb_aon,atc0_usb,atc0_phymxwrap (only these PMGR writes).
+ *    The ps_atc0_* nodes are disabled in t6050-storage-net.dtsi (betizzel/m1n1 hand-off); re-enable them.
+ *    The DARTs bind at boot and hold the domains on: dart_0 -> atc0_usb (+ parents common/usb_aon via genpd),
+ *    dart_1 -> atc0_phymxwrap (PIPE-mux wrapper, ponytail: one domain per node, until a PHY node exists).
+ *    dwc3_0 stays peripheral. Its boot-time probe is expected to fail (-110, no PHY yet). The m5_usb module
+ *    then brings up the eUSB2 PHY, sets PIPE to the dummy PHY, releases DWC3 reset, and m5-exp rebinds dwc3. */
+&ps_atc0_common { status = "okay"; };
+&ps_atc0_usb_aon { status = "okay"; };
+&ps_atc0_usb { status = "okay"; };
+&ps_atc0_phymxwrap { status = "okay"; };
+&dwc3_0 { status = "okay"; power-domains = <&ps_atc0_usb>; };
+&dwc3_0_dart_0 { status = "okay"; power-domains = <&ps_atc0_usb>; };
+&dwc3_0_dart_1 { status = "okay"; power-domains = <&ps_atc0_phymxwrap>; };
diff --git c/arch/arm64/boot/dts/apple/t6050-j714s.dts i/arch/arm64/boot/dts/apple/t6050-j714s.dts
