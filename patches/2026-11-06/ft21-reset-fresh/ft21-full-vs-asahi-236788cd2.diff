+ * m5_smcnode (FT12-AFE, built-in): create /soc/mbox@28c608000 + /soc/smc@28c600000 in the live DT at late_initcall
+ * so the (m5 S2, write-gated) macsmc binds before the rootfs opens the MTP. Opt-in: m5_smc=1 on the cmdline.
+ * Body = do_smc() of build/codex-ft8-smc/mod-dtadd/m5_dtadd.c (reviewed; NATIVE S1 on FT9 and FT10) unchanged.
+ * Node values: aurora-silicon/linux t6050-die0.dtsi (GPL-2.0+ OR MIT) and our ADT.
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+
+static bool m5_smc;
+static int __init m5_smc_setup(char *s)
+{
+	m5_smc = !strcmp(s, "1");
+	return 1;
+}
+__setup("m5_smc=", m5_smc_setup);
+
+#define L(fmt, ...) pr_info("m5_smcnode: " fmt "\n", ##__VA_ARGS__)
+
+static struct platform_device *mkdev(struct device_node *np)
+{
+	struct platform_device *pd = of_find_device_by_node(np), *par;
+
+	if (pd)
+		return pd;
+	par = np->parent ? of_find_device_by_node(np->parent) : NULL;
+	pd = of_platform_device_create(np, NULL, par ? &par->dev : NULL);
+	L("platform device for %pOF: %s", np, pd ? dev_name(&pd->dev) : "FAILED");
+	return pd;
+}
+
+static int do_smc(void)
+{
+	struct device_node *soc = of_find_node_by_path("/soc");
+	struct device_node *aic = of_find_node_by_path("/soc/interrupt-controller@280400000");
+	struct device_node *mb, *smc;
+	struct of_changeset cs, cs2;
+	u32 mbph = 0x7e00;	/* new phandle, checked unused below */
+	int ret = 0;
+
+	if (!soc || !aic)
+		return -ENODEV;
+	if (of_find_node_by_path("/soc/smc@28c600000")) {
+		L("smc node already present");
+		return -EEXIST;
+	}
+	while (of_find_node_by_phandle(mbph))
+		mbph++;
+	/*
+	 * FT12-r2 fix (FT12 NATIVE: at boot the SMC probed from the apply notifier with "mboxes" 0x7e00 unresolved,
+	 * -EINVAL). __of_attach_node() (drivers/of/dynamic.c :225-233) sets np->phandle from a "phandle" property
+	 * that is not yet on the node at attach time (property entries follow the attach entry), i.e. to 0, and
+	 * of_changeset_apply() then notifies -> platform devices are created and probed at once. So: changeset 1 =
+	 * the mailbox only; then set mb->phandle; then changeset 2 = the SMC node, whose probe now resolves it.
+	 */
+	of_changeset_init(&cs);
+	mb = of_changeset_create_node(&cs, soc, "mbox@28c608000");
+	if (!mb) {
+		of_changeset_destroy(&cs);
+		return -ENOMEM;
+	}
+	ret = of_changeset_add_prop_string_array(&cs, mb, "compatible",
+		(const char *[]){ "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4" }, 2);
+	ret = ret ?: of_changeset_add_prop_u32_array(&cs, mb, "reg", (u32 []){ 0x2, 0x8c608000, 0x0, 0x4000 }, 4);
+	ret = ret ?: of_changeset_add_prop_u32(&cs, mb, "interrupt-parent", aic->phandle);
+	ret = ret ?: of_changeset_add_prop_u32_array(&cs, mb, "interrupts",
+		(u32 []){ 0, 899, 4, 0, 900, 4, 0, 901, 4, 0, 902, 4 }, 12);
+	ret = ret ?: of_changeset_add_prop_string_array(&cs, mb, "interrupt-names",
+		(const char *[]){ "send-empty", "send-not-empty", "recv-empty", "recv-not-empty" }, 4);
+	ret = ret ?: of_changeset_add_prop_u32(&cs, mb, "#mbox-cells", 0);
+	ret = ret ?: of_changeset_add_prop_u32(&cs, mb, "phandle", mbph);
+	ret = ret ?: of_changeset_apply(&cs);
+	L("mbox changeset (phandle 0x%x, aic 0x%x): %d", mbph, aic->phandle, ret);
+	if (ret)
+		return ret;
+	mb->phandle = mbph;	/* of_changeset does not set np->phandle from the property */
+	if (!mkdev(mb))
+		return -ENODEV;
+
+	of_changeset_init(&cs2);
+	smc = of_changeset_create_node(&cs2, soc, "smc@28c600000");
+	if (!smc) {
+		of_changeset_destroy(&cs2);
+		return -ENOMEM;
+	}
+	ret = of_changeset_add_prop_string_array(&cs2, smc, "compatible",
+		(const char *[]){ "apple,t6050-smc", "apple,smc" }, 2);
+	ret = ret ?: of_changeset_add_prop_u32_array(&cs2, smc, "reg",
+		(u32 []){ 0x2, 0x8c600000, 0x0, 0x4000, 0x2, 0x8de00000, 0x0, 0x140000 }, 8);
+	ret = ret ?: of_changeset_add_prop_string_array(&cs2, smc, "reg-names", (const char *[]){ "smc", "sram" }, 2);
+	ret = ret ?: of_changeset_add_prop_u32(&cs2, smc, "mboxes", mbph);
+	ret = ret ?: of_changeset_apply(&cs2);
+	{
+		struct device_node *chk = of_find_node_by_phandle(mbph);
+
+		L("smc changeset (mboxes 0x%x -> %pOF): %d", mbph, chk, ret);
+		of_node_put(chk);
+	}
+	if (ret)
+		return ret;
+	return mkdev(smc) ? 0 : -ENODEV;
+}
+
+static int __init m5_smcnode_init(void)
+{
+	int ret;
+
+	if (!m5_smc)
+		return 0;
+	ret = do_smc();
+	L("m5_smc=1: smc/mbox nodes: %d", ret);
+	return 0;
+}
+late_initcall(m5_smcnode_init);
