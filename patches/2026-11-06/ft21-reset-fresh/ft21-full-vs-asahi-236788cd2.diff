+/*
+ * FT16 (m5, opt-in via rtkit-helper m5_mtp_early_ap=1; the default wake/boot path above is unchanged):
+ * T6050 MTP "early AP" ordering, ported from aurora-silicon linux (edimoldovan/linux-aurora c5b0600d,
+ * drivers/soc/apple/rtkit.c :1374-1432 apple_rtkit_boot_common(early_ap_power=true) and :1534-1554
+ * apple_rtkit_wake_common(); file SPDX GPL-2.0-only OR MIT): same INIT message as apple_rtkit_wake(), then
+ * after endpoint discovery send AP power ON and wait for its ACK BEFORE waiting for the IOP power ACK
+ * ("Some helpers need AP readiness before acknowledging IOP power"), then on T6050 wait (max 10 ACKs) until
+ * the IOP reports ON. This is the fresh-start path aurora uses on a CPU it just set RUN (no handoff), i.e. the
+ * same situation as ours (CPU stopped at probe, then RUN). Waits use our m5_rtkit_timeout_ms (no new timeouts).
+ * dev_info lines make the order and the failing step visible.
+ */
+int apple_rtkit_wake_early_ap(struct apple_rtkit *rtk)
+{
+	u64 msg;
+	int ret, tries = 10;
+
+	if (apple_rtkit_is_running(rtk))
+		return -EINVAL;
+	if (rtk->crashed)
+		return -EINVAL;
+	reinit_completion(&rtk->iop_pwr_ack_completion);
+	msg = FIELD_PREP(APPLE_RTKIT_MGMT_PWR_STATE, APPLE_RTKIT_PWR_STATE_INIT);
+	ret = apple_rtkit_management_send(rtk, APPLE_RTKIT_MGMT_SET_IOP_PWR_STATE, msg);
+	if (ret)
+		return ret;
+
+	ret = apple_rtkit_wait_for_completion(&rtk->epmap_completion);
+	if (ret) {
+		dev_err(rtk->dev, "m5: early-AP: endpoint discovery failed: %d\n", ret);
+		return ret;
+	}
+	if (rtk->boot_result)
+		return rtk->boot_result;
+
+	dev_info(rtk->dev, "m5: early-AP: AP power ON before IOP ACK (IOP state now 0x%x)\n", rtk->iop_power_state);
+	ret = apple_rtkit_set_ap_power_state(rtk, APPLE_RTKIT_PWR_STATE_ON);
+	if (ret) {
+		dev_err(rtk->dev, "m5: early-AP: AP readiness failed: %d (AP state 0x%x)\n", ret, rtk->ap_power_state);
+		return ret;
+	}
+	dev_info(rtk->dev, "m5: early-AP: AP ON acked (0x%x); waiting for IOP ACK\n", rtk->ap_power_state);
+
+	ret = apple_rtkit_wait_for_completion(&rtk->iop_pwr_ack_completion);
+	if (ret) {
+		dev_err(rtk->dev, "m5: early-AP: IOP power ACK failed: %d (IOP state 0x%x)\n", ret, rtk->iop_power_state);
+		return ret;
+	}
+	while ((rtk->iop_power_state & 0xff) != APPLE_RTKIT_PWR_STATE_ON && tries--) {
+		dev_info(rtk->dev, "m5: early-AP: IOP state 0x%x, waiting for ON\n", rtk->iop_power_state);
+		reinit_completion(&rtk->iop_pwr_ack_completion);
+		if ((rtk->iop_power_state & 0xff) == APPLE_RTKIT_PWR_STATE_ON)
+			break;
+		ret = apple_rtkit_wait_for_completion(&rtk->iop_pwr_ack_completion);
+		if (ret) {
+			dev_err(rtk->dev, "m5: early-AP: IOP never reached ON (state 0x%x): %d\n",
+				rtk->iop_power_state, ret);
+			return ret;
+		}
+	}
+	if ((rtk->iop_power_state & 0xff) != APPLE_RTKIT_PWR_STATE_ON) {
+		dev_err(rtk->dev, "m5: early-AP: IOP not ON after 10 ACKs (0x%x)\n", rtk->iop_power_state);
+		return -ETIME;
+	}
+	dev_info(rtk->dev, "m5: early-AP: done: IOP 0x%x AP 0x%x\n", rtk->iop_power_state, rtk->ap_power_state);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_wake_early_ap);
+
