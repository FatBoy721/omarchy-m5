+static void m5_rx_log(struct dockchannel_hid *dchid, const char *why, const char *who);	/* FT7, defined below */
+
+/*
+ * FT21-RESET-FRESH (m5 test kernel only; touchpad-only variant of FT19; CODEX-FT20-OPERATOR-DESIGN.md and the
+ * corrected CODEX-FT20-RESET-RATIONALE.md; independent review GO-with-changes, all applied):
+ * m5_mt_reset_fresh, a root-writable runtime bool, default 0 (replaces FT19's m5_mt_fresh). When set, the NEXT
+ * normal hid_hw_open() of multi-touch, exactly once, and only if BOTH (no order between them) an observed
+ * firmware reset request {0xa2, 0x01} this boot AND a recorded start timeout:
+ *   1. verifies the host-only first-ACK copy (FNV-1a 64), allocates ONE fresh coherent buffer, fills and
+ *      verifies it (full readback memcmp), rechecks transport/READY;
+ *   2. host AFE reset pulse on SMC pcIO with ONLY the two authorized payloads (m5_afe_write; macsmc gate,
+ *      boot-cmdline budget macsmc.m5_pcio_budget=2): provider lookup -> once-per-boot m5_afe_used ->
+ *      assert 0x011c000000010001 -> 50 ms -> release 0x011c000000010000 (ALWAYS once the assert was sent, i.e.
+ *      unless it returned -EPERM) -> 50 ms settle (operator-selected test bound, not ADT-derived). Any write
+ *      error stops here: no 0x95, no ON, fresh buffer freed (never announced). No PM2 framing around it;
+ *   3. supersedes the old image (never written or freed before a successful MTP stop), CMD_SEND_FIRMWARE with
+ *      the NEW IOVA (ACK required), recheck, then PM2 ON only via m5_pm2_fw_set_power(iface, 2).
+ * No OFF, no SLEEP, no 0x42, no other key/GPIO/PMGR/MTP reset. The one-shot is consumed after the gates and
+ * before any check or command. Runs under hdev->ll_open_lock. Never automatic. Fail closed: otherwise the FT16
+ * -EINPROGRESS latch. Only a positive result is informative (see the design's pre-registered reading).
+ */
+static bool m5_mt_reset_fresh;
+module_param(m5_mt_reset_fresh, bool, 0644);
+MODULE_PARM_DESC(m5_mt_reset_fresh, "m5 FT21: one multi-touch AFE pcIO pulse + fresh-image 0x95 + PM2 ON-only after 0xa2 and a start timeout");
+
+/*
+ * Cross-context: set (WRITE_ONCE, never cleared) by the RX 0xa2 log handler (dchid_packet_work, workqueue) for a
+ * valid 2-byte {0xa2, 0x01}; read (READ_ONCE) by the one-shot under ll_open_lock. It triggers nothing by itself.
+ */
+static bool m5_a2_seen_mt;
+
+/*
+ * FT21 F1 (m5review): the pulse needs exactly 2 macsmc pcIO budget units, otherwise an allowed assert could be
+ * followed by a refused release. The budget is boot-cmdline-only (macsmc.c, 0400, clamped, never replenished),
+ * so require exactly ONE word-bounded "macsmc.m5_pcio_budget=" token on the saved command line, with value "2".
+ */
+static bool m5_budget_is_2(void)
+{
+	static const char tok[] = "macsmc.m5_pcio_budget=";
+	const char *c = saved_command_line, *p, *hit = NULL;
+	int n = 0;
+
+	for (p = c; (p = strstr(p, tok)); p += sizeof(tok) - 1) {
+		if (p != c && p[-1] != ' ')
+			continue;
+		hit = p + sizeof(tok) - 1;
+		n++;
+	}
+	return n == 1 && hit[0] == '2' && (hit[1] == ' ' || hit[1] == '\0');
+}
