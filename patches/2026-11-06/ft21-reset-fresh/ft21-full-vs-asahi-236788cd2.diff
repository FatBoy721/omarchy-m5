+/* Transport up and READY still pending; logs which phase found otherwise. */
+static int m5_mt_fresh_recheck(struct dchid_iface *iface, const char *phase)
+{
+	if (READ_ONCE(iface->dchid->stopping) || READ_ONCE(iface->dchid->failed)) {
+		dev_warn(iface->dchid->dev, "m5: fresh %s: transport stopping/failed %s: nothing more sent\n",
+			 iface->name, phase);
+		return -ESHUTDOWN;
+	}
+	if (completion_done(&iface->ready)) {
+		dev_info(iface->dchid->dev, "m5: fresh %s: READY already arrived %s: nothing more sent\n",
+			 iface->name, phase);
+		return 1;
+	}
+	return 0;
+}
