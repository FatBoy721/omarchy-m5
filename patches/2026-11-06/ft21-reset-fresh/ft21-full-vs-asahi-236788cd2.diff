+	/* FT2 (opt-in, m5_mtp_zeropage=0x28830c000 only): map a zeroed read-only RAM page before the RUN write. */
+	m5_mtp_zeropage_dump(dev, "probe-entry");	/* FT3: state seen by a rebind (no-op on first probe) */
