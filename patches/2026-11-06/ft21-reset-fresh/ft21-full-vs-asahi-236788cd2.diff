+/* FT21: the pulse. Returns 0 only if both writes returned >= 0. */
+static int m5_afe_pulse(struct dchid_iface *iface)
+{
+	struct device *dev = iface->dchid->dev;
+	struct apple_smc *smc = IS_BUILTIN(CONFIG_MFD_MACSMC) ? m5_afe_smc(dev) : NULL;
+	int a, r;
+
+	if (!smc) {
+		dev_err(dev, "m5: reset %s: SMC provider not bound: no pulse\n", iface->name);
+		return -ENODEV;
+	}
+	if (atomic_xchg(&m5_afe_used, 1)) {
+		dev_err(dev, "m5: reset %s: host AFE reset already attempted this boot: no pulse\n", iface->name);
+		return -EALREADY;
+	}
+	dev_info(dev, "m5: reset %s: assert sending\n", iface->name);
+	a = m5_afe_write(iface, smc, true);
+	if (a == -EPERM) {
+		dev_err(dev, "m5: reset %s: assert refused by the macsmc gate (nothing sent): no release\n", iface->name);
+		return a;
+	}
+	if (a >= 0)
+		fsleep(50 * USEC_PER_MSEC);
+	r = m5_afe_write(iface, smc, false);	/* release: always once the assert may have been sent */
+	dev_info(dev, "m5: reset %s: release sent (assert %d release %d)\n", iface->name, a, r);
+	if (a < 0 || r < 0)
+		return a < 0 ? a : r;
+	fsleep(50 * USEC_PER_MSEC);
+	dev_info(dev, "m5: reset %s: settle end\n", iface->name);
+	return 0;
+}
