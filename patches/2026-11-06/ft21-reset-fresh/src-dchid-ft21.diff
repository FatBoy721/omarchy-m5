+	dev_info(dev, "m5: reset %s: release sent (assert %d release %d)\n", iface->name, a, r);
+	if (a < 0 || r < 0)
+		return a < 0 ? a : r;
+	fsleep(50 * USEC_PER_MSEC);
+	dev_info(dev, "m5: reset %s: settle end\n", iface->name);
+	return 0;
