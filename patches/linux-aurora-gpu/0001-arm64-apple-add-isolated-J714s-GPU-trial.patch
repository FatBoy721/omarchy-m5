+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Local J714s GPU trial, based on runtime ADT captured 2026-11-06:
+ * SHA256 e68662cd086179dd7fdebdd3046eec4fbf27aa287b266a7e0a550434a8ad2017.
+ * Include the working board verbatim: CPU binning, DCP, battery and input
+ * remain shared. No firmware physical address is a compile-time constant.
+ */
+#include "t6050-j714s.dts"
+
+/ {
+	aliases {
+		gpu = &gpu;
+		gpu-mbox = &gfx_mbox;
+		gpu-mbox1 = &gfx1_mbox;
+	};
+
+	reserved-memory {
+		uat_handoff: uat-handoff {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_l2_pagetables: uat-l2-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_pagetables: uat-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_ttbs: uat-ttbs {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_text: gpu-fw-text {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_data: gpu-fw-data {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+	};
+};
+
+&soc {
+	gpu: gpu@2300000000 {
+		compatible = "apple,j714s-gpu", "apple,agx-g17s";
+		reg = <0x23 0x00000000 0 0x03fdc000>;
+		reg-names = "sgx";
+		mboxes = <&gfx_mbox>, <&gfx1_mbox>;
+		/* ADT GFX_SGX/ASC/ASC1 are virtual children of GFX. */
+		power-domains = <&ps_gfx>;
+		memory-region = <&uat_handoff>, <&uat_l2_pagetables>,
+				<&uat_pagetables>, <&uat_ttbs>,
+				<&gpu_fw_text>, <&gpu_fw_data>;
+		memory-region-names = "handoff", "l2-pagetables", "pagetables",
+				      "ttbs", "fw-text", "fw-data";
+		/* Only the matching loader may enable this after validating all
+		 * runtime reservations, role addresses and mailbox interrupts. */
+		apple,m1n1-gpu-handoff;
+		status = "disabled";
+	};
+
+	gfx_mbox: mailbox-gfx {
+		compatible = "apple,t6050-native-ascwrap-v6";
+		reg = <0 0 0 0>, <0 0 0 0>;
+		reg-names = "wrapper", "iop-vbar";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 2797 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 2800 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "recv-not-empty";
+		apple,firmware-role = "GFX";
+		power-domains = <&ps_gfx>;
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	gfx1_mbox: mailbox-gfx1 {
+		compatible = "apple,t6050-native-ascwrap-v6";
+		reg = <0 0 0 0>, <0 0 0 0>;
+		reg-names = "wrapper", "iop-vbar";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 2801 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 2804 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "recv-not-empty";
+		apple,firmware-role = "GFX1";
+		power-domains = <&ps_gfx>;
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+};
