+// The same saved J714s ADT's afr-perf-states and cs-perf-states, which are identical.
+// Their encoding is u64 microvolts/Hz, unlike the main-domain u32 Hz/mV pairs.
+// min_sram_volt is 775000 uV. Convert to MHz/mV, then apply that SRAM floor.
+const J714S_AUX_PERF_STATES: [M5AuxPerfState; 14] = one_lane([
+    (24, 125, 775), (338, 595, 775), (486, 625, 775), (636, 650, 775),
+    (796, 690, 775), (888, 705, 775), (988, 750, 775), (1084, 775, 775),
+    (1182, 805, 805), (1278, 840, 840), (1374, 870, 870),
+    (1470, 910, 910), (1578, 985, 985), (1620, 1015, 1015),
+]);
+
 // J716c ADT afr-perf-states (identical to cs-perf-states). SRAM is
 // max(775, core), the rule the J714 column follows.
 const J716C_AUX_PERF_STATES: [M5AuxPerfState; 14] = one_lane([
@@ -2207,6 +2217,20 @@ pub(crate) struct Board {
     g17d_forms: false,
 };
 
+/// Local J714s, runtime ADT e68662cd086179dd7fdebdd3046eec4fbf27aa287b266a7e0a550434a8ad2017.
+/// The ADT establishes voltage bins, two tables, MCC mask 0xf and the J714 AON records.
+/// Two by ten is the G17S slot capacity, not an assertion of twenty enabled cores:
+/// probe checks the ID-register geometry and uses the sampled enabled-core masks.
+/// No leakage/controller calibration was measured on this part.
+pub(crate) const J714S: Board = Board {
+    perf_states: &J714S_GPU_PERF_STATES,
+    aux_perf_states: &J714S_AUX_PERF_STATES,
+    relative_frequency: relative_frequency(&J714S_GPU_PERF_STATES, 1),
+    calibration: None,
+    controller_defaults: None,
+    ..J714
+};
+
 /// M5 Max: four clusters of ten cores.
 pub(crate) const J716C: Board = Board {
     clusters: 4,
@@ -2595,6 +2619,29 @@ pub(crate) fn relayout_m5_policy(
     (1578, 1000, 1000, 1000, 1000), (1620, 1025, 1040, 1025, 1040),
 ]);
 
+// Local J714s /arm-io/sgx perf-states and perf-states-sram: 14 u32 Hz/mV pairs
+// per lane, lane 0 then lane 1. The *1 properties duplicate lane 1.
+// These are this device's bins, not a general J714s characterization.
+// SRAM starts at 775 mV (raw bytes 00 00 00 00 07 03 00 00 at P0), then
+// tracks each lane's core voltage. Reading each 8-byte pair as one u64 would
+// incorrectly report roughly 3.3e12, not a voltage or a fixed-point encoding.
+pub(crate) const J714S_GPU_PERF_STATES: [M5PerfState; 14] = two_tables([
+    (0, 125, 125, 775, 775),
+    (338, 595, 610, 775, 775),
+    (486, 625, 655, 775, 775),
+    (636, 660, 675, 775, 775),
+    (796, 710, 725, 775, 775),
+    (888, 725, 735, 775, 775),
+    (988, 755, 770, 775, 775),
+    (1084, 780, 795, 780, 795),
+    (1182, 810, 810, 810, 810),
+    (1278, 850, 850, 850, 850),
+    (1374, 895, 890, 895, 890),
+    (1470, 940, 935, 940, 935),
+    (1578, 1015, 1015, 1015, 1015),
+    (1620, 1055, 1055, 1055, 1055),
+]);
+
 // J716s ADT sgx perf-states (table 0, then table 1 = perf-states1) and perf-states-sram /
 // perf-states-sram1, mV. The bins are this part's: the J714 table differs in every active state.
 pub(crate) const J716S_GPU_PERF_STATES: [M5PerfState; 14] = two_tables([
