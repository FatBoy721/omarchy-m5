From 13e3ab0a3b510e0a88215f4bb41c2355839840f9 Mon Sep 17 00:00:00 2001
From: omarchy-m5 <omarchy-m5@localhost>
Date: Mon, 9 Nov 2026 18:09:22 -0600
Subject: [PATCH] arm64: dts: apple: j714s: add the betizzel-unit N1 trees

The N1 nodes were only reachable through the -tripleu DTBs, which carry
another unit's fused GPU voltage bins. Add t6050-j714s-gpu-n1 and its
simpledrm variant: this unit's "apple,j714s-gpu" bins with the N1 PCIe
host enabled. The root port and its DART stay disabled until a loader
that implements the kernel-train contract enables them.

Mark dart_apcie0 apple,manual-availability: the DART only answers once
the root complex runs, and the loader contract requires the property
before it enables the port. pwren (SMC gP13) and PERST# (GPIO 80) match
this unit's runtime ADT pci-bridge0 function-reset/function-perst.
---
 arch/arm64/boot/dts/apple/Makefile                 |  2 ++
 .../dts/apple/t6050-j714s-gpu-n1-simpledrm.dts     |  7 +++++++
 arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1.dts   | 14 ++++++++++++++
 arch/arm64/boot/dts/apple/t6050-j714s-n1.dtsi      |  6 ++++++
 4 files changed, 29 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1-simpledrm.dts
 create mode 100644 arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1.dts

diff --git a/arch/arm64/boot/dts/apple/Makefile b/arch/arm64/boot/dts/apple/Makefile
index 3068db162..575cedb81 100644
--- a/arch/arm64/boot/dts/apple/Makefile
+++ b/arch/arm64/boot/dts/apple/Makefile
@@ -101,6 +101,8 @@ dtb-$(CONFIG_ARCH_APPLE) += t6041-j616c.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu-simpledrm.dtb
+dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu-n1.dtb
+dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu-n1-simpledrm.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu-tripleu.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j714s-gpu-tripleu-simpledrm.dtb
 dtb-$(CONFIG_ARCH_APPLE) += t6050-j716c.dtb
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1-simpledrm.dts b/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1-simpledrm.dts
new file mode 100644
index 000000000..4bb2f0edb
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1-simpledrm.dts
@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/* betizzel's J714s unit with N1, simple framebuffer kept (no DCP hand-off). */
+#include "t6050-j714s-gpu-n1.dts"
+
+&dcp {
+	apple,m1n1-simpledrm-only;
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1.dts b/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1.dts
new file mode 100644
index 000000000..fe118e79b
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j714s-gpu-n1.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * betizzel's J714s unit (runtime ADT e68662cd...) with the N1 host enabled.
+ * GPU voltage bins stay this unit's ("apple,j714s-gpu"). The N1 root port and
+ * its DART remain disabled here: a loader that implements the kernel-train
+ * contract (m1n1-gpu-n1) fills the host tunables from the boot ADT and
+ * enables both. With any other loader the host probes with no port and the
+ * N1 stays inert.
+ */
+#include "t6050-j714s-gpu.dts"
+
+&pcie0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s-n1.dtsi b/arch/arm64/boot/dts/apple/t6050-j714s-n1.dtsi
index 728228fa3..9d285c29a 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714s-n1.dtsi
+++ b/arch/arm64/boot/dts/apple/t6050-j714s-n1.dtsi
@@ -124,6 +124,12 @@ dart_apcie0: iommu@410000000 {
 		interrupt-parent = <&aic>;
 		interrupts = <AIC_IRQ 1524 IRQ_TYPE_LEVEL_HIGH>;
 		#iommu-cells = <1>;
+		/*
+		 * The DART only answers once the root complex runs. pcie-apple
+		 * releases it after its own train; the loader enables this node
+		 * and port00 together only when both this and pwren-gpios exist.
+		 */
+		apple,manual-availability;
 		status = "disabled";
 	};
 };
-- 
