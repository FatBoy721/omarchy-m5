+static bool t6050_ps_on(void __iomem *reg)
+{
+	u32 val = readl(reg);
+
+	if (FIELD_GET(PS_ACTUAL, val) == PS_ON)
+		return true;
+	writel((val & ~(PS_TARGET | GENMASK(9, 8))) | PS_ON, reg);
+	return t6050_wait(reg, PS_ACTUAL, PS_ACTUAL, 100);
+}
