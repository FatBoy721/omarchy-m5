 	if (IS_ERR(p->core))
 		return dev_err_probe(dev, PTR_ERR(p->core), "core registers\n");
 
+	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, "atc-power")) {
+		int ret = t6050_usb3_probe(pdev, p);
+
+		if (ret)
+			return ret;
+	}
+
 	phy = devm_phy_create(dev, NULL, &t6050_usb2_ops);
 	if (IS_ERR(phy))
 		return PTR_ERR(phy);
