+	{ "core", "apple,tunable-gbl" },
+	{ "drd-cfg", "apple,tunable-cfg" },
+	{ "core", "apple,tunable-link" },
+	{ "ausbc-debug", "apple,tunable-ausbc-debug" },
+	{ "bulk-fabric", "apple,tunable-bulk-fabric" },
+	{ "pipehandler", "apple,tunable-pipehandler" },
