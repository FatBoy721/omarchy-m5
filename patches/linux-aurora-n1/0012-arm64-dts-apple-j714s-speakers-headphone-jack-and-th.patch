From 54fa94696287bd78bb5ab7256ace974e39959033 Mon Sep 17 00:00:00 2001
From: TripleU <tripleuworld@gmail.com>
Date: Tue, 10 Nov 2026 23:10:22 -0500
Subject: [PATCH] arm64: dts: apple: j714s: speakers, headphone jack and the
 trackpad AFE reset

Gathered from the boards that already have these working:

Audio: the AOP (its ASC and setup mailboxes, dart-aop, the base-ns and
LEAP-S ADMACs, the audio service), the six SN012776 amps, the CS42L84
jack codec and the sound card, as t6050-j716s.dts (rolotrealanis98) on
the t6050.dtsi layout. Every value used matches the J714s ADT (amps
0x38-0x3d on i2c1/i2c3, speaker-config {N, 15, 4N, 4N+2}, GPIOs 106,
107, 134, 139; the AOP blocks at the J716s addresses). The card is
"apple,j716-macaudio" (the J616s frame, -30 dB ceiling): with the J714c
serializer settings ("apple,j714-macaudio", edimoldovan) the i2c3 amps
faulted ("bad TDM clock") and stayed silent, as on the J716s. Amp level
15 as in the ADT and edimoldovan's J714c tree, for his speakersafetyd
j714 profile. Needs CONFIG_APPLE_AOP and CONFIG_SND_SOC_APPLE_AOP_AUDIO.

Trackpad: edimoldovan's J714c AFE reset (t6050-j714c: "comes up on
every boot"). The J714s ADT's multi-touch function-afe-reset is the
same pKW8('pcIO', 0x10000, 0x11c0000), which gpio-macsmc's J714s pcIO
line 28 already writes within macsmc.m5_pcio_budget; the MTP firmware
6320.86.1 takes power method 2, as on the J716s. Left to the firmware,
the AFE sometimes never answered ("No HINT_L").

Tested on TripleU613's J714s: "AFE reset asserted/released", "Touch MT
ready" on three boots; the AOP boots and announces aop-audio; under
speakersafetyd's j714 profile a full-scale tone at the -30 dB ceiling
drove all six amps (sensed power on each) with no amp fault.

Assisted-by: Claude Opus 5.5
---
 .../boot/dts/apple/t6050-j714s-audio.dtsi     | 262 ++++++++++++++++++
 arch/arm64/boot/dts/apple/t6050-j714s.dts     |  14 +
 2 files changed, 276 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t6050-j714s-audio.dtsi

diff --git a/arch/arm64/boot/dts/apple/t6050-j714s-audio.dtsi b/arch/arm64/boot/dts/apple/t6050-j714s-audio.dtsi
new file mode 100644
index 000000000..3e6af3d48
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j714s-audio.dtsi
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J714s audio: the six speaker amps, the headphone jack and the AOP that runs
+ * their streams, on the t6050.dtsi layout (three-cell AIC specifiers).
+ *
+ * Gathered, not measured here. The amp, codec and AOP nodes and the sound
+ * card are t6050-j716s.dts's (rolotrealanis98/m5pro-linux), whose link runs
+ * the J616s frame ("apple,j716-macaudio": -30 dB ceiling). The J714 serializer
+ * settings of edimoldovan's J714c ("apple,j714-macaudio") left this unit's
+ * i2c3 amps faulting ("bad TDM clock") and silent, as on the J716s; with the
+ * J716s link all six play with no fault. speakersafetyd's j714 profile is
+ * edimoldovan's (omarchy-mac-pkgs j714-speaker-route-volume), amp level 15 as
+ * in the ADT and in his J714c tree. The J714s ADT (TripleU613's unit) matches
+ * every value used here: amps 0x38-0x3a on i2c1 and 0x3b-0x3d on i2c3 in
+ * speakerN order LW1 RW1 LW2 RW2 LT RT, speaker-config {N, 15, 4N, 4N+2},
+ * shutdown AP GPIO 107, interrupt 106; CS42L84 0x4b on i2c2, reset 139,
+ * interrupt 134; aop, dart-aop, admac-base-ns, aop-exclave-mailbox and
+ * admac-hp-mic-ec-proxy at the J716s addresses and interrupts.
+ */
+
+&soc {
+	/* The AOP ASC's mailbox, inside [ADT] aop reg[0] (0x290600000), interrupts 578-581 */
+	aop_mbox: mailbox@290608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x90608000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 578 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 579 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 580 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 581 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/* [ADT] aop-exclave-mailbox: the AOP's setup port, dart-aop stream 1 */
+	aop_setup_mbox: mailbox@2d067c000 {
+		compatible = "apple,t6050-aop-setup-mailbox",
+			     "apple,t8140-aop-setup-mailbox";
+		reg = <0x2 0xd067c000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 582 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 585 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "recv-not-empty";
+		iommus = <&aop_dart 1>;
+		apple,dma-range = <0x200 0x0 0x10 0x0>;
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * [ADT] dart-aop, interrupt 616. iBoot locks it with inherited roots; the
+	 * T8142 compatible selects apple-dart's per-stream retained-root path.
+	 */
+	aop_dart: iommu@290fc0000 {
+		compatible = "apple,t6050-dart", "apple,t8142-dart", "apple,t8110-dart";
+		reg = <0x2 0x90fc0000 0x0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 616 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/* [ADT] admac-base-ns, interrupt 637, 13 TX and 13 RX channels, stream 8 */
+	admac_base_ns: dma-controller@293800000 {
+		compatible = "apple,t6050-admac", "apple,t8140-admac";
+		reg = <0x2 0x93800000 0x0 0x34000>;
+		dma-channels = <13>;
+		interrupts-extended = <&aic AIC_IRQ 637 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		#dma-cells = <1>;
+		iommus = <&aop_dart 8>;
+		apple,dma-range = <0x110 0x00000000 0x0 0x10000000>;
+	};
+
+	/* [ADT] admac-hp-mic-ec-proxy (LEAP-S), interrupt 638, stream 11 */
+	admac_leap_s: dma-controller@2d3200000 {
+		compatible = "apple,t6050-admac", "apple,t8140-admac";
+		reg = <0x2 0xd3200000 0x0 0x34000>;
+		dma-channels = <9>;
+		interrupts-extended = <&aic AIC_IRQ 638 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		#dma-cells = <1>;
+		iommus = <&aop_dart 11>;
+		apple,dma-range = <0x110 0x00000000 0x0 0x10000000>;
+	};
+
+	/* [ADT] aop: its SRAM window (reg[2]) and ASC (reg[0]), left halted by iBoot */
+	aop: aop@290c00000 {
+		compatible = "apple,t6050-aop", "apple,t8152-aop";
+		reg = <0x2 0x90c00000 0x0 0x1e0000>,
+		      <0x2 0x90600000 0x0 0x4000>;
+		reg-names = "mmio", "asc";
+		mboxes = <&aop_mbox>, <&aop_setup_mbox>;
+		mbox-names = "mbox", "setup";
+		iommus = <&aop_dart 0>;
+		apple,dma-range = <0x110 0x0 0x10 0x0>;
+
+		/*
+		 * [ADT] iop-audio-controller: spkr on base-ns TX0 with the amps' V/I
+		 * sense on RX0, cout/cin (the jack) on TX2/RX2, the microphone
+		 * array on LEAP-S RX0 (Linux channel 2N for TX N, 2N+1 for RX N).
+		 */
+		aop_audio: audio {
+			compatible = "apple,t6050-aop-audio";
+			dmas = <&admac_base_ns 0>, <&admac_base_ns 1>,
+			       <&admac_base_ns 4>, <&admac_base_ns 5>,
+			       <&admac_leap_s 1>;
+			dma-names = "spkr", "spkr-sense", "cout", "cin", "hpai";
+			#sound-dai-cells = <1>;
+			apple,chassis-name = "J714";
+			apple,machine-kind = "MacBook Pro";
+		};
+	};
+};
+
+/ {
+	sound {
+		compatible = "apple,j716-macaudio", "apple,macaudio";
+		model = "MacBook Pro J714";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dai-link@0 {
+			reg = <0>;
+			link-name = "Headphone Jack";
+
+			cpu {
+				sound-dai = <&aop_audio 0>;
+			};
+
+			codec {
+				sound-dai = <&jack_codec>;
+			};
+		};
+
+		dai-link@1 {
+			reg = <1>;
+			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-1 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f0f>;
+
+			cpu {
+				sound-dai = <&aop_audio 4>;
+			};
+
+			codec {
+				sound-dai = <&speaker_lw1>, <&speaker_rw1>,
+					    <&speaker_lw2>, <&speaker_rw2>,
+					    <&speaker_lt>, <&speaker_rt>;
+			};
+		};
+	};
+};
+
+&i2c1 {
+	status = "okay";
+
+	speaker_lw1: codec@38 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x38>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 1";
+		ti,imon-slot-no = <0>;
+		ti,vmon-slot-no = <2>;
+		apple,speaker-config = [00 0f 00 02];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lw2: codec@39 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x39>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 2";
+		ti,imon-slot-no = <8>;
+		ti,vmon-slot-no = <10>;
+		apple,speaker-config = [02 0f 08 0a];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lt: codec@3a {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3a>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Tweeter";
+		ti,imon-slot-no = <16>;
+		ti,vmon-slot-no = <18>;
+		apple,speaker-config = [04 0f 10 12];
+		apple,deferred-shutdown;
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>;
+		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Jack";
+	};
+};
+
+&i2c3 {
+	status = "okay";
+
+	speaker_rw1: codec@3b {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3b>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 1";
+		ti,imon-slot-no = <4>;
+		ti,vmon-slot-no = <6>;
+		apple,speaker-config = [01 0f 04 06];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rw2: codec@3c {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3c>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 2";
+		ti,imon-slot-no = <12>;
+		ti,vmon-slot-no = <14>;
+		apple,speaker-config = [03 0f 0c 0e];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rt: codec@3d {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3d>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Tweeter";
+		ti,imon-slot-no = <20>;
+		ti,vmon-slot-no = <22>;
+		apple,speaker-config = [05 0f 14 16];
+		apple,deferred-shutdown;
+	};
+};
+
+/*
+ * Pin 112 takes an SError when read, so only named pins are exposed: 80
+ * (PCIe port 0's PERST#, see t6050-j714s-n1.dtsi), 106 and 107 (the amps'
+ * interrupt and shutdown line), 134 and 139 (the jack codec's).
+ */
+&pinctrl_ap {
+	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s.dts b/arch/arm64/boot/dts/apple/t6050-j714s.dts
index 2eb27d975..b2aa48521 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714s.dts
@@ -93,8 +93,20 @@ &mtp_dockchannel {
 };
 
 &mtp_hid {
+	/*
+	 * The trackpad AFE reset, as edimoldovan's J714c
+	 * (edimoldovan/linux-aurora t6050-j714c: "comes up on every boot"):
+	 * [ADT] multi-touch function-afe-reset = pKW8('pcIO', 0x10000,
+	 * 0x11c0000), the same on this J714s, which gpio-macsmc's J714s pcIO
+	 * line 28 writes (within macsmc.m5_pcio_budget). Left to the MTP
+	 * firmware (6320.86.1, which takes power method 2 as on the J716s),
+	 * the AFE sometimes never answered ("No HINT_L").
+	 */
+	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_HIGH>;
+
 	multi-touch {
 		firmware-name = "apple/tpmtfw-j714s.bin";
+		apple,power-method = <2>;
 	};
 
 	keyboard: keyboard {
@@ -137,3 +149,5 @@ fan-F1Ac {
 		apple,fan-mode = "F1md";
 	};
 };
+
+#include "t6050-j714s-audio.dtsi"
-- 
2.56.0

