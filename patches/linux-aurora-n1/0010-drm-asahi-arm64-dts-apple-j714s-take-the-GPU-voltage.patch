+/// Any J714s: the generic M5 Pro profile with the voltage bins of the chip it runs on, from the
+/// ADT the loader copied into `node` (see [`crate::g17::fw::m5::initdata::adt_bins`]). Selected
+/// by "apple,j714s-gpu-adt"; without those properties the GPU does not start.
+pub(crate) fn config_j714s_adt(node: &kernel::of::Node) -> kernel::error::Result<&'static Config> {
+    use crate::g17::fw::m5::initdata::{adt_bins, J714S, J714S_TRIPLEU, J716S};
+    let board = adt_bins::board(node, &J716S)?;
+    let unit = if adt_bins::same_bins(board, &J714S_TRIPLEU) {
+        "TripleU613's unit"
+    } else if adt_bins::same_bins(board, &J714S) {
+        "betizzel's unit"
+    } else {
+        "no unit measured before"
+    };
+    kernel::pr_info!("asahi: J714s GPU voltage bins from the ADT ({})\n", unit);
+    let config = kernel::alloc::KBox::new(Config { m5: Some(board), ..CONFIG }, kernel::alloc::flags::GFP_KERNEL)?;
+    Ok(kernel::alloc::KBox::leak(config))
+}
+
