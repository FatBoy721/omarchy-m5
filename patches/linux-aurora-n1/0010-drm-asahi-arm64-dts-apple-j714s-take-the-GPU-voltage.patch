+
+/// Voltage bins taken from the running chip's ADT.
+///
+/// The bins are fused per chip, so a table measured on one unit is wrong for the next. m1n1
+/// copies the sgx node's perf-states, perf-states-sram and afr-perf-states byte for byte into
+/// apple,adt-* properties of the gpu node (little-endian, as in the ADT). They replace the
+/// voltages of `base`; everything else, frequencies included, stays `base`'s. Any layout,
+/// frequency or voltage outside what the M5 Pro parts measured so far show is refused, and the
+/// GPU then does not start.
+pub(crate) mod adt_bins {
+    use super::{Board, M5AuxPerfState, M5PerfState, M5_PERF_LANES};
+    use kernel::{c_str, error::Result, of, prelude::*, str::CStr};
+
+    const STATES: usize = 14;
+    /// No M5 Pro voltage is near this; a value past it is a parse error, not a bin.
+    const MAX_MV: u32 = 1150;
+    /// Bins differ between units by a few tens of mV; further from `base` is refused.
+    const MAX_DELTA_MV: u32 = 100;
+    /// The auxiliary domain's SRAM floor where the ADT does not give one.
+    const AUX_SRAM_FLOOR_MV: u32 = 775;
+
+    fn prop(node: &of::Node, name: &CStr) -> Result<KVec<u8>> {
+        node.get_opt_property::<KVec<u8>>(name)?.ok_or(ENOENT)
+    }
+
+    fn u32_at(b: &[u8], at: usize) -> Result<u32> {
+        let s = b.get(at..at + 4).ok_or(EINVAL)?;
+        Ok(u32::from_le_bytes(s.try_into().map_err(|_| EINVAL)?))
+    }
+
+    fn u64_at(b: &[u8], at: usize) -> Result<u64> {
+        let s = b.get(at..at + 8).ok_or(EINVAL)?;
+        Ok(u64::from_le_bytes(s.try_into().map_err(|_| EINVAL)?))
+    }
+
+    fn mhz(hz: u64) -> Result<u32> {
+        u32::try_from((hz + 500_000) / 1_000_000).map_err(|_| EINVAL)
+    }
+
+    fn near(value: u32, reference: u32) -> bool {
+        value <= MAX_MV && value.abs_diff(reference) <= MAX_DELTA_MV
+    }
+
+    /// Main domain: `tables` x 14 {u32 Hz, u32 mV}, table n for lane n.
+    fn main_states(node: &of::Node, base: &Board) -> Result<[M5PerfState; STATES]> {
+        let count = u32_at(&prop(node, c_str!("apple,adt-perf-state-count"))?, 0)? as usize;
+        let tables = u32_at(&prop(node, c_str!("apple,adt-perf-state-table-count"))?, 0)? as usize;
+        let core = prop(node, c_str!("apple,adt-perf-states"))?;
+        let sram = prop(node, c_str!("apple,adt-perf-states-sram"))?;
+        let lanes = base.perf_tables;
+        if count != STATES
+            || tables < lanes
+            || tables > M5_PERF_LANES
+            || core.len() != tables * count * 8
+            || sram.len() != core.len()
+        {
+            return Err(EINVAL);
+        }
+        let mut out = *base.perf_states;
+        for (state, entry) in out.iter_mut().enumerate() {
+            for lane in 0..lanes {
+                let at = (lane * count + state) * 8;
+                let (core_hz, core_mv) = (u32_at(&core, at)?, u32_at(&core, at + 4)?);
+                let (sram_hz, sram_mv) = (u32_at(&sram, at)?, u32_at(&sram, at + 4)?);
+                if mhz(core_hz.into())? != entry.0
+                    || mhz(sram_hz.into())? != entry.0
+                    || !near(core_mv, entry.1[lane])
+                    || !near(sram_mv, entry.2[lane])
+                {
+                    return Err(EINVAL);
+                }
+                entry.1[lane] = core_mv;
+                entry.2[lane] = sram_mv;
+            }
+        }
+        Ok(out)
+    }
+
+    /// Auxiliary domain: {u64 dies, u64 count}, then {u64 uV, u64 Hz} per state, then
+    /// optionally the u64 SRAM floor in uV. SRAM is max(floor, core).
+    fn aux_states(node: &of::Node, base: &Board) -> Result<[M5AuxPerfState; STATES]> {
+        let afr = prop(node, c_str!("apple,adt-afr-perf-states"))?;
+        let (dies, count) = (u64_at(&afr, 0)?, u64_at(&afr, 8)?);
+        let body = 16 + STATES * 16;
+        if dies != 1 || count != STATES as u64 || (afr.len() != body && afr.len() != body + 8) {
+            return Err(EINVAL);
+        }
+        let floor = if afr.len() == body + 8 {
+            u32::try_from(u64_at(&afr, body)? / 1000).map_err(|_| EINVAL)?
+        } else {
+            AUX_SRAM_FLOOR_MV
+        };
+        if !near(floor, AUX_SRAM_FLOOR_MV) {
+            return Err(EINVAL);
+        }
+        // cs-perf-states drives the same clock; where present it must agree.
+        if let Some(cs) = node.get_opt_property::<KVec<u8>>(c_str!("apple,adt-cs-perf-states"))? {
+            if cs.as_slice() != afr.as_slice() {
+                return Err(EINVAL);
+            }
+        }
+        let mut out = *base.aux_perf_states;
+        for (state, entry) in out.iter_mut().enumerate() {
+            let at = 16 + state * 16;
+            let core_mv = u32::try_from(u64_at(&afr, at)? / 1000).map_err(|_| EINVAL)?;
+            let sram_mv = core_mv.max(floor);
+            if mhz(u64_at(&afr, at + 8)?)? != entry.0
+                || !near(core_mv, entry.1[0])
+                || !near(sram_mv, entry.2[0])
+            {
+                return Err(EINVAL);
+            }
+            entry.1[0] = core_mv;
+            entry.2[0] = sram_mv;
+        }
+        Ok(out)
+    }
+
+    /// `base` with the voltage bins of the chip it runs on. The board lives as long as the
+    /// kernel: one per probe of the single GPU.
+    pub(crate) fn board(node: &of::Node, base: &'static Board) -> Result<&'static Board> {
+        let perf = KBox::leak(KBox::new(main_states(node, base)?, GFP_KERNEL)?);
+        let aux = KBox::leak(KBox::new(aux_states(node, base)?, GFP_KERNEL)?);
+        let board = Board {
+            perf_states: perf,
+            aux_perf_states: aux,
+            ..*base
+        };
+        Ok(KBox::leak(KBox::new(board, GFP_KERNEL)?))
+    }
+
+    /// Whether `board`'s bins are exactly those of `known`, for the boot log.
+    pub(crate) fn same_bins(board: &Board, known: &Board) -> bool {
+        board.perf_states == known.perf_states && board.aux_perf_states == known.aux_perf_states
+    }
+}
