+// FatBoy721's J714s unit: ioreg -p IODeviceTree sgx node, macOS 27.3 beta 1 (26C5035r),
+// capture SHA256 ed8f9ece8c72295d7f9325982d1c1cad3cfa9abcc51c94d00c724ee75eb64901.
+// afr-perf-states and cs-perf-states, which are identical (u64 uV/Hz, min SRAM 775000 uV).
+// Auxiliary SRAM follows that 775000 uV floor and the max(floor, core) rule.
+pub(crate) const J714S_FATBOY721_AUX_PERF_STATES: [M5AuxPerfState; 14] = one_lane([
+    (24, 125, 775),
+    (338, 590, 775),
+    (486, 620, 775),
+    (636, 645, 775),
+    (796, 695, 775),
+    (888, 715, 775),
+    (988, 760, 775),
+    (1084, 780, 780),
+    (1182, 795, 795),
+    (1278, 835, 835),
+    (1374, 860, 860),
+    (1470, 900, 900),
+    (1578, 975, 975),
+    (1620, 1005, 1005),
+]);
+
 /// An auxiliary-domain performance state: MHz, then core and SRAM mV of each of its two voltage
 /// lanes. A one-lane board leaves the second lane 0.
 pub(crate) type M5AuxPerfState = (u32, [u32; 2], [u32; 2]);
@@ -2317,6 +2338,16 @@ pub(crate) struct Board {
     ..J716S
 };
 
+/// FatBoy721's J714s unit (capture ed8f9ece...): its own fused bins. Selected only by the
+/// "apple,j714s-gpu-fatboy721" GPU compatible. All other fields retain J716S's existing
+/// assumptions, as for the other J714s units.
+pub(crate) const J714S_FATBOY721: Board = Board {
+    perf_states: &J714S_FATBOY721_GPU_PERF_STATES,
+    aux_perf_states: &J714S_FATBOY721_AUX_PERF_STATES,
+    relative_frequency: relative_frequency(&J714S_FATBOY721_GPU_PERF_STATES, 1),
+    ..J716S
+};
+
 /// J775D's performance controllers run from P3.
 const J775D_PERF_FLOOR: usize = 3;
 
@@ -2711,6 +2742,26 @@ pub(crate) fn relayout_m5_policy(
     (1620, 1025, 1010, 1025, 1010),
 ]);
 
+// FatBoy721's J714s unit: ioreg -p IODeviceTree sgx node, macOS 27.3 beta 1 (26C5035r),
+// capture SHA256 ed8f9ece8c72295d7f9325982d1c1cad3cfa9abcc51c94d00c724ee75eb64901.
+// perf-states (table 0, then table 1 = perf-states1) and perf-states-sram / perf-states-sram1, mV.
+pub(crate) const J714S_FATBOY721_GPU_PERF_STATES: [M5PerfState; 14] = two_tables([
