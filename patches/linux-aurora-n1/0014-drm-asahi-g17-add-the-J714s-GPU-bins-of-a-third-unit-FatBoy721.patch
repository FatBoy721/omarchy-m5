 /// Four-table states (MHz, four core-voltage tables, four SRAM-voltage tables), the rest 0.
 const fn four_tables(states: [(u32, [u32; 4], [u32; 4]); 14]) -> [M5PerfState; 14] {
     let mut out = [(0, [0; M5_PERF_LANES], [0; M5_PERF_LANES]); 14];
