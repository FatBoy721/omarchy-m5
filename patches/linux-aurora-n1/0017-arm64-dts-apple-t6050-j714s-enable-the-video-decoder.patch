From 981935a91391a2267b50ae286e087abb62f1ec7d Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:58:36 -0500
Subject: [PATCH] arm64: dts: apple: t6050-j714s: enable the video decoder
 (gathered)

DjDeveloperr's aurora-silicon/linux #1577 (stacked on #1322) enables the J714s
avd0 as #1322 does on the J714c: the decoder, dart-avd0 and AVD_SYS under
FAB1_SOC, FAB1_SOC kept on. This tree already has the T8142-generation
driver and the die-0 decoder block (t6050-ultra.dtsi), so the J714s takes that
block with the base tree's pmgr4 domains.

On TripleU613's J714s with avd-fw v5-t2 (aurora-silicon/avd-fw ea3a65cc9c):
'booting hw version: 40020', open-queue transport, /dev/video0 avd; a
30-frame H.264 High clip with B-frames through GStreamer v4l2slh264dec is
byte-identical to FFmpeg's software decode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H3rUWsmTuAiei3A7JojjHG
---
 .../arm64/boot/dts/apple/t6050-j714s-avd.dtsi | 55 +++++++++++++++++++
 arch/arm64/boot/dts/apple/t6050-j714s.dts     |  1 +
 2 files changed, 56 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t6050-j714s-avd.dtsi

diff --git a/arch/arm64/boot/dts/apple/t6050-j714s-avd.dtsi b/arch/arm64/boot/dts/apple/t6050-j714s-avd.dtsi
new file mode 100644
index 000000000000..d4d63abeda58
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j714s-avd.dtsi
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J714s video decoder (ADT avd0, the same block as the T6050 Ultra's die 0 here, t6050-ultra.dtsi).
+ * Gathered from DjDeveloperr's aurora-silicon/linux #1577 ("t6050-j714s: Enable the video
+ * decoder", tested on a J714s: H.264/H.265 bit-exact against software through v4l2sl), which
+ * enables avd0 as #1322 does on the J714c: decoder, dart-avd0 and AVD_SYS under FAB1_SOC, FAB1_SOC
+ * kept on (macOS sets it active once at boot and never gates it).
+ */
+
+/ {
+	/*
+	 * Die 0's video decoder (ADT /arm-io/avd0, avd-version 4, the T8142 generation): reg[0]
+	 * 0x2308000000 + 0x1404000 through arm-io's ranges, windows in the T8142/T6041 layout (CM3 code
+	 * and SRAM 0x14000 each at +0x1080000, mailbox +0x10a8000, decode control +0x1100000); ADT
+	 * interrupts 2417, 2418 (die 0 IRQs 2417, 2418). dart-avd0 at +0x1020000,
+	 * interrupt 2424 (die 0 2424), SIDs 0-2 (mapper, piodma, adsbuf). Power: the clock
+	 * gates AVD_SYS_V and AVD_SOC_DART have no PS register; both hang off AVD_SYS (PMGR block
+	 * 0x2380600000 + 0x1d8, also the ARST reset), whose parent FAB1_SOC (+0x1b0) is critical.
+	 */
+	soc@2308000000 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0x23 0x08000000 0x23 0x08000000 0x0 0x1404000>;
+		nonposted-mmio;
+		interrupt-parent = <&aic>;
+
+		avd: avd@2309080000 {
+			compatible = "apple,t6050-avd", "apple,t8142-avd";
+			reg = <0x23 0x09080000 0x0 0x14000>,
+			      <0x23 0x09094000 0x0 0x14000>,
+			      <0x23 0x090a8000 0x0 0x4000>,
+			      <0x23 0x09100000 0x0 0x10000>;
+			reg-names = "code", "sram", "mbox", "ctrl";
+			interrupts = <AIC_IRQ 2417 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 2418 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_avd_sys>;
+			resets = <&ps_avd_sys>;
+			iommus = <&avd_dart 0>, <&avd_dart 1>, <&avd_dart 2>;
+		};
+
+		avd_dart: iommu@2309020000 {
+			compatible = "apple,t6050-dart", "apple,t8110-dart";
+			reg = <0x23 0x09020000 0x0 0x20000>;
+			#iommu-cells = <1>;
+			interrupts = <AIC_IRQ 2424 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_avd_sys>;
+		};
+	};
+};
+
+/* pmgr4's FAB1_SOC and AVD_SYS are the base tree's (t6050.dtsi); macOS never gates FAB1_SOC */
+&ps_fab1_soc {
+	apple,always-on;
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s.dts b/arch/arm64/boot/dts/apple/t6050-j714s.dts
index b2aa48521d0c..6e6a1d19bbf6 100644
--- a/arch/arm64/boot/dts/apple/t6050-j714s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j714s.dts
@@ -151,3 +151,4 @@ fan-F1Ac {
 };
 
 #include "t6050-j714s-audio.dtsi"
+#include "t6050-j714s-avd.dtsi"
