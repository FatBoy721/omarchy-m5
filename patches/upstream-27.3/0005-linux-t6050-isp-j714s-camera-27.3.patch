From a31abfc3540d4c07c66bfbb7e95ab60245c99725 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 12:56:36 +0100
Subject: [PATCH 1/7] media: apple: isp: Tune the J714c IMX958 with setfile
 2226_02

macOS's appleh16camerad carries three setfiles naming sensor 0x958:
2224_01, 2226_01 and 2226_02. The J714c module reports build revision 2,
and with 2226_02 its noise is far lower and its colour neutral, where
2224_01 leaves heavy grain and a green cast. Add 2226_02 and select it
for T6050; T8142 and T6040 keep 2224_01.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 38993598aa9aff325515eddc0de76ae895977802)
---
 drivers/media/platform/apple/isp/isp-cam.c | 11 ++++++++---
 drivers/media/platform/apple/isp/isp-drv.c |  2 ++
 drivers/media/platform/apple/isp/isp-drv.h |  4 ++++
 3 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index c2fb23778940..f6f0e7fdb30c 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -87,6 +87,8 @@ static const struct isp_setfile isp_setfiles[] = {
 	[ISP_IMX913_7523_01] = {0x913, 0x75230107, "apple/isp_7523_01XX.dat", 0x247f8},
 	[ISP_IMX958_2224_01] = {0x958, 0x22240106, "apple/isp_2224_01XX.dat", 0x6ff4, 0,
 				ISP_TEMPORAL_FILTER_BAND0},
+	[ISP_IMX958_2226_02] = {0x958, 0x22260201, "apple/isp_2226_02XX.dat", 0x6ff4, 0,
+				ISP_TEMPORAL_FILTER_BAND0},
 	[ISP_VD56G0_6221_01] = {0xd56, 0x62210102, "apple/isp_6221_01XX.dat", 0x1b80},
 	[ISP_VD56G0_6222_01] = {0xd56, 0x62220102, "apple/isp_6222_01XX.dat", 0x1b80},
 };
@@ -176,8 +178,11 @@ static int isp_ch_get_sensor_id(struct apple_isp *isp, u32 ch)
 		id = ISP_IMX913_7523_01;
 		break;
 	case 0x958:
-		/* Section 0x50f of 2224 names sensor 0x958; 2924's names 0x614. */
-		id = ISP_IMX958_2224_01;
+		/*
+		 * Section 0x50f of 2224 and 2226 names sensor 0x958; 2924's
+		 * names 0x614.
+		 */
+		id = isp->hw->imx958_2226 ? ISP_IMX958_2226_02 : ISP_IMX958_2224_01;
 		break;
 	case 0xd56:
 		id = ISP_VD56G0_6221_01;
@@ -485,7 +490,7 @@ static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 	if (err ||
 	    (fmt->id != ISP_IMX248_1820_01 && fmt->id != ISP_IMX558_1921_01 &&
 	     fmt->id != ISP_IMX558_1925_03 && fmt->id != ISP_IMX364_8720_01 &&
-	     fmt->id != ISP_IMX958_2224_01)) {
+	     fmt->id != ISP_IMX958_2224_01 && fmt->id != ISP_IMX958_2226_02)) {
 		dev_err(isp->dev,
 			"ch %d: unsupported sensor. Please file a bug report with hardware info & dmesg trace.\n",
 			ch);
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index f298b5d24db7..1aa24081d9aa 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1396,6 +1396,8 @@ static const struct apple_isp_hw apple_isp_hw_t6050 = {
 	.fw_restore = true,
 	.deferred_start = true,
 	.setfile_stride_fixup = true,
+	/* The J714c's IMX958 (build revision 2) is tuned by 2226_02 */
+	.imx958_2226 = true,
 };
 
 static const struct of_device_id apple_isp_of_match[] = {
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 3551018baf17..79a4445d1c4f 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -277,6 +277,9 @@ struct apple_isp_hw {
 	 * reopen the camera, does not wait for another firmware start.
 	 */
 	unsigned int fw_idle_ms;
+
+	/* The IMX958 module takes setfile 2226_02, not 2224_01 */
+	bool imx958_2226;
 };
 
 enum isp_sensor_id {
@@ -328,6 +331,7 @@ enum isp_sensor_id {
 	ISP_IMX853_7622_01,
 	ISP_IMX913_7523_01,
 	ISP_IMX958_2224_01,
+	ISP_IMX958_2226_02,
 	ISP_VD56G0_6221_01,
 	ISP_VD56G0_6222_01,
 };
-- 
2.56.0


From 181cbb0cfbf31ed577467a757948194b116a4b7c Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 14:11:59 +0100
Subject: [PATCH 2/7] media: apple: isp: Compute the T6050 setfile's noise
 reduction radial gains

The IMX958 setfile 2226_02 carries its noise reduction radial gains
(record 0xc404) flat: every bin 4096. macOS's appleh16camerad computes
them from the setfile's lens shading table (record 0xc003) before
loading it: for each of 257 radius bins, 4096 over the mean shading gain
of the four Bayer planes along the rays to the four image corners,
around the optical centre 156 rows above the image centre.

Do the same for T6050. On the J714c the grain on a flat wall drops by
about 30% at the centre and 40% at the edges, where the shading gain
is highest.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 162531436bd8c0e1016877f1ebcf9243baceb3fe)
---
 drivers/media/platform/apple/isp/isp-cam.c | 104 +++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-drv.c |   1 +
 drivers/media/platform/apple/isp/isp-drv.h |   2 +
 3 files changed, 107 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index f6f0e7fdb30c..51aa712977da 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -3,6 +3,9 @@
 
 #include <linux/firmware.h>
 #include <linux/gcd.h>
+#include <linux/log2.h>
+#include <linux/math.h>
+#include <linux/math64.h>
 #include <linux/unaligned.h>
 #include <kunit/static_stub.h>
 
@@ -637,6 +640,105 @@ static void isp_setfile_fixup_h17(void *data, size_t len)
 	}
 }
 
+/*
+ * The noise reduction radial gains (setfile record 0xc404) from the lens
+ * shading table (0xc003), as macOS's appleh16camerad computes them before
+ * loading the setfile: per radius bin, 4096 over the mean shading gain of
+ * the four Bayer planes along the rays to the four image corners.
+ */
+static u8 *isp_setfile_record(u8 *data, size_t len, u32 tag, size_t *size)
+{
+	size_t off = 0x14;
+
+	while (off + 12 <= len) {
+		u32 sz = get_unaligned_le32(data + off);
+
+		if (get_unaligned_le32(data + off + 4) || sz < 8 || off + 4 + sz > len)
+			return NULL;
+		if (get_unaligned_le32(data + off + 8) == tag) {
+			*size = sz;
+			return data + off + 4;
+		}
+		off += 4 + sz;
+	}
+	return NULL;
+}
+
+#define LSC_PLANES	4
+#define LSC_TABLE	0x5c
+#define RG_BINS		257
+
+static u32 isp_lsc_gain(const u8 *lsc, size_t lsc_size, int plane, s64 x, s64 y)
+{
+	const u8 *h = lsc + 0x12 + plane * 0x12;
+	u32 sx = get_unaligned_le16(h + 2), sy = get_unaligned_le16(h + 4);
+	u32 base = get_unaligned_le32(h + 6);
+	u32 gx = get_unaligned_le16(h + 14), gy = get_unaligned_le16(h + 16);
+	s64 fx, fy, ax, ay;
+	s64 ix, iy;
+	u32 t00, t10, t01, t11;
+	size_t i00;
+
+	/* x and y in 1/256 half-resolution pixels; fx, fy in 1/256 cells */
+	fx = div_s64(x, sx);
+	fy = div_s64(y, sy);
+	ix = clamp_t(s64, fx >> 8, 0, gx - 2);
+	iy = clamp_t(s64, fy >> 8, 0, gy - 2);
+	ax = clamp_t(s64, fx - (ix << 8), 0, 256);
+	ay = clamp_t(s64, fy - (iy << 8), 0, 256);
+	i00 = LSC_TABLE + 2 * (base + iy * gx + ix);
+	if (i00 + 2 * (gx + 2) > lsc_size + 4)
+		return 4096;
+	t00 = get_unaligned_le16(lsc + i00);
+	t10 = get_unaligned_le16(lsc + i00 + 2);
+	t01 = get_unaligned_le16(lsc + i00 + 2 * gx);
+	t11 = get_unaligned_le16(lsc + i00 + 2 * gx + 2);
+	return ((t00 * (256 - ax) + t10 * ax) * (256 - ay) +
+		(t01 * (256 - ax) + t11 * ax) * ay) >> 16;
+}
+
+static void isp_setfile_radial_gain(u8 *data, size_t len)
+{
+	size_t lsc_size, rg_size;
+	u8 *lsc = isp_setfile_record(data, len, 0xc003, &lsc_size);
+	u8 *rg = isp_setfile_record(data, len, 0xc404, &rg_size);
+	s64 cx, cy, dx[4], dy[4], dist[4], rmax = 0;
+	u32 w, h, shift;
+	int i, c, p;
+
+	if (!lsc || !rg || lsc_size < LSC_TABLE || rg_size < 0xe + 2 * RG_BINS - 4)
+		return;
+	w = get_unaligned_le16(lsc + 0xe);
+	h = get_unaligned_le16(lsc + 0x10);
+	if (!w || !h)
+		return;
+
+	/* full-resolution pixels in 1/256; the optical centre sits 156 rows up */
+	cx = (s64)w << 7;
+	cy = ((s64)h << 7) - (156 << 8);
+	for (c = 0; c < 4; c++) {
+		dx[c] = ((c & 1) ? (s64)w << 8 : 0) - cx;
+		dy[c] = ((c & 2) ? (s64)h << 8 : 0) - cy;
+		dist[c] = int_sqrt64(dx[c] * dx[c] + dy[c] * dy[c]);
+		rmax = max(rmax, dist[c]);
+	}
+	shift = order_base_2(DIV_ROUND_UP(rmax, 256 << 8));
+	put_unaligned_le16(shift, rg + 0xc);
+
+	for (i = 0; i < RG_BINS; i++) {
+		s64 t = min_t(s64, (s64)i << (shift + 8), rmax);
+		u64 sum = 0;
+
+		for (p = 0; p < LSC_PLANES; p++)
+			for (c = 0; c < 4; c++)
+				sum += isp_lsc_gain(lsc, lsc_size, p,
+						    (cx + div64_s64(t * dx[c], dist[c])) / 2,
+						    (cy + div64_s64(t * dy[c], dist[c])) / 2);
+		put_unaligned_le16(min_t(u64, div64_u64(16ULL * 4096 * 4096, sum), 0xffff),
+				   rg + 0xe + 2 * i);
+	}
+}
+
 static int isp_ch_load_setfile(struct apple_isp *isp, u32 ch)
 {
 	struct isp_format *fmt = isp_get_format(isp, ch);
@@ -684,6 +786,8 @@ static int isp_ch_load_setfile(struct apple_isp *isp, u32 ch)
 	/* Seen on T6040 only; T8140 runs its setfiles as they are. */
 	if (isp->hw->gen == ISP_GEN_T6040 || isp->hw->setfile_stride_fixup)
 		isp_setfile_fixup_h17(isp->data_surf->virt, len);
+	if (isp->hw->setfile_radial_gain)
+		isp_setfile_radial_gain(isp->data_surf->virt, len);
 
 	err = isp_cmd_ch_set_file_load(isp, ch, isp->data_surf->iova,
 				       setfile->size);
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 1aa24081d9aa..ef04c4adaebc 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1398,6 +1398,7 @@ static const struct apple_isp_hw apple_isp_hw_t6050 = {
 	.setfile_stride_fixup = true,
 	/* The J714c's IMX958 (build revision 2) is tuned by 2226_02 */
 	.imx958_2226 = true,
+	.setfile_radial_gain = true,
 };
 
 static const struct of_device_id apple_isp_of_match[] = {
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 79a4445d1c4f..6b7e6b5f9a70 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -280,6 +280,8 @@ struct apple_isp_hw {
 
 	/* The IMX958 module takes setfile 2226_02, not 2224_01 */
 	bool imx958_2226;
+	/* Compute the setfile's noise reduction radial gains from its lens shading */
+	bool setfile_radial_gain;
 };
 
 enum isp_sensor_id {
-- 
2.56.0


From ba3e63635db2de81ee6676246f729c3f0898d143 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 14:13:01 +0100
Subject: [PATCH 3/7] media: apple: isp: Set the J714c lens shading target and
 scene metering

macOS's appleh16camerad sets the IMX958's lens shading ideal percent to
84 before loading its setfile (CH_LSC_IDEAL_PERCENT_SET, 0x0a4e), and
sends the face-detection scene metering setup that this driver skips
on H17 firmware. The T6050 firmware takes both. Add the command, and
make the percent and the scene metering T6050 hardware data.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit cb9cbb2b470f12966dfafa8679c3dc9f80f8ef12)
---
 drivers/media/platform/apple/isp/isp-cam.c | 11 +++++++++--
 drivers/media/platform/apple/isp/isp-cmd.c | 11 +++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h | 12 ++++++++++++
 drivers/media/platform/apple/isp/isp-drv.c |  3 +++
 drivers/media/platform/apple/isp/isp-drv.h |  4 ++++
 5 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 51aa712977da..1fac41cef684 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -789,6 +789,13 @@ static int isp_ch_load_setfile(struct apple_isp *isp, u32 ch)
 	if (isp->hw->setfile_radial_gain)
 		isp_setfile_radial_gain(isp->data_surf->virt, len);
 
+	if (isp->hw->lsc_ideal_percent) {
+		err = isp_cmd_ch_lsc_ideal_percent_set(isp, ch,
+						       isp->hw->lsc_ideal_percent);
+		if (err)
+			return err;
+	}
+
 	err = isp_cmd_ch_set_file_load(isp, ch, isp->data_surf->iova,
 				       setfile->size);
 	if (err)
@@ -1027,8 +1034,8 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
-	/* The H17 firmware faults on this face-detection metering setup. */
-	if (!h17) {
+	/* Most H17 firmware faults on this face-detection metering setup. */
+	if (!h17 || isp->hw->ae_fd_scene_metering) {
 		err = isp_cmd_apple_ch_ae_fd_scene_metering_config_set(isp,
 								       ch);
 		if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.c b/drivers/media/platform/apple/isp/isp-cmd.c
index a609fe2c3416..7f4733192a72 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.c
+++ b/drivers/media/platform/apple/isp/isp-cmd.c
@@ -779,6 +779,17 @@ int isp_cmd_apple_ch_ae_metering_mode_set(struct apple_isp *isp, u32 chan,
 	return CISP_SEND_IN(isp, args);
 }
 
+int isp_cmd_ch_lsc_ideal_percent_set(struct apple_isp *isp, u32 chan,
+				     u16 percent)
+{
+	struct cmd_ch_lsc_ideal_percent_set args = {
+		.opcode = CISP_OPCODE(CISP_CMD_CH_LSC_IDEAL_PERCENT_SET),
+		.chan = chan,
+		.percent = percent,
+	};
+	return CISP_SEND_IN(isp, args);
+}
+
 int isp_cmd_apple_ch_ae_flicker_freq_update_current_set(struct apple_isp *isp,
 							u32 chan, u32 freq)
 {
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index ab98f3447d6f..6511b625c58f 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -70,6 +70,7 @@
 #define CISP_CMD_CH_ALS_DISABLE				     0x0a1d
 #define CISP_CMD_CH_CNR_START				     0x0a2f
 #define CISP_CMD_CH_MBNR_ENABLE				     0x0a3a
+#define CISP_CMD_CH_LSC_IDEAL_PERCENT_SET		     0x0a4e
 #define CISP_CMD_CH_OUTPUT_CONFIG_SET			     0x0b01
 #define CISP_CMD_CH_OUTPUT_CONFIG_SCL1_SET		     0x0b09
 #define CISP_CMD_CH_PREVIEW_STREAM_SET			     0x0b0d
@@ -782,6 +783,15 @@ struct cmd_apple_ch_ae_fd_scene_metering_config_set {
 static_assert(sizeof(struct cmd_apple_ch_ae_fd_scene_metering_config_set) ==
 	      0x24);
 
+/* The lens shading falloff the firmware corrects to, in percent at the corner */
+struct cmd_ch_lsc_ideal_percent_set {
+	u64 opcode;
+	u32 chan;
+	u16 percent;
+	u16 pad;
+} __packed;
+static_assert(sizeof(struct cmd_ch_lsc_ideal_percent_set) == 0x10);
+
 struct cmd_apple_ch_ae_metering_mode_set {
 	u64 opcode;
 	u32 chan;
@@ -810,6 +820,8 @@ int isp_cmd_apple_ch_ae_fd_scene_metering_config_set(struct apple_isp *isp,
 						     u32 chan);
 int isp_cmd_apple_ch_ae_metering_mode_set(struct apple_isp *isp, u32 chan,
 					  u32 mode);
+int isp_cmd_ch_lsc_ideal_percent_set(struct apple_isp *isp, u32 chan,
+				     u16 percent);
 int isp_cmd_apple_ch_ae_flicker_freq_update_current_set(struct apple_isp *isp,
 							u32 chan, u32 freq);
 
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index ef04c4adaebc..2b031c0bee48 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1399,6 +1399,9 @@ static const struct apple_isp_hw apple_isp_hw_t6050 = {
 	/* The J714c's IMX958 (build revision 2) is tuned by 2226_02 */
 	.imx958_2226 = true,
 	.setfile_radial_gain = true,
+	/* As macOS's appleh16camerad sets them for the J714c's IMX958 */
+	.lsc_ideal_percent = 84,
+	.ae_fd_scene_metering = true,
 };
 
 static const struct of_device_id apple_isp_of_match[] = {
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 6b7e6b5f9a70..c13914ef62e9 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -282,6 +282,10 @@ struct apple_isp_hw {
 	bool imx958_2226;
 	/* Compute the setfile's noise reduction radial gains from its lens shading */
 	bool setfile_radial_gain;
+	/* The lens shading falloff to correct to, in percent at the corner (0: unset) */
+	u16 lsc_ideal_percent;
+	/* H17 firmware that takes the face-detection scene metering setup */
+	bool ae_fd_scene_metering;
 };
 
 enum isp_sensor_id {
-- 
