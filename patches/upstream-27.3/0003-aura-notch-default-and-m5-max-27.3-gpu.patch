+    /* 27.3 (26C5035r) on the M5 Max, with the 27.0 records: aura #172 (joshuaswarren) */
+    {{0x49720, 0x49e60, 0x9d1d8, 0x9d918},
+     {0xb7, 0x97, 0x17, 0x83, 0x72, 0xd1, 0xde, 0xb2, 0x8b, 0x56, 0xb5, 0xcc, 0x43, 0xe6, 0x45, 0xb1,
+      0x09, 0x88, 0x60, 0xc1, 0x6d, 0x69, 0x1f, 0x59, 0x91, 0xc1, 0xad, 0x8a, 0xfd, 0x5c, 0x07, 0xeb}},
     /* 27.2 (26B123) */
     {{0x49764, 0x49ea4, 0x9d1ec, 0x9d92c},
      {0x2b, 0x46, 0x13, 0xc6, 0x2a, 0x8a, 0x00, 0x7f, 0x22, 0xa9, 0x41, 0x01, 0x70, 0x2c, 0x9a, 0xc6,
