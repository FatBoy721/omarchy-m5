@@ -149,7 +149,7 @@ OBJECTS := \
 	iodev.o \
 	iova.o \
 	isp.o \
-	kboot.o kboot_atc.o \
+	kboot.o kboot_atc.o kboot_n1.o \
 	kboot_t6020_compat.o \
 	main.o \
 	mitigations.o \
