 #include "malloc.h"
 #include "mcc.h"
 #include "memory.h"
@@ -3327,6 +3328,8 @@ int kboot_prepare_dt(void *fdt)
         return -1;
     if (dt_set_bluetooth())
         return -1;
+    if (kboot_setup_n1(dt))
+        return -1;
     if (dt_set_uboot())
         return -1;
