From: omarchy-m5 <omarchy-m5@users.noreply.github.com>
Subject: [PATCH] output: select supported initial formats and allow alpha scanout

Mode tests allocate scanout buffers before the later format tests. Starting
with XRGB8888 rejects every mode on an alpha-only primary plane, leaving
zero-sized monitor resources that trigger the framebuffer assertion.

Choose the first advertised eight-bit format before the initial mode test,
keeping the existing XRGB/XBGR preference when supported. Also permit
ARGB/ABGR in the eight- and ten-bit format tests. This does not relabel
XRGB buffers or claim unsupported kernel formats.

Base: Hyprland v0.57.1 (acc1aa0bfd4bd575dcb0f76c35ccf12b660a1ab9).

---
diff --git a/src/ipc/s1/Commands.cpp b/src/ipc/s1/Commands.cpp
index fb12ee2..e35a8a0 100644
--- a/src/ipc/s1/Commands.cpp
+++ b/src/ipc/s1/Commands.cpp
@@ -101,8 +101,12 @@ static std::string formatToString(uint32_t drmFormat) {
     switch (drmFormat) {
         case DRM_FORMAT_XRGB2101010: return "XRGB2101010";
         case DRM_FORMAT_XBGR2101010: return "XBGR2101010";
+        case DRM_FORMAT_ARGB2101010: return "ARGB2101010";
+        case DRM_FORMAT_ABGR2101010: return "ABGR2101010";
         case DRM_FORMAT_XRGB8888: return "XRGB8888";
         case DRM_FORMAT_XBGR8888: return "XBGR8888";
+        case DRM_FORMAT_ARGB8888: return "ARGB8888";
+        case DRM_FORMAT_ABGR8888: return "ABGR8888";
         default: break;
     }
 
diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index 7775fca..385045a 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -81,8 +81,12 @@ constexpr const char* drmFormatToString(uint32_t drmFormat) {
     switch (drmFormat) {
         case DRM_FORMAT_XRGB2101010: return "DRM_FORMAT_XRGB2101010";
         case DRM_FORMAT_XBGR2101010: return "DRM_FORMAT_XBGR2101010";
+        case DRM_FORMAT_ARGB2101010: return "DRM_FORMAT_ARGB2101010";
+        case DRM_FORMAT_ABGR2101010: return "DRM_FORMAT_ABGR2101010";
         case DRM_FORMAT_XRGB8888: return "DRM_FORMAT_XRGB8888";
         case DRM_FORMAT_XBGR8888: return "DRM_FORMAT_XBGR8888";
+        case DRM_FORMAT_ARGB8888: return "DRM_FORMAT_ARGB8888";
+        case DRM_FORMAT_ABGR8888: return "DRM_FORMAT_ABGR8888";
         default: return "Invalid";
     }
 }
@@ -802,7 +806,22 @@ bool CMonitor::applyMonitorRule(Config::CMonitorRule&& pMonitorRule) {
     m_customDrmMode = {};
     m_currentMode   = nullptr;
 
-    const auto initialFormat = m_drmFormat != DRM_FORMAT_INVALID ? m_drmFormat : DRM_FORMAT_XRGB8888;
+    static constexpr auto formats10bit = std::to_array<uint32_t>({DRM_FORMAT_XRGB2101010, DRM_FORMAT_XBGR2101010, DRM_FORMAT_ARGB2101010, DRM_FORMAT_ABGR2101010});
+    static constexpr auto formats8bit  = std::to_array<uint32_t>({DRM_FORMAT_XRGB8888, DRM_FORMAT_XBGR8888, DRM_FORMAT_ARGB8888, DRM_FORMAT_ABGR8888});
+
+    auto                  initialFormat = m_drmFormat != DRM_FORMAT_INVALID ? m_drmFormat : DRM_FORMAT_XRGB8888;
+    if (m_drmFormat == DRM_FORMAT_INVALID) {
+        // Mode tests allocate scanout buffers too. Do not assume XRGB is supported
+        // before the format tests below: some primary planes require alpha.
+        const auto supportedFormats = m_output->getRenderFormats();
+        for (const auto format : formats8bit) {
+            if (!std::ranges::contains(supportedFormats, format, &Aquamarine::SDRMFormat::drmFormat))
+                continue;
+
+            initialFormat = format;
+            break;
+        }
+    }
     m_output->state->setFormat(initialFormat);
     m_prevDrmFormat = m_drmFormat;
     m_drmFormat     = initialFormat;
@@ -923,10 +942,7 @@ bool CMonitor::applyMonitorRule(Config::CMonitorRule&& pMonitorRule) {
 
     m_output->state->setMaxBpc(RULE->m_enable10bit ? 10 : 8);
 
-    static constexpr auto formats10bit = std::to_array<uint32_t>({DRM_FORMAT_XRGB2101010, DRM_FORMAT_XBGR2101010});
-    static constexpr auto formats8bit  = std::to_array<uint32_t>({DRM_FORMAT_XRGB8888, DRM_FORMAT_XBGR8888});
-
-    const bool            set10bit = RULE->m_enable10bit && trySetFormat(formats10bit);
+    const bool set10bit = RULE->m_enable10bit && trySetFormat(formats10bit);
     if (!set10bit)
         trySetFormat(formats8bit);
 
