--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-smc.dtsi
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T6050 SMC (System Management Controller) + the SPMI/PMIC NVMEM cells its
+ * reboot and RTC children need. From a research pass (ADT + Asahi drivers);
+ * the stage-0 proxy probe (scripts/probes/smc-proxy-probe.py) confirmed the
+ * mailbox, the shmem window and the driver keys (docs/research/
+ * smc-keys-j714s.json). Brought up in stages.
+ *
+ * Source of every value: runtime ADT build/adt-runtime-j714s.bin
+ * (see PLAN.md for the property each number comes from).  Structure copied
+ * from t6030.dtsi:937-998 / t6031-die0.dtsi:107-169 / t8122.dtsi:775-889.
+ *
+ * Board files add hwmon sensors (hwmon-*.dtsi) on top of &smc_hwmon.
+ */
+
+#include <dt-bindings/spmi/spmi.h>
+
+&soc {
+	/*
+	 * ADT /arm-io/nub-spmi0: compatible "aapl,spmi", gen = 4,
+	 * reg[0] = 0x8a014000 (-> 0x28a014000, ADT size 0x4000).
+	 * This is a gen 4 controller (ADT "gen" = 4): STATUS/CMD/REPLY sit at
+	 * 0x200/0x210/0x220 and RX-empty is bit 30 (m1n1 src/spmi.c), which is
+	 * integration/aurora's apple,t8142-spmi layout. That driver runs gen 4
+	 * polled and refuses to probe a gen 4 node that has an interrupt, so
+	 * the ADT's AIC line (726) and the interrupt-controller properties are
+	 * deliberately left out.
+	 *
+	 * No power-domains: the ADT node has no power-gates, and ps_nub_spmi0
+	 * (pmgr 0x120, boot value 0x1400024f = auto-PM + clock-gated) is
+	 * apple,always-on in t6050-pmgr.dtsi.  t6031's equivalent node also has
+	 * none.  Referencing it would only add a genpd dependency.
+	 */
+	nub_spmi0: spmi@28a014000 {
+		compatible = "apple,t6050-spmi", "apple,t8142-spmi";
+		reg = <0x2 0x8a014000 0x0 0x4000>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		/*
+		 * ADT /arm-io/nub-spmi0/spmi-abbeyL1: compatible
+		 * "pmu,spmi","pmu,abbey", reg[0] = 0xe -> USID 14, is-primary.
+		 * (spmi-mosquitoM0 = USID 9, btm = USID 0xb on the same bus.)
+		 *
+		 * Cell offsets are the Asahi "chapel" layout (t6031-die0.dtsi:
+		 * 47-90); the ADT abbey properties confirm the ones it lists:
+		 *   info-pm_setting      = 0x2001
+		 *   info-clock_offset    = {0x2100, 6}   (info-rtc_scrpad 0x2100)
+		 *   info-fault_shadow    = {0x867b, 0x10}
+		 *   info-scrpad_socd     = {0x8b00, 0x1800}
+		 *   info-leg_scrpad      = 0xf800  -> boot_stage 0xf801 etc. are
+		 *                          base+1/+2/+3/+0xf as on chapel/stowe
+		 *                          [INFERENCE: the +N offsets are not in the ADT]
+		 */
+		pmic1: pmic@e {
+			compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
+			reg = <0xe SPMI_USID>;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				pm_setting: pm-setting@2001 {
+					reg = <0x2001 0x1>;
+				};
+
+				rtc_offset: rtc-offset@2100 {
+					reg = <0x2100 0x6>;
+				};
+
+				fault_shadow: fault-shadow@867b {
+					reg = <0x867b 0x10>;
+				};
+
+				socd: socd@8b00 {
+					reg = <0x8b00 0x1800>;
+				};
+
+				boot_stage: boot-stage@f801 {
+					reg = <0xf801 0x1>;
+				};
+
+				boot_error_count: boot-error-count@f802,0 {
+					reg = <0xf802 0x1>;
+					bits = <0 4>;
+				};
+
+				panic_count: panic-count@f802,4 {
+					reg = <0xf802 0x1>;
+					bits = <4 4>;
+				};
+
+				boot_error_stage: boot-error-stage@f803 {
+					reg = <0xf803 0x1>;
+				};
+
+				shutdown_flag: shutdown-flag@f80f,3 {
+					reg = <0xf80f 0x1>;
+					bits = <3 1>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * ADT /arm-io/smc: compatible "iop,ascwrap-v6" (same as ans/mtp),
+	 * reg[0] = 0x8c600000 (ASC wrapper, size 0x88000), mailbox at
+	 * reg[0] + 0x8000 exactly like ans_mbox/mtp_mbox (m1n1 src/asc.c),
+	 * interrupts = [900, 899, 902, 901] = [n+1, n, n+3, n+2] with n = 899,
+	 * so send-empty = 899 ... recv-not-empty = 902 (same reordering as
+	 * ANS 1348,1347,1350,1349 -> 1347..1350 and MTP 677,676,679,678).
+	 * No power-gates / clock-gates in the ADT node -> no power-domains.
+	 */
+	smc_mbox: mbox@28c608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x8c608000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 899 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 900 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 901 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 902 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * "smc" reg: ASC wrapper (driver does not map it; only index 1 is
+	 * ioremapped).  "sram" reg: ADT iop-smc-nub region-base = 0x28de00000,
+	 * region-size = 0x140000 (Asahi uses 0x100000 on M1-M4; the T6050
+	 * firmware region is 0x140000, and the driver rejects any shmem
+	 * buffer outside this window, drivers/mfd/macsmc.c:320).
+	 * smc_gpio is deliberately defined here although nothing consumes it yet.
+	 */
+	smc: smc@28c600000 {
+		compatible = "apple,t6050-smc", "apple,t8103-smc";
+		reg = <0x2 0x8c600000 0x0 0x4000>,
+		      <0x2 0x8de00000 0x0 0x140000>;
+		reg-names = "smc", "sram";
+		mboxes = <&smc_mbox>;
+
+		smc_gpio: gpio {
+			compatible = "apple,smc-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		smc_hwmon: hwmon {
+			compatible = "apple,smc-hwmon";
+		};
+
+		/*
+		 * Registers SYS_OFF_PRIO_HIGH (192) restart + power-off
+		 * handlers; the apple,t6050-wdt restart handler is priority
+		 * 128 (drivers/watchdog/apple_wdt.c:193), so once this probes,
+		 * `reboot` goes through SMC 'phra' instead of the wdt.
+		 * Kept disabled until an SMC 'phra' restart is shown to land
+		 * in stage-1 m1n1 like the wdt reset does (remote reboots
+		 * depend on that). It also writes boot_stage/shutdown_flag in
+		 * the PMIC scratchpad, whose offsets are not yet verified.
+		 */
+		smc_reboot: reboot {
+			compatible = "apple,smc-reboot";
+			status = "disabled";
+			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+				      <&boot_error_count>, <&panic_count>;
+			nvmem-cell-names = "shutdown_flag", "boot_stage",
+					   "boot_error_count", "panic_count";
+		};
+
+		smc_rtc: rtc {
+			compatible = "apple,smc-rtc";
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-storage-net.dtsi b/arch/arm64/boot/dts/apple/t6050-storage-net.dtsi
new file mode 100644
index 000000000..6eb4c63c3
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-storage-net.dtsi
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T6050 storage (ANS NVMe) + USB device-mode (gadget) nodes.
+ * GENERATED from the runtime ADT (build/adt-runtime-j714s.bin) by
+ * gen-storage-net-dt.py. ADT reg values are translated through /arm-io
+ * ranges (+0x200000000 for the low window).
+ */
+
+&soc {
+	ans_mbox: mbox@419608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x19608000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		/* ADT order is [n+1, n, n+3, n+2]; Asahi DTs use n..n+3 in name order */
+		interrupts = <AIC_IRQ 1347 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 1348 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 1349 IRQ_TYPE_LEVEL_HIGH>,
+			<AIC_IRQ 1350 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+			"recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		power-domains = <&ps_ans>;
+	};
+
+	sart_ans: sart@41dc50000 {
+		/* ADT sart-version = 4 (compatible "sart,coastguard"); SARTv4 ops
+		 * are added for apple,t6050-sart by an aurora-port patch. No
+		 * t8132 fallback: integration/aurora binds t8132 to the v3 layout. */
+		compatible = "apple,t6050-sart";
+		reg = <0x4 0x1dc50000 0x0 0xc000>;
+		power-domains = <&ps_ans>;
+	};
+
+	nvme: nvme@45dcc0000 {
+		/*
+		 * integration/aurora's T8140 profile: separate NVMMU, linear SQ
+		 * doorbells in the "nvme" block (+0x2490c), I/O queue registers,
+		 * and no PMGR reset when ANS is found stopped. Not T6041 (its LSQ
+		 * doorbells sit in the NVMMU block) and not T8132 (cold_reset).
+		 */
+		compatible = "apple,t6050-nvme-ans2", "apple,t8140-nvme-ans2";
+		/* nvme = ADT reg[9] (real NVMe regs; ADT size 0x10000 is too small, the
+		 * doorbells/LINEAR_SQ regs sit at +0x24908; use 0x60000 like t6030),
+		 * ans = reg[0] (ASC CPU control, +0x44),
+		 * nvmmu = reg[3] (NVMMU at +0x28100; m1n1 src/nvme.c T8132 layout) */
+		reg = <0x4 0x5dcc0000 0x0 0x60000>,
+		      <0x4 0x19600000 0x0 0x4000>,
+		      <0x4 0x1dcc0000 0x0 0x60000>;
+		reg-names = "nvme", "ans", "nvmmu";
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 2338 IRQ_TYPE_LEVEL_HIGH>;  /* ADT interrupts[4] */
+		mboxes = <&ans_mbox>;
+		apple,sart = <&sart_ans>;
+		power-domains = <&ps_ans>;
+		resets = <&ps_ans>;
+	};
+
+	/* usb-drd0: port-number 1 */
+	dwc3_0: usb@2a2280000 {
+		compatible = "snps,dwc3";
+		reg = <0x2 0xa2280000 0x0 0xcd00>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1419 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
+		/* No PHY driver: the eUSB2 PHY runs as m1n1's usb_phy_bringup() left
+		 * it, and nothing can bring it back out of suspend. So keep the link
+		 * awake like m1n1's own gadget does: no USB 2.0 LPM in the BOS (else
+		 * the host xHCI parks the link in L1 right after enumeration and
+		 * SET_CONFIGURATION times out, -110) and no SUSPHY/ENBLSLPM. */
+		snps,usb2-gadget-lpm-disable;
+		snps,dis_u2_susphy_quirk;
+		snps,dis_u3_susphy_quirk;
+		snps,dis_enblslpm_quirk;
+		/* no phys/power-domains/resets: m1n1 usb_phy_bringup() left the PHY,
+		 * PMGR and DWC3 reset exactly as its own gadget needs them. */
+		status = "okay";
+	};
+
+	dwc3_0_dart_0: iommu@2a2f00000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f00000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	dwc3_0_dart_1: iommu@2a2f80000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f80000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	/* usb-drd1: port-number 2 */
+	dwc3_1: usb@2aa280000 {
+		compatible = "snps,dwc3";
+		reg = <0x2 0xaa280000 0x0 0xcd00>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1451 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		iommus = <&dwc3_1_dart_0 0>, <&dwc3_1_dart_1 1>;
+		/* No PHY driver: the eUSB2 PHY runs as m1n1's usb_phy_bringup() left
+		 * it, and nothing can bring it back out of suspend. So keep the link
+		 * awake like m1n1's own gadget does: no USB 2.0 LPM in the BOS (else
+		 * the host xHCI parks the link in L1 right after enumeration and
+		 * SET_CONFIGURATION times out, -110) and no SUSPHY/ENBLSLPM. */
+		snps,usb2-gadget-lpm-disable;
+		snps,dis_u2_susphy_quirk;
+		snps,dis_u3_susphy_quirk;
+		snps,dis_enblslpm_quirk;
+		/* no phys/power-domains/resets: m1n1 usb_phy_bringup() left the PHY,
+		 * PMGR and DWC3 reset exactly as its own gadget needs them. */
+		status = "okay";
+	};
+
+	dwc3_1_dart_0: iommu@2aaf00000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xaaf00000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1455 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	dwc3_1_dart_1: iommu@2aaf80000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xaaf80000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1455 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	/* usb-drd2: port-number 3 */
+	dwc3_2: usb@382280000 {
+		compatible = "snps,dwc3";
+		reg = <0x3 0x82280000 0x0 0xcd00>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1483 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		iommus = <&dwc3_2_dart_0 0>, <&dwc3_2_dart_1 1>;
+		/* No PHY driver: the eUSB2 PHY runs as m1n1's usb_phy_bringup() left
+		 * it, and nothing can bring it back out of suspend. So keep the link
+		 * awake like m1n1's own gadget does: no USB 2.0 LPM in the BOS (else
+		 * the host xHCI parks the link in L1 right after enumeration and
+		 * SET_CONFIGURATION times out, -110) and no SUSPHY/ENBLSLPM. */
+		snps,usb2-gadget-lpm-disable;
+		snps,dis_u2_susphy_quirk;
+		snps,dis_u3_susphy_quirk;
+		snps,dis_enblslpm_quirk;
+		/* no phys/power-domains/resets: m1n1 usb_phy_bringup() left the PHY,
+		 * PMGR and DWC3 reset exactly as its own gadget needs them. */
+		status = "okay";
+	};
+
+	dwc3_2_dart_0: iommu@382f00000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x3 0x82f00000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1487 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	dwc3_2_dart_1: iommu@382f80000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x3 0x82f80000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1487 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+};
+
+/* Leave the USB-C port domains as m1n1 left them (see gen-storage-net-dt.py). */
+&ps_atc0_common { status = "disabled"; };
+&ps_atc0_usb_aon { status = "disabled"; };
+&ps_atc0_usb { status = "disabled"; };
+&ps_atc0_phymxwrap { status = "disabled"; };
+&ps_atc1_common { status = "disabled"; };
+&ps_atc1_usb_aon { status = "disabled"; };
+&ps_atc1_usb { status = "disabled"; };
+&ps_atc1_phymxwrap { status = "disabled"; };
+&ps_atc2_common { status = "disabled"; };
+&ps_atc2_usb_aon { status = "disabled"; };
+&ps_atc2_usb { status = "disabled"; };
+&ps_atc2_phymxwrap { status = "disabled"; };
diff --git a/arch/arm64/boot/dts/apple/t6050.dtsi b/arch/arm64/boot/dts/apple/t6050.dtsi
new file mode 100644
index 000000000..762ac39d1
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050.dtsi
@@ -0,0 +1,629 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple T6050 "M5 Pro" SoC (Sotra_S / H17S)
+ *
+ * Authored for omarchy-m5 Phase 1 bring-up, modeled on
+ * arch/arm64/boot/dts/apple/t8132.dtsi (asahi-wip-7.2).
+ *
+ * Sources (all verified against the real J714s machine, macOS 26.5):
+ *   - MMIO addresses + IRQs: on-device IORegistry/ADT dump. ADT reg
+ *     values sit 0x2_0000_0000 below the MMIO address (uart0 ADT
+ *     0x305200000 -> 0x505200000 = m1n1 EARLY_UART_BASE for T6050).
+ *   - CPU topology: 15 cores on J714s (binned SKU) = 2x5 "M-core"
+ *     clusters (cpu0-4, cpu6-10) + 1x5 "super" P-core cluster
+ *     (cpu12-16); cpu5/cpu11/cpu17 absent. Full SKUs (J716s/J716c)
+ *     have 6 per cluster. MPIDR = (cluster_id << 8) | core_id.
+ *     ADT compatibles: M-cores "apple,sawtooth", P-cores "apple,everest".
+ *   - PMGR: generated from the on-device ADT by scripts/adt2pmgr.py
+ *     (see t6050-pmgr.dtsi).
+ *
+ * Boot CPU is cpu0 (an M-core). All 15 cores start with the macOS 27.3
+ * (26C5035r) stub firmware; older stub firmware needs maxcpus=1.
+ *
+ * aurora-silicon/linux port (omarchy-m5 build/aurora-port): this file is
+ * omarchy-m5 dt/t6050.dtsi with the compatibles adapted to the
+ * integration/aurora drivers. AIC: apple,t6050-aic3 is matched to the
+ * T8142 read-only VM_TMR_FIQ_ENA_EL2 handling by an aurora-port patch.
+ *
+ * Copyright The Asahi Linux Contributors / omarchy-m5 contributors
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/apple.h>
+
+/ {
+	compatible = "apple,t6050", "apple,arm-platform";
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&cpu_m0_0>; };
+				core1 { cpu = <&cpu_m0_1>; };
+				core2 { cpu = <&cpu_m0_2>; };
+				core3 { cpu = <&cpu_m0_3>; };
+				core4 { cpu = <&cpu_m0_4>; };
+				core5 { cpu = <&cpu_m0_5>; };
+			};
+			cluster1 {
+				core0 { cpu = <&cpu_m1_0>; };
+				core1 { cpu = <&cpu_m1_1>; };
+				core2 { cpu = <&cpu_m1_2>; };
+				core3 { cpu = <&cpu_m1_3>; };
+				core4 { cpu = <&cpu_m1_4>; };
+				core5 { cpu = <&cpu_m1_5>; };
+			};
+			cluster2 {
+				core0 { cpu = <&cpu_p0>; };
+				core1 { cpu = <&cpu_p1>; };
+				core2 { cpu = <&cpu_p2>; };
+				core3 { cpu = <&cpu_p3>; };
+				core4 { cpu = <&cpu_p4>; };
+				core5 { cpu = <&cpu_p5>; };
+			};
+		};
+
+		/*
+		 * All 18 possible cores are described; boards disable the ones
+		 * fused off on binned SKUs (J714s: cpu5, cpu11, cpu17 absent).
+		 *
+		 * reg is MPIDR_EL1[23:0]. Apple's layout (m1n1 src/midr.h:
+		 * MIDR_CORE_TYPE_P = BIT(16), MIDR_CORE_TYPE_M = BIT(18)):
+		 *   Aff2 = core type: 0 E, 1 P, 4 M     <- boot core: 0x80040000
+		 *   Aff1 = cluster-id from the ADT      (M0 = 0, M1 = 1, P = 2)
+		 *   Aff0 = core within the cluster
+		 * so the P cluster is 0x10200 + core, NOT 0x40200: the type lives
+		 * in Aff2 and is not shared with the M cores. Same scheme as
+		 * t6031 (E 0x0, P 0x10100/0x10200).
+		 *
+		 * Only the boot core (0x40000) is measured; the rest is derived
+		 * from the ADT cluster-id/cluster-core-id. m1n1 compares reg with
+		 * the MPIDR each started core reports and aborts DT preparation
+		 * with "DT CPU %d MPIDR mismatch: <dt> != <hw>", which prints the
+		 * real value, so a wrong guess is loud, not silent.
+		 */
+		cpu_m0_0: cpu@40000 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40000>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+		cpu_m0_1: cpu@40001 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40001>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+		cpu_m0_2: cpu@40002 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40002>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+		cpu_m0_3: cpu@40003 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40003>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+		cpu_m0_4: cpu@40004 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40004>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+		cpu_m0_5: cpu@40005 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40005>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m0>;
+		};
+
+		cpu_m1_0: cpu@40100 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40100>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+		cpu_m1_1: cpu@40101 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40101>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+		cpu_m1_2: cpu@40102 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40102>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+		cpu_m1_3: cpu@40103 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40103>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+		cpu_m1_4: cpu@40104 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40104>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+		cpu_m1_5: cpu@40105 {
+			compatible = "apple,sawtooth";
+			device_type = "cpu";
+			reg = <0x0 0x40105>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_m1>;
+		};
+
+		cpu_p0: cpu@10200 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10200>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+		cpu_p1: cpu@10201 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10201>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+		cpu_p2: cpu@10202 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10202>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+		cpu_p3: cpu@10203 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10203>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+		cpu_p4: cpu@10204 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10204>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+		cpu_p5: cpu@10205 {
+			compatible = "apple,everest";
+			device_type = "cpu";
+			reg = <0x0 0x10205>;
+			enable-method = "spin-table";
+			cpu-release-addr = <0 0>;
+			next-level-cache = <&l2_cache_p>;
+		};
+
+		l2_cache_m0: l2-cache-m0 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+		};
+		l2_cache_m1: l2-cache-m1 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+		};
+		l2_cache_p: l2-cache-p {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <&aic>;
+		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
+		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
+		             <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	clkref: clock-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "clkref";
+	};
+
+	soc: soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+
+		ranges;
+		nonposted-mmio;
+
+		/*
+		 * AICv3. ADT: 0x80400000 -> MMIO 0x280400000, size 0x1cc000.
+		 * The event register sits at aic-iack-offset (0x40000, runtime
+		 * ADT) like t8122/t8132. Linux's AICv2/v3 probe requires it as
+		 * reg[1]; without it the driver bails before installing any
+		 * IRQ/FIQ handler and the kernel runs with no interrupts.
+		 */
+		aic: interrupt-controller@280400000 {
+			compatible = "apple,t6050-aic3", "apple,t8122-aic3";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			reg = <0x2 0x80400000 0x0 0x1cc000>,
+			      <0x2 0x80440000 0x0 0x4>;
+			reg-names = "core", "event";
+			power-domains = <&ps_aic>;
+			/* TODO(adt): PMU FIQ affinities (M-core vs P-core indices) */
+		};
+
+		/* ADT: 0x8836c000 -> 0x28836c000, IRQ 0x2d1 = 721 */
+		wdt: watchdog@28836c000 {
+			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
+			reg = <0x2 0x8836c000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 721 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/* ADT: nub-gpio0 0x881e4000 -> 0x2881e4000, 61 pins */
+		pinctrl_nub: pinctrl@2881e4000 {
+			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x2 0x881e4000 0x0 0x4000>;
+			power-domains = <&ps_nub_gpio>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_nub 0 0 61>;
+			apple,npins = <61>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 706 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 708 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 710 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 712 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 714 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 716 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 718 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/* ADT: aop-gpio0 0x90824000 -> 0x290824000, 85 pins */
+		pinctrl_aop: pinctrl@290824000 {
+			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x2 0x90824000 0x0 0x4000>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_aop 0 0 85>;
+			apple,npins = <85>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 568 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 569 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 570 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 571 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 572 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 573 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 574 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/* ADT: gpio0 0x9c000000 -> 0x29c000000, 221 pins */
+		pinctrl_ap: pinctrl@29c000000 {
+			compatible = "apple,t6050-pinctrl", "apple,t8103-pinctrl";
+			reg = <0x2 0x9c000000 0x0 0x44000>;
+			power-domains = <&ps_gpio>;
+
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl_ap 0 0 221>;
+			apple,npins = <221>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 486 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 488 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 489 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 490 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 491 IRQ_TYPE_LEVEL_HIGH>,
+			             <AIC_IRQ 492 IRQ_TYPE_LEVEL_HIGH>;
+
+			/* TODO(adt): pinmux tables for i2c/spi/uart */
+		};
+
+		/*
+		 * Debug UART. ADT uart0 0x305200000 -> 0x505200000 = m1n1
+		 * EARLY_UART_BASE for T6050. IRQ 0x54f = 1359.
+		 */
+		serial0: serial@505200000 {
+			compatible = "apple,s5l-uart";
+			reg = <0x5 0x05200000 0x0 0x4000>;
+			reg-io-width = <4>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1359 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>, <&clkref>;
+			clock-names = "uart", "clk_uart_baud0";
+			power-domains = <&ps_uart0>;
+			status = "disabled";
+		};
+
+		/*
+		 * Dockchannel UART (USB-C debug). ADT: 0x88e28000 ->
+		 * 0x288e28000, IRQ 0x168 = 360. Driver: apple-dockchannel
+		 * (downstream in linux-asahi).
+		 */
+		dockchannel_uart: dockchannel@288e28000 {
+			compatible = "apple,dockchannel-uart", "apple,dockchannel";
+			reg = <0x2 0x88e28000 0x0 0x10004>,
+			      <0x2 0x88e0c000 0x0 0x18>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 360 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_nub_dock_channel>;
+			status = "disabled";
+		};
+
+		/*
+		 * MTP (Multi-Touch Processor): built-in keyboard + trackpad.
+		 * The J714s has NO SPI keyboard: /arm-io/spi2 only has "mesa"
+		 * (Touch ID) and spi4 only the panel's "dp855". Input is an RTKit
+		 * coprocessor (ADT /arm-io/mtp, "iop,ascwrap-v6") speaking HID over
+		 * a DockChannel FIFO pair (/arm-io/dockchannel-mtp/mtp-transport).
+		 *
+		 * All values from build/adt-runtime-j714s.bin (get_reg() already
+		 * translated, raw ADT + 0x2_0000_0000). The raw ADT offsets
+		 * (0x94600000/0x94800000/0x94b14000) are identical to T8132 (M4)
+		 * and the T8142 (M5) address map, i.e. same IP layout.
+		 *
+		 *   mtp reg[0]   0x294600000 size 0x88000  -> ASC block (CPU_CONTROL
+		 *                at +0x44, mailbox at +0x8000)
+		 *   mtp reg[1]   0x294050000 size 0x4000   -> ascwrap-v6 wrapper
+		 *                (unused by Linux)
+		 *   fw segments  __TEXT 0x294c00000+0x54000, __DATA 0x294c54000+0x6c000
+		 *                = MTP SRAM (M2/M3 convention: 1 MiB at B+0xc00000);
+		 *                __OS_LOG 0x10004818000+0x3000 (DRAM, iBoot-owned)
+		 *   iop-mtp-nub  pre-loaded = 1: iBoot already loaded and started the
+		 *                RTKit firmware; Linux only wakes it (rtkit-helper).
+		 *   mailbox IRQs ADT [677,676,679,678] = {send-not-empty, send-empty,
+		 *                recv-not-empty, recv-empty}; Linux order is ascending.
+		 *   dart-mtp     0x294800000 (t8110 DART, m1n1 uses reg[0] as the
+		 *                DART base), IRQ 659, sid-count 16, mapper SID 0,
+		 *                ADT remap = {1,2,3,4}: requestor SIDs 1-4 alias to
+		 *                SID 0, expressed with the in-tree multi-SID remap
+		 *                (iommus lists every SID; the first one owns the
+		 *                TTBR, the rest get TCR.REMAP -> first).
+		 *   dockchannel  irq regs 0x294b14000, IRQ 660; FIFO pairs
+		 *                rmt-config/rmt-data 0x294b28000/0x294b2c000,
+		 *                config/data 0x294b30000/0x294b34000, fifo-size 2048.
+		 * No PMGR domain: the T6050 ADT has no MTP_* pmgr device at all
+		 * (only NUB_DOCK_CHANNEL, which is the debug dockchannel-uart).
+		 */
+		mtp: mtp@294600000 {
+			compatible = "apple,t6050-mtp", "apple,t6050-rtk-helper-asc4",
+				     "apple,mtp", "apple,rtk-helper-asc4";
+			reg = <0x2 0x94600000 0x0 0x4000>,
+			      <0x2 0x94c00000 0x0 0x100000>;
+			reg-names = "asc", "sram";
+			mboxes = <&mtp_mbox>;
+			iommus = <&mtp_dart 0>, <&mtp_dart 1>, <&mtp_dart 2>,
+				 <&mtp_dart 3>, <&mtp_dart 4>;
+			#helper-cells = <0>;
+			status = "disabled";
+		};
+
+		mtp_mbox: mbox@294608000 {
+			compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x2 0x94608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 676 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 677 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 679 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		mtp_dart: iommu@294800000 {
+			compatible = "apple,t6050-dart", "apple,t8110-dart";
+			reg = <0x2 0x94800000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 659 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			/* ADT vm-base 0x10000004000, vm-size 0xffff0000 (same window the
+			 * T8140 MTP/USB DARTs use in aurora-silicon/linux). */
+			apple,dma-range = <0x100 0x00004000 0x0 0xffff0000>;
+			status = "disabled";
+		};
+
+		mtp_dockchannel: fifo@294b14000 {
+			compatible = "apple,t6050-dockchannel", "apple,dockchannel";
+			reg = <0x2 0x94b14000 0x0 0x1000>;
+			reg-names = "irq";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 660 IRQ_TYPE_LEVEL_HIGH>;
+
+			ranges = <0 0x2 0x94b28000 0x10000>;
+			nonposted-mmio;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			status = "disabled";
+
+			mtp_hid: input@0 {
+				/*
+				 * The MTP firmware (5340.61.4) speaks the M4-class
+				 * ring transport; integration/aurora selects it
+				 * with apple,t6041-dockchannel-hid.
+				 */
+				compatible = "apple,t6050-dockchannel-hid",
+					     "apple,t6041-dockchannel-hid",
+					     "apple,dockchannel-hid";
+				reg = <0x0000 0x1000>,
+				      <0x4000 0x1000>,
+				      <0x8000 0x1000>,
+				      <0xc000 0x1000>;
+				reg-names = "rmt-config", "rmt-data", "config", "data";
+				iommus = <&mtp_dart 0>, <&mtp_dart 1>, <&mtp_dart 2>,
+					 <&mtp_dart 3>, <&mtp_dart 4>;
+				interrupt-parent = <&mtp_dockchannel>;
+				interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+					     <3 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "tx", "rx";
+				apple,fifo-size = <0x800>;
+				apple,helper-cpu = <&mtp>;
+			};
+		};
+
+		/* ADT: i2c0-4 at 0x30501{0,4,8,c,20}000 -> 0x50501... */
+		i2c0: i2c@505010000 {
+			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+			reg = <0x5 0x05010000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1375 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <0x1>;
+			#size-cells = <0x0>;
+			power-domains = <&ps_i2c0>;
+			status = "disabled";
+		};
+
+		i2c1: i2c@505014000 {
+			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+			reg = <0x5 0x05014000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1376 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <0x1>;
+			#size-cells = <0x0>;
+			power-domains = <&ps_i2c1>;
+			status = "disabled";
+		};
+
+		i2c2: i2c@505018000 {
+			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+			reg = <0x5 0x05018000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1377 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <0x1>;
+			#size-cells = <0x0>;
+			power-domains = <&ps_i2c2>;
+			status = "disabled";
+		};
+
+		i2c3: i2c@50501c000 {
+			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+			reg = <0x5 0x0501c000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1378 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <0x1>;
+			#size-cells = <0x0>;
+			power-domains = <&ps_i2c3>;
+			status = "disabled";
+		};
+
+		i2c4: i2c@505020000 {
+			compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+			reg = <0x5 0x05020000 0x0 0x4000>;
+			clocks = <&clkref>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1379 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <0x1>;
+			#size-cells = <0x0>;
+			power-domains = <&ps_i2c4>;
+			status = "disabled";
+		};
+
+		/*
+		 * SPI: ADT spi2 0x305108000 -> 0x505108000 (IRQ 1369, only child
+		 * "mesa" = Touch ID), spi4 0x305110000 -> 0x505110000 (IRQ 1371,
+		 * only children dp855 + display-temp-sens*). Neither carries the
+		 * keyboard/trackpad: those are on the MTP, see mtp@294600000.
+		 */
+		spi2: spi@505108000 {
+			compatible = "apple,t6050-spi", "apple,t8103-spi";
+			reg = <0x5 0x05108000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1369 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			power-domains = <&ps_spi2>;
+			status = "disabled";
+		};
+
+		spi4: spi@505110000 {
+			compatible = "apple,t6050-spi", "apple,t8103-spi";
+			reg = <0x5 0x05110000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1371 IRQ_TYPE_LEVEL_HIGH>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			power-domains = <&ps_spi4>;
+			status = "disabled";
+		};
+
+		/* ADT pwm0 (fpwm,s5l8920x): 0x305040000 under arm-io -> 0x505040000,
+		 * clock-gate FPWM0 (187). Its kbd-backlight child runs at 25 kHz. */
+		fpwm0: pwm@505040000 {
+			compatible = "apple,t6050-fpwm", "apple,s5l-fpwm";
+			reg = <0x5 0x05040000 0x0 0x4000>;
+			power-domains = <&ps_fpwm0>;
+			clocks = <&clkref>;
+			#pwm-cells = <2>;
+			status = "disabled";
+		};
+	};
+};
+
+#include "t6050-pmgr.dtsi"
+#include "t6050-storage-net.dtsi"
+#include "t6050-cpufreq.dtsi"
+#include "t6050-smc.dtsi"
