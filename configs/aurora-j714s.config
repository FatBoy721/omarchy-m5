# omarchy-m5 J714s (MacBook Pro 14-inch, M5 Pro, T6050) on aurora-silicon/linux
# PR #1012 (5b0f106acdd7, kernel 7.3.0).
#
# Merge order (scripts/build-kernel-aurora.sh):
#   arm64 defconfig  ->  arch/arm64/configs/asahi.config  ->  this file
# then olddefconfig. aurora-apif.config is NOT merged: it is the SPTM/Aura
# (APIF) provider set, and this kernel runs bare metal at EL2 under m1n1.
# The tree has no J714c fragment; edimoldovan/linux-aurora's j714c.config is
# an allnoconfig-style list and was only used as a cross-check.
#
# Carried over from omarchy-m5 configs/omarchy-bringup.config,
# omarchy-storage-net.config and omarchy-smc.config (same values, same
# reasons), plus the aurora-specific section at the end.
#
# Everything the boot path needs MUST be built in: the bring-up initramfs
# and the Arch rootfs carry no modules for this kernel.

# --- framebuffer console (the only console that needs no cable) ----------
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- Apple s5l UART, for when the debug cable is attached ----------------
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- initramfs boot ------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- keep early failures loud -------------------------------------------
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PANIC_TIMEOUT=0

# --- early-boot checkpoint markers (off; aurora-port patch 0001) ---------
# Re-enable only for early-boot/hang debugging, with BASE/STRIDE/HEIGHT from
# m1n1's current "fb init:" / boot_args video lines (base 0x10bd310c000 on
# mBoot-20457.60; the Kconfig default 0x10bd3110000 is the old stub's).
# CONFIG_OMARCHY_FB_MARKERS is not set
CONFIG_EFI_EARLYCON=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# --- no Rust ---------------------------------------------------------------
# asahi.config sets CONFIG_RUST=y (DRM_ASAHI, APPLE_PMP, APPLE_AOP, APPLE_SEP,
# RUST_APPLE_RTKIT). Nothing here needs it: simpledrm, NVMe, MTP/HID, SMC and
# DRM_APPLE (the DCP driver) are C. Turning Rust off drops those Rust-only
# drivers and DRM_APPLE_DCP_T8132 (it needs APPLE_PMP).
# CONFIG_RUST is not set

# --- built-in keyboard/trackpad: MTP coprocessor + DockChannel HID ----------
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
# Keep haptics built in too: Aurora caps HID_MAGICMOUSE at this dependency.
CONFIG_HID_APPLE_MTP_HAPTIC=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- CPU DVFS (apple,t8112-cluster-cpufreq, dt t6050-cpufreq.dtsi) --------
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
# --- cpuidle (integration/aurora has T6050 with WFI in both states) -------
CONFIG_CPU_IDLE=y
CONFIG_ARM_APPLE_CPUIDLE=y
# --- SoC watchdog: its restart handler is how `reboot` returns to m1n1 ----
CONFIG_APPLE_WATCHDOG=y

# --- sleep: s2idle with pm_test, and a DPM watchdog for stalled callbacks --
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_EXPERT=y
CONFIG_PSTORE=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=15
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=5

# --- Apple SMC (core, RTC, lid/power-button input, GPIO, hwmon) + SPMI NVMEM
# CONFIG_POWER_RESET_MACSMC and CONFIG_MACSMC_POWER stay =m (never loaded):
# SMC restart would outrank the watchdog restart remote reboots rely on, and
# macsmc-power panicked the M5 at boot on 2026-10-02 (undiagnosed).
CONFIG_MFD_MACSMC=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_GPIO_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_POWER_RESET_MACSMC=m
CONFIG_MACSMC_POWER=m
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y

# --- ANS NVMe: RTKit mailbox + SART (v4, aurora-port patch 0005) + NVMe host
CONFIG_APPLE_SART=y
CONFIG_NVME_CORE=y
CONFIG_NVME_APPLE=y
CONFIG_BLK_DEV_NVME=m
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# --- DART (USB DMA goes through dart-usbN; NVMe uses SART, not DART) ------
CONFIG_IOMMU_IO_PGTABLE_DART=y

# --- USB: plain snps,dwc3 in peripheral mode (no Apple glue / atcphy) -----
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_APPLE is not set
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_SECURITY_LANDLOCK=y

# --- zram swap: Omarchy's zram-generator waits 90 s for /dev/zram0 without it
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- nftables + the xtables pieces iptables-nft/ufw use (Omarchy enables ufw)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y

# --- keyboard backlight: fpwm0 + pwm-leds (t6050-j714s.dts) ---------------
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y

# --- aurora: DCP display driver, built in --------------------------------
# appledrm (drivers/gpu/drm/apple) is C and built in, as are its DRM/Type-C
# dependencies. It only binds when m1n1 (patch 0008) passes its DCP checks
# and enables the nodes;
# `nomodeset` on the cmdline skips its registration (drm_firmware_drivers_only)
# and leaves simpledrm in charge. A wrong method tag panics the DCP firmware
# and leaves the panel dark until reboot. DRM_APPLE depends on
# BACKLIGHT_CLASS_DEVICE and is limited to <= TYPEC and <= APPLE_DART.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_TYPEC=y
CONFIG_DRM_APPLE=y
# CONFIG_DRM_APPLE_AUDIO is not set
# CONFIG_DRM_APPLE_DCP_T8132 is not set
# CONFIG_DRM_APPLE_DEBUG is not set
# CONFIG_DRM_APPLE_KUNIT_TEST is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
