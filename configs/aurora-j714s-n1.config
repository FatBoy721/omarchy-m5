# omarchy-m5 J714s N1 (Wi-Fi + Bluetooth) on top of aurora-j714s + aurora-j714s-gpu.
# Merge order (scripts/build-kernel-aurora.sh, KERNEL_FLAVOR=aurora-n1):
#   defconfig -> asahi.config -> aurora-j714s.config -> aurora-j714s-gpu.config -> this
#
# The Centauri drivers stay modular: they request_firmware_direct() at probe,
# which only works once the rootfs (and its /lib/firmware) is mounted. Install
# the modules into the rootfs for Wi-Fi/Bluetooth.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_APPLE=y
# PERST# of the N1's root port is a pin of the AP pin controller. asahi.config
# builds its driver as a module, which this boot path never loads: the PCIe
# host then defers forever. The board tree exposes only that one pin.
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_MODULES=y
CONFIG_APPLE_CENTAURI=m
CONFIG_APPLE_CENTAURI_WIFI=y
CONFIG_BT_HCICENTAURI=m

# Only the two Centauri modules are built and installed, so what the
# Bluetooth and Wi-Fi daemons need from the kernel has to be built in.
#
# arm64 defconfig switches LE off and leaves HIDP modular: without LE no
# current mouse, keyboard or earbud pairs, HIDP carries classic HID devices,
# and BlueZ feeds HID-over-GATT (LE) devices to the kernel through uhid.
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_UHID=y
# BlueZ (LE: ecb(aes), cmac(aes)) and iwd reach the kernel's ciphers through
# AF_ALG; iwd refuses to start without the hash and skcipher interfaces and
# also uses the DH keyctl operations, MD4/MD5 and DES for its EAP methods.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
# PCIe PERST# (reset-gpios on pinctrl_ap) must exist before the built-in pcie-apple probes.
CONFIG_PINCTRL_APPLE_GPIO=y

# J714s audio (aurora-n1 0012): the AOP runs the speaker, jack and microphone
# streams. Modules, so a board without the AOP nodes loads nothing.
CONFIG_APPLE_AOP=m
CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
# edimoldovan omarchy-mac-pkgs 74d8f8bbef: lets kernel.sched_util_clamp_min_rt_default=0 stop
# realtime threads (PipeWire) holding the P clusters at top speed
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
# AOP sensors: lid angle and ambient light (DjDeveloperr #1542/#1548)
CONFIG_IIO_AOP_SENSOR_LAS=m
CONFIG_IIO_AOP_SENSOR_ALS=m
# USB 2.0 host PHY on ports 0 and 2 (edimoldovan J714c)
CONFIG_PHY_APPLE_T6050_USB2=m
