# Isolated J714s GPU trial; merge AFTER aurora-j714s.config.
# PR1173's T6050/G17S backend is part of DRM_ASAHI itself. DRM_ASAHI_M5
# means the different T8142/G17G backend and is not needed here.
CONFIG_RUST=y
CONFIG_DRM_ASAHI=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_RUST_APPLE_MAILBOX=y
CONFIG_RUST_APPLE_RTKIT=y
CONFIG_CRYPTO_LIB_SHA256=y

# Enabling Rust must not silently restore unrelated asahi.config drivers.
# Native T6050 uses the existing PMGR domains, not speculative PMP startup.
# CONFIG_APPLE_PMP is not set
# CONFIG_APPLE_PMP_THERMAL is not set
# CONFIG_APPLE_AOP is not set
# CONFIG_SND_SOC_APPLE_AOP_AUDIO is not set
# CONFIG_IIO_AOP_SENSOR_LAS is not set
# CONFIG_IIO_AOP_SENSOR_ALS is not set
# CONFIG_IIO_AOP_SENSOR_MOTION is not set
# CONFIG_APPLE_SEP is not set
# CONFIG_APPLE_T8132_PLATFORM_HANDOFF is not set
# CONFIG_DRM_ASAHI_G15 is not set
# CONFIG_DRM_ASAHI_G16 is not set
# CONFIG_DRM_ASAHI_G18 is not set
# CONFIG_DRM_ASAHI_M5 is not set
# CONFIG_DRM_ASAHI_DEBUG_ALLOCATOR is not set
# CONFIG_DRM_APPLE_DCP_T8132 is not set
