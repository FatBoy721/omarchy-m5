# omarchy-m5: storage (ANS NVMe) + USB gadget networking.
# Merge AFTER omarchy-bringup.config. Everything is =y: the bring-up
# initramfs carries no modules.

# --- ANS NVMe: RTKit mailbox (already =y) + SART + NVMe host ------------
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_NVME_CORE=y
CONFIG_NVME_APPLE=y
CONFIG_BLK_DEV_NVME=m
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# --- DART (USB DMA goes through dart-usbN; NVMe uses SART, not DART) ----
CONFIG_APPLE_DART=y
CONFIG_IOMMU_IO_PGTABLE_DART=y

# --- USB: plain snps,dwc3 in peripheral mode (no Apple glue / atcphy) ---
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_APPLE is not set
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
# --- tracing: usb-gadget-net prints the dwc3 tracepoints (setup packets,
# endpoint commands + status, events) to the panel when the host never
# configures the gadget ---
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# --- Landlock: pacman 7 sandboxes its downloads with it (without it the
# rootfs needs DisableSandboxFilesystem in /etc/pacman.conf) ---
CONFIG_SECURITY_LANDLOCK=y

# --- zram swap: Omarchy's zram-generator waits 90 s for /dev/zram0 without it
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- nftables + the xtables pieces iptables-nft/ufw use (Omarchy enables ufw)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y

# --- keyboard backlight: fpwm0 + pwm-leds (dt/t6050-j714s.dts)
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
