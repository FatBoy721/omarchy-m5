+enum { V_ON, V_FORCE, V_REFUSE };
+/* M5_VERDICT_BEGIN (host-tested: tools/tier2-kbd/verdict-test.c) */
+static int fpwm0_verdict(u32 w, u32 sio)
+{
+	if (w == PS_BAD)
+		return V_REFUSE;
+	if (PS_ACT(w) == 0xf)
+		return V_ON;			/* powered: mode 1, no PMGR store */
+	if (w & PS_NOT_PLAIN)
+		return V_REFUSE;		/* auto-PM / busy / reset: a PS store here is the T6050 hang class */
+	if (sio == PS_BAD || PS_ACT(sio) != 0xf)
+		return V_REFUSE;		/* parent not really on (genpd would not power it: always-on, ro) */
+	return V_FORCE;			/* plainly off, parent on: the one token store is eligible */
