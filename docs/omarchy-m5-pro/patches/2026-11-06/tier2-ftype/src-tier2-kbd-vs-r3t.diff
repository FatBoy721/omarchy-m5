+/*
+ * m5 Tier 2: ONE runtime power-on token for the exact domain "fpwm0", armed only by the explicit post-boot
+ * m5_kbdlight "force" activation (after its read-only gates). It is NOT an allow-list entry: m5_ps_ro(fpwm0) stays
+ * true, so probe-min-state, probe-auto-enable, power-off and the reset ops of fpwm0 are never written. The token
+ * permits exactly one store: genpd power_on -> PS TARGET=ACTIVE, with AUTO_ENABLE suppressed (so the domain is never
+ * left auto-gated and no later store can hit an auto-gated domain, T6050 hang note in the probe). Arming is refused
+ * before SYSTEM_RUNNING (no boot/cmdline use) and works once per boot. ps_set runs under the IRQ-safe genpd
+ * spinlock, hence atomics. States: 0 idle, 1 armed, 2 consumed, 3 closed.
+ */
+/* M5_TOK_BEGIN (host-tested: tools/tier2-kbd/token-test.c) */
+static atomic_t m5_fpwm0_tok = ATOMIC_INIT(0);	/* 0 idle, 1 armed, 2 consumed+stored, 3 closed, 4 consumed, NO store */
+int m5_pmgr_fpwm0_arm(void);
+bool m5_pmgr_fpwm0_close(void);
+
+int m5_pmgr_fpwm0_arm(void)
+{
+	int ret = system_state != SYSTEM_RUNNING ? -EPERM :
+		  atomic_cmpxchg(&m5_fpwm0_tok, 0, 1) == 0 ? 0 : -EALREADY;
+
+	pr_warn("m5 pmgr: fpwm0 runtime power-on token arm: %d\n", ret);
+	return ret;
+}
+
+/* Close the token for this boot; true only if the one power-on store was issued. */
+bool m5_pmgr_fpwm0_close(void)
+{
+	int old = atomic_xchg(&m5_fpwm0_tok, 3);
+
+	pr_warn("m5 pmgr: fpwm0 runtime power-on token closed (%s)\n",
+		old == 2 ? "used: store issued" : old == 4 ? "used: NO store (recheck refused)" :
+		old == 1 ? "armed, not used" : old == 3 ? "already closed" : "never armed");
+	return old == 2;
+}
+
+/* ps_set: take the token (1 -> 2) for an ACTIVE set of exactly "fpwm0"; only one caller can win. */
+static bool m5_fpwm0_take(const char *name, u32 pstate)
+{
+	return pstate == APPLE_PMGR_PS_ACTIVE && name && !strcmp(name, "fpwm0") &&
+	       atomic_cmpxchg(&m5_fpwm0_tok, 1, 2) == 1;
+}
+
+/* ps_set: the token was taken but no store follows (still consumed: one-shot). */
+static void m5_fpwm0_nostore(void)
+{
+	atomic_set(&m5_fpwm0_tok, 4);
+}
+/* M5_TOK_END */
