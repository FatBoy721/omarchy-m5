+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * m5 PLATFORM (J714s, Mac17,9, T6050): built-in overlay applied by m5_smcnode (m5_smc=2) to make the SMC,
+ * its read-mostly children and the PMIC NVMEM they read effective in the LIVE device tree (the m5boot live
+ * FDT has no such nodes; a changed board .dts would not be used).
+ *
+ * Derived from edimoldovan/linux-aurora 4602eba4b9d2 (arch/arm64/boot/dts/apple/t6050-smc.dtsi, itself from
+ * betizzel/omarchy-m5 dt/t6050-smc.dtsi, GPL-2.0+ OR MIT, with rolotrealanis98's m5pro-linux 0x4000 nub-spmi0
+ * window fix) and c5b0600d19a4 (t6050-j714c.dts SMC sensors: hwmon-common/fan-dual/laptop, F0md/F1md).
+ * Changes for m5 (each documented below): no smc_mbox (the proven m5_smcnode changeset creates it; "mboxes" is
+ * patched at runtime), no smc_gpio and no smc_reboot node, PMIC NVMEM marked read-only, "apple,m5-children".
+ *
+ * J714s ADT check (reports/04-j714s-full.txt): nub-spmi0@8A014000 compatible "aapl,spmi" gen 4, first
+ * IODeviceMemory 0x28a014000/0x4000; spmi-abbeyL1@E "pmu,spmi","pmu,abbey" is-primary; info-pm_setting
+ * 0x2001; info-clock_offset {0x2100, 6}; info-fault_shadow {0x867b, 0x10}; info-scrpad_socd {0x8b00,
+ * 0x1800}; info-leg_scrpad 0xf800 (the +1/+2/+3/+0xf offsets are upstream INFERENCE, unused here since
+ * smc_reboot is absent). iop-smc-nub region-base 0x28de00000 size 0x140000.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/spmi/spmi.h>
+
+&{/soc} {
+	/* Polled: the gen 4 SPMI driver has no interrupt support. No power-domains (none in the ADT node). */
+	spmi@28a014000 {
+		compatible = "apple,t6050-spmi", "apple,t8142-spmi";
+		reg = <0x2 0x8a014000 0x0 0x4000>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		pmic@e {
+			compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
+			reg = <0xe SPMI_USID>;
+			read-only;	/* m5: no PMIC writes (rtc set_time is refused) */
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				pm_setting: pm-setting@2001 {
+					reg = <0x2001 0x1>;
+				};
+
+				rtc_offset: rtc-offset@2100 {
+					reg = <0x2100 0x6>;
+				};
+
+				fault_shadow: fault-shadow@867b {
+					reg = <0x867b 0x10>;
+				};
+
+				socd: socd@8b00 {
+					reg = <0x8b00 0x1800>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * Same node and values the proven m5_smcnode changeset creates (compatible/reg/reg-names), plus the
+	 * children. "mboxes" is a placeholder that m5_smcnode replaces with the live mailbox phandle before the
+	 * overlay is applied (the mailbox is created by the existing changeset 1).
+	 */
+	smc@28c600000 {
+		compatible = "apple,t6050-smc", "apple,smc";
+		reg = <0x2 0x8c600000 0x0 0x4000>,
+		      <0x2 0x8de00000 0x0 0x140000>;
+		reg-names = "smc", "sram";
+		mboxes = <0xfffffffe>;
+		apple,m5-children;
+
+		smc_hwmon: hwmon {
+			compatible = "apple,smc-hwmon";
+		};
+
+		rtc {
+			compatible = "apple,smc-rtc";
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+		};
+	};
+};
+
+#include "../../../arch/arm64/boot/dts/apple/hwmon-common.dtsi"
+#include "../../../arch/arm64/boot/dts/apple/hwmon-fan-dual.dtsi"
+#include "../../../arch/arm64/boot/dts/apple/hwmon-laptop.dtsi"
+
+/* c5b0600d19a4: the T6050 SMC spells the fan mode keys F0md/F1md. */
+&smc_hwmon {
+	fan-F0Ac {
+		apple,fan-mode = "F0md";
+	};
+
+	fan-F1Ac {
+		apple,fan-mode = "F1md";
+	};
+};
