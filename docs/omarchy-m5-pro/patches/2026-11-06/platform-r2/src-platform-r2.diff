+/*
+ * m5_kbdlight (m5 J714s platform build, built-in): make the keyboard-backlight PWM effective on the LIVE FDT that
+ * m5boot hands over (no loader change, no DTB handoff). Opt-in: m5_kbdlight=1 (or =force, see below).
+ *
+ * Nodes = edimoldovan/linux-aurora 594f4b3a49ec ("arm64: dts: apple: t6050-j714c: keyboard backlight", GPL-2.0+
+ * OR MIT dts): fpwm0 pwm@505040000 ("apple,t6050-fpwm", "apple,s5l-fpwm", 0x4000, power-domains = ps_fpwm0,
+ * clocks = clkref, #pwm-cells 2) and a pwm-leds "kbd_backlight" with period 40000 ns, max-brightness 255,
+ * default-state "keep". Verified against the J714s ADT (reports/04-j714s-full.txt:3828-3856): pwm0
+ * "fpwm,s5l8920x" reg 0x305040000 size 0x4000 (IODeviceMemory 0x505040000), clock-gates 187 (FPWM0),
+ * kbd-backlight default-hz 25000 (= 40000 ns). Live FT19 FDT: /soc/power-management@280900000/
+ * power-controller@2a8 label "fpwm0" (no phandle yet; parent sio, apple,always-on), /clock-ref "clkref".
+ * The live FDT has no __symbols__, so a .dtbo cannot resolve these labels: nodes are built with an
+ * of_changeset and phandles resolved by path (as m5_smcnode.c).
+ *
+ * PMGR: the board runs with m5_pmgr_ro (writes skipped and reported as success). If FPWM0 is not already
+ * powered, the PWM driver would touch an unpowered block. So the FPWM0 power-state word is READ first
+ * (0x2_80900000 + 0x2a8, ACTUAL[7:4]); unless it is 0xf, nothing is created. m5_kbdlight=force skips that
+ * gate and is only for an operator who ALSO put fpwm0 in m5_pmgr_allow= (a deliberate, owner-approved
+ * PMGR write); it is never implied. Even then the LED consumer (whose probe reads FPWM registers) is created
+ * only if a second read shows ACTUAL == on after the PWM device bound.
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include <dt-bindings/leds/common.h>
+
+#define FPWM_PA_HI		0x5
+#define FPWM_PA_LO		0x05040000
+#define FPWM_SIZE		0x4000
+#define FPWM0_PS_PA		(0x280900000UL + 0x2a8)
+#define FPWM0_NODE		"/soc/power-management@280900000/power-controller@2a8"
+#define KBD_PERIOD_NS		40000
+
+static int m5_kbdlight;	/* 0 off, 1 only if FPWM0 already on, 2 force */
+static int __init m5_kbdlight_setup(char *s)
+{
+	m5_kbdlight = !strcmp(s, "1") ? 1 : !strcmp(s, "force") ? 2 : 0;
+	return 1;
+}
+__setup("m5_kbdlight=", m5_kbdlight_setup);
+
+#define L(fmt, ...) pr_info("m5_kbdlight: " fmt "\n", ##__VA_ARGS__)
+
+/* One read-only 32-bit read of the FPWM0 PMGR power-state word; returns ACTUAL[7:4], or -1 if unmappable. */
+static int fpwm0_actual(void)
+{
+	void __iomem *p = ioremap(FPWM0_PS_PA, 4);
+	u32 w;
+
+	if (!p)
+		return -1;
+	w = readl(p);
+	iounmap(p);
+	L("FPWM0 power state %#x (actual %u)", w, (w >> 4) & 0xf);
+	return (w >> 4) & 0xf;
+}
+
+static u32 free_phandle(u32 from)
+{
+	struct device_node *np;
+
+	while ((np = of_find_node_by_phandle(from))) {
+		of_node_put(np);
+		from++;
+	}
+	return from;
+}
+
+/* Report the platform device the apply notifier created (parent is an OF_POPULATED_BUS), else create it. */
+static bool mkdev(struct device_node *np, struct device_node *parent)
+{
+	struct platform_device *pd = of_find_device_by_node(np), *par;
+	bool bound;
+
+	if (!pd) {
+		par = parent ? of_find_device_by_node(parent) : NULL;
+		pd = of_platform_device_create(np, NULL, par ? &par->dev : NULL);
+		if (par)
+			put_device(&par->dev);
+		if (!pd) {
+			L("platform device for %pOF: FAILED", np);
+			return false;
+		}
+		get_device(&pd->dev);
+	}
+	bound = !!pd->dev.driver;
+	L("platform device %s for %pOF: %s", dev_name(&pd->dev), np, bound ? "bound" : "NOT bound");
+	put_device(&pd->dev);
+	return bound;
+}
+
+/*
+ * Three changesets, in this order, because of_changeset_apply() runs the OF reconfig notifier, which creates AND
+ * probes the platform device at once (FT12 native, see m5_smcnode.c): every phandle a probe resolves must already
+ * be set in np->phandle before the changeset that creates the consumer. 1: phandle on the existing fpwm0 domain
+ * node (property add: no device). 2: pwm@505040000 (probe resolves power-domains + clocks). 3: led-controller
+ * (leds-pwm probe resolves pwms).
+ */
+static int do_kbdlight(void)
+{
+	struct device_node *root = of_find_node_by_path("/");
+	struct device_node *soc = of_find_node_by_path("/soc");
+	struct device_node *ps = of_find_node_by_path(FPWM0_NODE);
+	struct device_node *clk = of_find_node_by_path("/clock-ref");
+	struct device_node *pwm, *leds, *led0, *old;
+	struct of_changeset cs1, cs2, cs3;
+	const char *lbl = NULL, *cname = NULL;
+	u32 ps_ph, pwm_ph;
+	int ret = -ENODEV;
+
+	if (!root || !soc || !ps || !clk)
+		goto out;
+	if (of_property_read_string(ps, "label", &lbl) || strcmp(lbl, "fpwm0") ||
+	    of_property_read_string(clk, "clock-output-names", &cname) || strcmp(cname, "clkref") || !clk->phandle) {
+		L("live FDT is not the expected fpwm0/clkref layout: nothing created");
+		goto out;
+	}
+	if ((old = of_find_node_by_path("/soc/pwm@505040000")) || (old = of_find_node_by_path("/led-controller"))) {
+		of_node_put(old);
+		L("pwm@505040000 or /led-controller already present: nothing created");
+		ret = -EEXIST;
+		goto out;
+	}
+
+	if (fpwm0_actual() != 0xf && m5_kbdlight != 2) {
+		L("FPWM0 is not powered and m5_pmgr_ro would skip the power-on: nothing created "
+		  "(owner decision: m5_pmgr_allow=...,fpwm0 plus m5_kbdlight=force)");
+		ret = -EPERM;
+		goto out;
+	}
+
+	/* 1: phandle on the existing domain node (property only; the notifier creates no device for it) */
+	ps_ph = ps->phandle;
+	if (!ps_ph) {
+		ps_ph = free_phandle(0x7e40);
+		of_changeset_init(&cs1);
+		ret = of_changeset_add_prop_u32(&cs1, ps, "phandle", ps_ph);
+		ret = ret ?: of_changeset_apply(&cs1);
+		L("cs1 fpwm0 phandle %#x: %d", ps_ph, ret);
+		if (ret) {
+			of_changeset_destroy(&cs1);
+			goto out;
+		}
+		ps->phandle = ps_ph;	/* a property add does not update np->phandle */
+	}
+
+	/* 2: the PWM controller (594f4b3a49ec fpwm0, address/clock gate checked against the J714s ADT) */
+	pwm_ph = free_phandle(ps_ph + 1);
+	of_changeset_init(&cs2);
+	pwm = of_changeset_create_node(&cs2, soc, "pwm@505040000");
+	ret = pwm ? 0 : -ENOMEM;
+	ret = ret ?: of_changeset_add_prop_string_array(&cs2, pwm, "compatible",
+		(const char *[]){ "apple,t6050-fpwm", "apple,s5l-fpwm" }, 2);
+	ret = ret ?: of_changeset_add_prop_u32_array(&cs2, pwm, "reg",
+		(u32 []){ FPWM_PA_HI, FPWM_PA_LO, 0x0, FPWM_SIZE }, 4);
+	ret = ret ?: of_changeset_add_prop_u32(&cs2, pwm, "power-domains", ps_ph);
+	ret = ret ?: of_changeset_add_prop_u32(&cs2, pwm, "clocks", clk->phandle);
+	ret = ret ?: of_changeset_add_prop_u32(&cs2, pwm, "#pwm-cells", 2);
+	ret = ret ?: of_changeset_add_prop_u32(&cs2, pwm, "phandle", pwm_ph);
+	ret = ret ?: of_changeset_apply(&cs2);
+	L("cs2 pwm@505040000 (phandle %#x, power-domains %#x, clocks %#x): %d", pwm_ph, ps_ph, clk->phandle, ret);
+	if (ret) {
+		of_changeset_destroy(&cs2);
+		goto out;
+	}
+	pwm->phandle = pwm_ph;	/* __of_attach_node() sets it from the property; keep it explicit */
+	if (!mkdev(pwm, soc)) {
+		L("pwm not bound: led-controller not created");
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/*
+	 * Fail closed in BOTH modes: leds-pwm's request reads FPWM registers (get_state). With m5_pmgr_ro (or a
+	 * power-on that did not take) the domain may still be off although genpd reported success, so the consumer
+	 * is created only if the hardware state word now says ACTUAL == on. "force" only permits the power-on attempt.
+	 */
+	if (fpwm0_actual() != 0xf) {
+		L("FPWM0 still not powered after pwm bind: led-controller not created");
+		ret = -EPERM;
+		goto out;
+	}
+
+	/* 3: the pwm-leds consumer */
+	of_changeset_init(&cs3);
+	leds = of_changeset_create_node(&cs3, root, "led-controller");
+	led0 = leds ? of_changeset_create_node(&cs3, leds, "led-0") : NULL;
+	ret = led0 ? 0 : -ENOMEM;
+	ret = ret ?: of_changeset_add_prop_string(&cs3, leds, "compatible", "pwm-leds");
+	ret = ret ?: of_changeset_add_prop_u32_array(&cs3, led0, "pwms", (u32 []){ pwm_ph, 0, KBD_PERIOD_NS }, 3);
+	ret = ret ?: of_changeset_add_prop_string(&cs3, led0, "label", "kbd_backlight");
+	ret = ret ?: of_changeset_add_prop_string(&cs3, led0, "function", LED_FUNCTION_KBD_BACKLIGHT);
+	ret = ret ?: of_changeset_add_prop_u32(&cs3, led0, "color", LED_COLOR_ID_WHITE);
+	ret = ret ?: of_changeset_add_prop_u32(&cs3, led0, "max-brightness", 255);
+	ret = ret ?: of_changeset_add_prop_string(&cs3, led0, "default-state", "keep");
+	ret = ret ?: of_changeset_apply(&cs3);
+	L("cs3 led-controller: %d", ret);
+	if (ret) {
+		of_changeset_destroy(&cs3);
+		goto out;
+	}
+	ret = mkdev(leds, root) ? 0 : -ENODEV;
+out:
+	of_node_put(root);
+	of_node_put(soc);
+	of_node_put(ps);
+	of_node_put(clk);
+	return ret;
+}
+
+static int __init m5_kbdlight_init(void)
+{
+	int ret;
+
+	if (!m5_kbdlight)
+		return 0;
+	if (!of_machine_is_compatible("apple,j714s")) {
+		L("not apple,j714s: nothing created");
+		return 0;
+	}
+	ret = do_kbdlight();
+	L("m5_kbdlight=%s: %d", m5_kbdlight == 2 ? "force" : "1", ret);
+	return 0;
+}
+late_initcall(m5_kbdlight_init);
