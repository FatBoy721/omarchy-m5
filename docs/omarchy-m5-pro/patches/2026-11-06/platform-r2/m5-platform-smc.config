# m5 PLATFORM SMC lane (J714s). From edimoldovan/linux-aurora j714c.config @ c5b0600d19a4 (blob fae9bb0d),
# commits 4602eba4b9d2 / 0bc84cc4a6b2 / c5b0600d19a4. Built-in (=y): no new loadable-module ABI for these.
# Omitted vs upstream: CONFIG_GPIO_MACSMC (no consumer; its read path is an SMC rw, denied by the m5 S2 gate).
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MACSMC_INPUT=y
# CONFIG_MACSMC_POWER is not set
# Review FIX (m5review): no sysfs view of the whole 0xffff PMIC space (possible read-to-clear registers);
# the RTC cell is read in-kernel.
# CONFIG_NVMEM_SYSFS is not set
# Manager decision: no automatic RTC writeback (already off in FT19; pinned here).
# CONFIG_RTC_SYSTOHC is not set
# CONFIG_RTC_HCTOSYS is not set
