# m5-slim.config — minimal first-boot kernel for J714s, applied on top of allnoconfig
# (make allnoconfig KCONFIG_ALLCONFIG=m5-slim.config). Built in: what the first-boot initramfs needs.
# Everything else is off; the full kernel (tools/build-kernel.sh) stays the one the rootfs/loader kexecs.
# Safety limits (task 10 addendum + 14): no sound, no SMC, no cpufreq, no GPU/DCP, no fb markers: all left
# at allnoconfig "n" and re-asserted at the bottom.
CONFIG_LOCALVERSION="-m5slim"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# --- platform ---
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_ARM64_VHE=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_APPLE_PMGR_PWRSTATE=y
# --- core userspace support (busybox, dropbear, kexec) ---
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_LOG_BUF_SHIFT=18
# --- console: simpledrm + fbcon on the iBoot framebuffer, VT on tty0 ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
# --- coprocessors, IOMMU, keyboard/trackpad (DockChannel MTP) ---
CONFIG_MAILBOX=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y
CONFIG_FW_LOADER=y
CONFIG_GPIOLIB=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
# --- storage: NVMe (ANS2 + SART), GPT, ext4 ---
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_APPLE_SART=y
CONFIG_NVME_CORE=y
CONFIG_NVME_APPLE=y
CONFIG_EXT4_FS=y
# --- USB gadget networking: DWC3 device mode + configfs CDC-EEM ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_EEM=y
# --- reboot ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# CONFIG_APPLE_WATCHDOG disabled in task 23 (see bottom)
# --- size: no symbol table, no debug ---
# task 23: symbol names in initcall_debug and oopses
CONFIG_KALLSYMS=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_IKCONFIG is not set
# CONFIG_DEBUG_FS is not set
# --- safety limits (re-asserted) ---
# CONFIG_SOUND is not set
# CONFIG_MFD_MACSMC is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_DRM_APPLE is not set
# CONFIG_DRM_ASAHI is not set
# CONFIG_RUST is not set
# CONFIG_OMARCHY_FB_MARKERS is not set
# --- task 23: framebuffer earlycon, failures stay on screen ---
CONFIG_M5FB_EARLYCON=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PANIC_TIMEOUT=0
# CONFIG_APPLE_WATCHDOG is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
# (arm64 has no CMDLINE_EXTEND: CONFIG_CMDLINE is ignored when the bootloader passes bootargs, so m5boot passes panic=0)
# --- task 25: FAT32 log on the ESP (m5.esplog=1), readable from macOS ---
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
