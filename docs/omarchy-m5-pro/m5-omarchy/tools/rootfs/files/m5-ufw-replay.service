[Unit]
Description=Replay the ufw rules Omarchy set at image build time (ufw could not run under qemu-user)
ConditionPathExists=/var/lib/m5/ufw-replay
Before=ufw.service
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash -e /var/lib/m5/ufw-replay
ExecStartPost=/usr/bin/mv /var/lib/m5/ufw-replay /var/lib/m5/ufw-replay.done

[Install]
WantedBy=multi-user.target
