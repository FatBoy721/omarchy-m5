+	if (m5_ps_ro(ps)) {
+		M5_PS_LOG(ps, "SKIP(ro) set", pstate);
+		return 0;
+	}
+
 	ret = regmap_read(ps->regmap, ps->offset, &reg);
 	if (ret < 0)
 		return ret;
