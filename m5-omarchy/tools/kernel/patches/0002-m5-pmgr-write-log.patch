 #define APPLE_PMGR_PS_CLKGATE   0x4
 #define APPLE_PMGR_PS_PWRGATE   0x0
 
-#define APPLE_PMGR_PS_SET_TIMEOUT 100
+#define APPLE_PMGR_PS_SET_TIMEOUT 10000	/* m5 (task 28): was 100 us; ATC0 needs ~10 ms (third-party report) */
 #define APPLE_PMGR_RESET_TIME 1
 
 struct apple_pmgr_ps {
@@ -53,12 +53,64 @@
 #define genpd_to_apple_pmgr_ps(_genpd) container_of(_genpd, struct apple_pmgr_ps, genpd)
 #define rcdev_to_apple_pmgr_ps(_rcdev) container_of(_rcdev, struct apple_pmgr_ps, rcdev)
 
+
+/* m5 (task 25): log every PMGR write at KERN_EMERG *before* it happens, so a write that
+ * resets the SoC leaves its domain on screen (earlycon output is synchronous at boot). */
+#define M5_PS_LOG(ps, what, val) \
+	pr_emerg("m5 pmgr: %s %s off=0x%x val=0x%x\n", (ps)->genpd.name ? (ps)->genpd.name : "?", \
+		 what, (ps)->offset, (u32)(val))
+
+/* m5 (task 26): m5_pmgr_ro on the cmdline = zero PMGR writes from Linux. Domains register with their
+ * boot state (read only); every set/reset/probe write is logged as SKIP and reported as success. */
+static bool m5_pmgr_ro;
+static int __init m5_pmgr_ro_setup(char *s)
+{
+	m5_pmgr_ro = true;
+	return 1;
+}
+__setup("m5_pmgr_ro", m5_pmgr_ro_setup);
+
+/* m5 (task 28): with m5_pmgr_ro, domains named in m5_pmgr_allow=<label>[,<label>...] may still be written
+ * (e.g. the ATC0 USB chain: atc0_common,atc0_usb_aon,atc0_usb). Everything else stays read-only. */
+static char m5_pmgr_allow[256];
+static int __init m5_pmgr_allow_setup(char *s)
+{
+	strscpy(m5_pmgr_allow, s, sizeof(m5_pmgr_allow));
+	return 1;
+}
+__setup("m5_pmgr_allow=", m5_pmgr_allow_setup);
+
+static bool m5_ps_ro(struct apple_pmgr_ps *ps)
+{
+	const char *p = m5_pmgr_allow, *n = ps->genpd.name;
+	size_t len;
+
+	if (!m5_pmgr_ro)
+		return false;
+	if (!n)
+		return true;
+	len = strlen(n);
+	while (*p) {
+		if (!strncmp(p, n, len) && (p[len] == ',' || p[len] == '\0'))
+			return false;
+		p = strchrnul(p, ',');
+		if (*p)
+			p++;
+	}
+	return true;
+}
+
